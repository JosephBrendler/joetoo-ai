--- /dev/null
+++ b/joetoo-kwin-template.conf
@@ -0,0 +1,39 @@
+# Copyright 2025-2026 Joseph Brendler
+# SPDX-License-Identifier: GPL-3.0-or-later
+# Trusted Bash configuration template. Copy manually to:
+# ${XDG_CONFIG_HOME:-$HOME/.config}/joetoo-kwin/joetoo-kwin.conf
+# Relative XDG_CONFIG_HOME is ignored; explicit -f selects exactly that file.
+# No automatic user-file creation/migration is performed by the CLI.
+screen_width=1920
+screen_height=1080
+desktop_limit=20
+dt_win_limit=4
+min_window_exposure_px=32
+# Four fields (or a blank fifth) mean implicit panel for EVERY application.
+# Explicit panel/under/over entries bypass the implicit budget but still require
+# valid geometry. The panel allocator supports at most four panel participants.
+# Desktops execute in first-appearance order; entries retain desktop-local order.
+# Dolphin relative paths resolve from HOME, not the config location.
+# Replace illustrative SSH hosts; no graphical network transports are supported.
+desktop_session_list=(
+    '4|dolphin|local||panel'
+    '4|konsole|ssh|example.invalid|panel'
+    '4|konsole|ssh|example.invalid|over'
+    '2|konsole|local|btop|'
+    '4|dolphin|local||under'
+)
+# Panel/graphical regions and gutters can be overridden using existing settings:
+terminal_width_percent=87
+terminal_gap_percent=2
+terminal_height_percent=85
+terminal_left_percent=1
+terminal_top_percent=5
+terminal_row_gap_percent=3
+graphical_left_percent=5
+graphical_top_percent=3
+graphical_width_percent=94
+graphical_height_percent=90
+# Initial order is under -> panel -> over, file order inside each layer.
+# Preferred focus: last successful over, else last successful panel, never under.
+# It is applied only on the currently displayed desktop, with no desktop switch.
+# Exposure predictions concern frame rectangles, not compositor hit-test proof.
