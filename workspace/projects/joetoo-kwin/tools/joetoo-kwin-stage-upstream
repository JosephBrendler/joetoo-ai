# Per-role config README companions are the one controlled exception to the
# fixed list: only README_*_conf.md from these TWO reviewed directories.
# Bash shopt -s nullglob makes a nonmatching pattern expand to ZERO operands,
# rather than passing a literal '*' to sync_one. This is not a recursive scan;
# tests and archived files remain excluded. Shell dialect: Bash only.
shopt -s nullglob
for companion in "$project_root"/docs/README_*_conf.md \
                 "$project_root"/README_*_conf.md; do
    relative=${companion#"$project_root"/}
    sync_one config-readme "$relative" || :
done
shopt -u nullglob

# Optional curated release README, distinct from development project README.
# It documents which source-tree materials were intentionally excluded and
# becomes ROOT README.md in the upstream archive. sync_one's third path arg
# performs that rename without copying the whole release/ directory.
if [[ -f $project_root/release/README.md ]]; then
    sync_one docs release/README.md README.md || :
elif [[ $mode == release-check ]]; then
    run_step 'Curated release/README.md authored in source checkout' \
        test -f "$project_root/release/README.md" || :
fi

if [[ $mode == release-check ]]; then
    release_checks
fi

# Final contract: all manifest entries can be attempted, but ANY reported
# action failure, byte/mode mismatch or reporting fault makes exit nonzero.
# The two successful --apply runs in the maintainer's transcript establish
# parity of selected files, NOT passing licensing/packaging preflight.
j_msg "-${notice}" -p "Operations [$operations]; failed [$failures]"
if (( failures > 0 )); then
    j_msg "-${err}" -p 'Incomplete or conflicting transfer: do NOT run tarup.'
    exit 1
fi
case $mode in
    plan) j_msg "-${notice}" -p 'Plan only. Nothing was transferred; use --apply.' ;;
    apply) j_msg "-${notice}" -p 'Bytes and modes match; NOT a tarup-ready declaration.' ;;
    verify) j_msg "-${notice}" -p 'All selected files match.' ;;
    release-check) j_msg "-${notice}" -p 'Preliminary checks passed; tarup audit remains.' ;;
esac
exit 0

