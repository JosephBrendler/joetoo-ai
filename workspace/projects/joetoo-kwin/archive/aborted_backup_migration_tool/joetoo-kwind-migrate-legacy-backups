"""One-time legacy backup inventory/copy/verification; never removes originals.

Gate A: --inventory emits a plan to stdout. Gate B: --copy PLAN publishes
payloads and a resumable manifest. --verify MANIFEST is strictly read-only.
Legacy-specific metadata lives in the manifest, outside installer provenance.
Run from this project checkout (the installer supplies the archive helpers).
Payloads retain mode/atime/mtime; historical UID/GID/ctime remain in the manifest.
Linux O_NOATIME and renameat2(RENAME_NOREPLACE) are required; no unsafe fallback.
"""

import argparse
import ast
import ctypes
import datetime
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import stat
import sys
import tempfile
import types

ROOT = Path(__file__).resolve().parents[1]
STAMP = re.compile(r'\.before-(update|step1\.2a-update)\.(\d{8}-\d{6})\.(\d+)\Z')


def canonical(value):
    return json.dumps(value, sort_keys=True, separators=(',', ':')).encode()


def checked(path, directory=False):
    """Refuse traversal/symlinks before any read; writes are confined to archive."""
    if not path.is_absolute() or '..' in path.parts:
        raise ValueError(f'Unsafe absolute path: {path}')
    for part in (path, *path.parents):
        if part.is_symlink():
            raise ValueError(f'Refusing symlink: {part}')
    info = path.lstat()
    kind = stat.S_ISDIR if directory else stat.S_ISREG
    if not kind(info.st_mode) or info.st_uid != os.geteuid():
        raise ValueError(f'Unexpected type/owner: {path}')
    return info


def metadata(info):
    # Filename stamps are separately recorded; these are actual filesystem times.
    return dict(size=info.st_size, mode=oct(stat.S_IMODE(info.st_mode)), uid=info.st_uid,
                gid=info.st_gid, atime_ns=info.st_atime_ns, mtime_ns=info.st_mtime_ns,
                ctime_ns=info.st_ctime_ns, device=info.st_dev, inode=info.st_ino)


def read_file(path):
    """O_NOATIME is deliberate: inventory/verification must not alter originals."""
    before = metadata(checked(path))
    # Supported deployment is Linux. If no-atime reads are unavailable, fail
    # rather than silently changing the metadata we promise to preserve.
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NOATIME | os.O_NONBLOCK)
    with os.fdopen(fd, 'rb') as stream:
        if metadata(os.fstat(stream.fileno())) != before:
            raise ValueError(f'File changed before read: {path}')
        data = stream.read()
        if metadata(os.fstat(stream.fileno())) != before:
            raise ValueError(f'File changed during read: {path}')
    if metadata(checked(path)) != before:
        raise ValueError(f'File changed after read: {path}')
    return data, {**before, 'sha256': hashlib.sha256(data).hexdigest()}


def unique_pairs(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise ValueError(f'Duplicate JSON key: {key}')
        result[key] = value
    return result


def read_json(path):
    return json.loads(read_file(path)[0], object_pairs_hook=unique_pairs)


class NoAtimePath(type(Path())):
    def read_text(self, encoding=None, errors=None):
        return read_file(self)[0].decode(encoding or 'utf-8', errors or 'strict')


def archive_helpers():
    # Reuse the current installer's actual archive contract without changing its
    # shell entry point or executing main(). Only trusted imports/helper defs
    # are loaded; input inventories are JSON, never executable source.
    source = read_file(ROOT / 'tools/joetoo-kwind-install-poc')[0].decode()
    embedded = source.split("<<'PY'\n", 1)[1].split('\nPY\n', 1)[0]
    names = {'safe_path', 'private_directory', 'read_provenance', 'write_provenance', 'provenance_id'}
    body = [node for node in ast.parse(embedded).body
            if isinstance(node, (ast.Import, ast.ImportFrom))
            or isinstance(node, ast.FunctionDef) and node.name in names]
    namespace = {}
    exec(compile(ast.Module(body=body, type_ignores=[]), 'installer archive helpers', 'exec'), namespace)
    if not names <= namespace.keys():
        raise ValueError('Installer archive helper contract unavailable')
    return types.SimpleNamespace(**{name: namespace[name] for name in names})


def environment():
    def absolute(value):
        path = Path(value)
        if not path.is_absolute() or '..' in path.parts:
            raise ValueError(f'Expected absolute environment path: {value}')
        return path
    home = absolute(os.environ['HOME'])
    config = absolute(os.environ.get('XDG_CONFIG_HOME') or str(home / '.config'))
    state = absolute(os.environ.get('XDG_STATE_HOME') or str(home / '.local/state'))
    return {'home': str(home), 'config_home': str(config),
            'archive': str(state / 'joetoo-kwin/archive')}


def components(roots):
    home, config = Path(roots['home']), Path(roots['config_home'])
    result = {
        'service': (ROOT / 'user-init.d/joetoo-kwind', config / 'rc/init.d/joetoo-kwind'),
        'daemon': (ROOT / 'libexec/joetoo-kwind', home / '.local/libexec/joetoo-kwind'),
        'registry': (ROOT / 'libexec/joetoo_kwin_registry.py', home / '.local/libexec/joetoo_kwin_registry.py'),
        'override': (ROOT / 'poc-user-conf.d/joetoo-kwind', config / 'rc/conf.d/joetoo-kwind'),
        'resident': (ROOT / 'joetoo-kwin-resident.js', home / '.local/share/joetoo-kwin/joetoo-kwin-resident.js'),
        'cli': (ROOT / 'joetoo-kwin', home / '.local/bin/joetoo-kwin')}
    for name in ('identity', 'target', 'launch'):
        basename = f'joetoo_kwin_vnc_{name}.py'
        result['vnc_' + name] = ROOT / 'libexec' / basename, home / '.local/libexec' / basename
    return result


def validate_version(version, source, destination, helpers, expected=None):
    checked(version, directory=True)
    if stat.S_IMODE(version.stat().st_mode) != 0o700:
        raise ValueError(f'Unsafe version permissions: {version}')
    # Do not call a mkdir-capable helper during Gate A/verification, even if
    # the version disappears concurrently. These checks are read-only.
    for parent in version.parents:
        info = parent.stat()
        if info.st_uid != os.geteuid():
            break
        if info.st_mode & 0o022:
            raise ValueError(f'Unsafe archive ancestor: {parent}')
    payload = version / destination.name
    data, info = read_file(payload)
    if info['sha256'] != version.name or payload.stat().st_nlink != 1:
        raise ValueError(f'Archive payload integrity failure: {payload}')
    if expected is not None and data != expected:
        raise ValueError(f'Archive payload byte mismatch: {payload}')
    paths = [version / 'provenance.json', *sorted(version.glob('provenance.*.json'))]
    records = []
    for path in paths:
        read_json(path)  # Also reject duplicate keys, using no-atime reads.
        records.append(helpers.read_provenance(NoAtimePath(path), version, destination, source))
    first = records[0]
    if first['mode'] != info['mode'] or first['mtime_ns'] != info['mtime_ns']:
        raise ValueError(f'Archive payload/provenance mismatch: {payload}')
    return payload


def archive_inventory(roots):
    """Component files only; manifests/control files are reported separately."""
    archive = Path(roots['archive'])
    files = []
    if archive.exists() or archive.is_symlink():
        checked(archive, directory=True)
        for component in components(roots):
            directory = archive / component
            if directory.exists() or directory.is_symlink():
                checked(directory, directory=True)
                for parent, dirs, names in os.walk(directory, followlinks=False):
                    checked(Path(parent), directory=True)
                    for name in dirs:
                        checked(Path(parent) / name, directory=True)
                    for name in names:
                        path = Path(parent) / name
                        files.append({'path': str(path), **read_file(path)[1]})
    return sorted(files, key=lambda row: row['path'])


def plan_identity(plan):
    # Discovery time and new/reused classifications may change after a partial
    # copy. Identity is the original files, their metadata and intended mapping.
    records = [{k: v for k, v in row.items() if k != 'payload_status'} for row in plan['records']]
    return {'roots': plan['roots'], 'records': records, 'installed': plan['installed']}


def plan_id(plan):
    return hashlib.sha256(canonical(plan_identity(plan))).hexdigest()


def summary(records):
    if any(row['payload_status'] not in ('new', 'already_archived') for row in records):
        raise ValueError('Invalid payload classification')
    groups = {(r['component'], r['sha256']): r['payload_status'] for r in records}
    if any(groups[(r['component'], r['sha256'])] != r['payload_status'] for r in records):
        raise ValueError('Inconsistent duplicate payload classification')
    return {'legacy_paths': len(records), 'distinct_versions': len(groups),
            'duplicate_copies': len(records) - len(groups),
            'new_payloads': sum(v == 'new' for v in groups.values()),
            'reused_payloads': sum(v == 'already_archived' for v in groups.values())}


def inventory():
    roots, helpers = environment(), archive_helpers()
    archive = Path(roots['archive'])
    records, anomalies, installed = [], [], []
    for component, (source, destination) in components(roots).items():
        if destination.exists() or destination.is_symlink():
            installed.append({'path': str(destination), **read_file(destination)[1]})
        else:
            installed.append({'path': str(destination), 'missing': True})
        for pattern in (destination.name + '.before-update.*', destination.name + '.before-step1.2a-update.*'):
            for path in sorted(destination.parent.glob(pattern)):
                try:
                    stamp = STAMP.fullmatch(path.name[len(destination.name):])
                    if not stamp or path.parent != destination.parent:
                        raise ValueError(f'Unexpected legacy filename: {path}')
                    datetime.datetime.strptime(stamp[2], '%Y%m%d-%H%M%S')
                    data, info = read_file(path)
                    version = archive / component / info['sha256']
                    present = version.exists() or version.is_symlink()
                    if present:
                        validate_version(version, source, destination, helpers, data)
                    records.append({'component': component, 'original_path': str(path),
                                    'original_name': path.name, 'backup_scheme': stamp[1],
                                    'embedded_timestamp': stamp[2], 'backup_pid': stamp[3],
                                    **info, 'payload': str(version / destination.name),
                                    'payload_status': 'already_archived' if present else 'new'})
                except (OSError, ValueError) as error:
                    anomalies.append({'path': str(path), 'detail': str(error)})
    records.sort(key=lambda row: row['original_path'])
    if len({row['original_path'] for row in records}) != len(records):
        anomalies.append({'detail': 'Ambiguous component mapping'})
    plan = {'schema_version': 1, 'state': 'blocked' if anomalies else 'planned',
            'created_at': datetime.datetime.now(datetime.timezone.utc).isoformat(),
            'roots': roots, 'records': records, 'installed': installed, 'anomalies': anomalies,
            'archive_before': archive_inventory(roots),
            'summary': summary(records)}
    plan['inventory_id'] = plan_id(plan)
    return plan


def validate_plan(plan):
    if type(plan.get('schema_version')) is not int or plan['schema_version'] != 1 or plan.get('state') != 'planned' or plan.get('anomalies'):
        raise ValueError('Inventory is not an approved complete plan')
    if plan['summary'] != summary(plan['records']):
        raise ValueError('Inconsistent inventory summary')
    if plan['inventory_id'] != plan_id(plan):
        raise ValueError('Inventory identity mismatch')
    current = inventory()
    if current['state'] != 'planned' or plan_identity(current) != plan_identity(plan):
        raise ValueError('Stale/inconsistent inventory: originals or installed files changed; re-inventory')
    return current


def fsync_directory(path):
    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def save_manifest(path, manifest):
    fd, temporary = tempfile.mkstemp(prefix='.manifest-', dir=path.parent)
    try:
        with os.fdopen(fd, 'wb') as stream:
            stream.write(canonical(manifest) + b'\n')
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
        fsync_directory(path.parent)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def publish_directory(staging, version):
    # Plain rename may overwrite an empty destination directory created after
    # validation. Linux NOREPLACE also protects that concurrent/corrupt version.
    libc = ctypes.CDLL(None, use_errno=True)
    rename = getattr(libc, 'renameat2', None)
    if rename is None:
        raise ValueError('Atomic no-replace directory publication unavailable')
    rename.argtypes = (ctypes.c_int, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p, ctypes.c_uint)
    rename.restype = ctypes.c_int
    at_fdcwd, rename_noreplace = -100, 1
    if rename(at_fdcwd, os.fsencode(staging), at_fdcwd, os.fsencode(version), rename_noreplace):
        number = ctypes.get_errno()
        raise OSError(number, os.strerror(number), str(version))


def publish_version(row, source, destination, helpers):
    original, version = Path(row['original_path']), Path(row['payload']).parent
    data, info = read_file(original)
    if info != {k: row[k] for k in info}:
        raise ValueError(f'Original changed before copy: {original}')
    if version.exists() or version.is_symlink():
        return validate_version(version, source, destination, helpers, data), False
    helpers.private_directory(version.parent)
    staging = Path(tempfile.mkdtemp(prefix='.legacy-pending-', dir=version.parent))
    try:
        payload = staging / destination.name
        with payload.open('xb') as stream:
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())
        payload.chmod(int(info['mode'], 8))
        os.utime(payload, ns=(info['atime_ns'], info['mtime_ns']))
        # Standard provenance binds the payload metadata to its rollback
        # installation location. Actual legacy origins/UID/GID/ctime are in the
        # separate migration manifest, never in provenance.*.json records.
        provenance = {'schema_version': 1, 'installed_path': str(destination),
                      'source_path': str(source), 'original_name': destination.name,
                      'sha256': info['sha256'], 'mode': info['mode'],
                      'atime_ns': info['atime_ns'], 'mtime_ns': info['mtime_ns'],
                      'archived_at': datetime.datetime.now(datetime.timezone.utc).isoformat()}
        helpers.write_provenance(staging / 'provenance.json', provenance)
        with payload.open('rb') as stream:
            os.fsync(stream.fileno())
        if read_file(payload)[0] != data or read_file(original)[1] != info:
            raise ValueError(f'Copy/original verification failed: {original}')
        fsync_directory(staging)
        publish_directory(staging, version)
        fsync_directory(version.parent)
        return validate_version(version, source, destination, helpers, data), True
    finally:
        if staging.exists():
            shutil.rmtree(staging)


def verify_manifest(manifest):
    if type(manifest.get('schema_version')) is not int or manifest['schema_version'] != 1:
        raise ValueError('Unsupported manifest schema')
    plan = manifest['plan']
    validate_plan(plan)
    if manifest['inventory_id'] != plan['inventory_id'] or manifest['state'] not in ('complete', 'incomplete'):
        raise ValueError('Inconsistent manifest identity/state')
    helpers, mappings = archive_helpers(), components(plan['roots'])
    expected = sorted({r['payload'] for r in plan['records']})
    if sorted(manifest['verified_payloads']) != expected or manifest['state'] != 'complete':
        raise ValueError('Incomplete migration: not every original path is accounted for')
    for row in plan['records']:
        data, info = read_file(Path(row['original_path']))
        if info != {k: row[k] for k in info}:
            raise ValueError(f'Changed original: {row["original_path"]}')
        validate_version(Path(row['payload']).parent, *mappings[row['component']], helpers, data)
    after = archive_inventory(plan['roots'])
    by_path = {row['path']: row for row in after}
    if any(by_path.get(row['path']) != row for row in manifest['archive_before']):
        raise ValueError('A preexisting archive entry changed during migration')
    return {'state': 'verified', 'legacy_paths': len(plan['records']),
            'distinct_versions': len(expected), 'archive_after': after}


def copy_plan(plan):
    current = validate_plan(plan)  # No archive writes before the whole plan checks.
    helpers = archive_helpers()
    directory = Path(plan['roots']['archive']) / 'migrations'
    helpers.private_directory(directory)
    if stat.S_IMODE(directory.stat().st_mode) != 0o700:
        raise ValueError('Unsafe migration directory permissions')
    lock = directory / 'legacy-copy.lock'
    helpers.safe_path(lock)
    fd = os.open(lock, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, 'r+') as stream:
        info = os.fstat(stream.fileno())
        if stat.S_IMODE(info.st_mode) != 0o600 or info.st_nlink != 1:
            raise ValueError('Unsafe migration lock permissions/links')
        fcntl.flock(stream, fcntl.LOCK_EX | fcntl.LOCK_NB)
        path = directory / f'legacy-{plan["inventory_id"]}.json'
        helpers.safe_path(path)
        if path.exists():
            if stat.S_IMODE(path.stat().st_mode) != 0o600 or path.stat().st_nlink != 1:
                raise ValueError('Unsafe manifest permissions/links')
            manifest = read_json(path)
            validate_plan(manifest['plan'])
            if (type(manifest.get('schema_version')) is not int or manifest['schema_version'] != 1 or manifest.get('inventory_id') != plan['inventory_id']
                    or manifest.get('state') not in ('complete', 'incomplete')
                    or plan_identity(manifest['plan']) != plan_identity(plan)):
                raise ValueError('Existing manifest does not match inventory')
            keys = {row['payload'] for row in plan['records']}
            if (not isinstance(manifest['verified_payloads'], list)
                    or any(not isinstance(key, str) or key not in keys for key in manifest['verified_payloads'])
                    or len(set(manifest['verified_payloads'])) != len(manifest['verified_payloads'])):
                raise ValueError('Invalid manifest payload accounting')
            if manifest['state'] == 'complete':
                return {**verify_manifest(manifest), 'manifest': str(path),
                        'new_payloads': 0, 'reused_payloads': len(manifest['verified_payloads'])}
        else:
            manifest = {'schema_version': 1, 'inventory_id': plan['inventory_id'],
                        'state': 'incomplete', 'plan': plan, 'verified_payloads': [],
                        'archive_before': current['archive_before']}
            save_manifest(path, manifest)
        mappings, new, reused = components(plan['roots']), 0, 0
        groups = {row['payload']: row for row in reversed(plan['records'])}
        try:
            for key, row in groups.items():
                _, created = publish_version(row, *mappings[row['component']], helpers)
                new += int(created)
                reused += int(not created)
                if key not in manifest['verified_payloads']:
                    manifest['verified_payloads'].append(key)
                    save_manifest(path, manifest)
            manifest['state'] = 'complete'
            result = verify_manifest(manifest)
            manifest['archive_after'] = result['archive_after']
            save_manifest(path, manifest)
            return {**result, 'manifest': str(path), 'new_payloads': new, 'reused_payloads': reused}
        except BaseException:
            # The last durable manifest remains incomplete. Originals are never
            # changed, even if publication or a later verification is interrupted.
            manifest['state'] = 'incomplete'
            raise


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    actions = parser.add_mutually_exclusive_group(required=True)
    actions.add_argument('--inventory', action='store_true')
    actions.add_argument('--copy', type=Path, metavar='INVENTORY')
    actions.add_argument('--verify', type=Path, metavar='MANIFEST')
    args = parser.parse_args()
    try:
        if os.geteuid() == 0:
            raise ValueError('Run as the ordinary user, not root')
        if args.inventory:
            result = inventory()
        elif args.copy:
            result = copy_plan(read_json(args.copy.absolute()))
        else:
            manifest_path = args.verify.absolute()
            checked(manifest_path)
            if stat.S_IMODE(manifest_path.stat().st_mode) != 0o600 or manifest_path.stat().st_nlink != 1:
                raise ValueError('Unsafe manifest permissions')
            result = verify_manifest(read_json(manifest_path))
        print(json.dumps(result, indent=2))
        return int(result['state'] == 'blocked')
    except (OSError, ValueError, KeyError, TypeError, AttributeError, KeyboardInterrupt) as error:
        print(json.dumps({'state': 'incomplete', 'detail': str(error)}), file=sys.stderr)
        return 1


if __name__ == '__main__':
    sys.exit(main())
