#
# Proposed user-level OpenRC service; install as /etc/user/init.d/joetoo-kwind.
# Do not install in /etc/init.d or launch as root.
# OpenRC consumes configuration globals after sourcing; ShellCheck cannot see them.
# shellcheck disable=SC2034

# OpenRC preloads user conf.d before this script. Re-source the global
# entry point to impose the joetoo-defined defaults -> administrator -> user
# precedence before the command assignment. User mode does not switch UID.
# Without a packaged global file, the standalone POC's OpenRC-loaded user
# config and the command fallback remain available.
if [ -r /etc/conf.d/joetoo-kwind ]; then
    . /etc/conf.d/joetoo-kwind
fi

description="joetoo KWin session D-Bus broker (user service)"
supervisor="supervise-daemon"
command="${JOETOO_KWIND_EXEC:-/usr/libexec/joetoo-kwind}"
# Pass the same resolved configuration to the Python broker.
export JOETOO_KWIND_RESIDENT_JS="${JOETOO_KWIND_RESIDENT_JS:-/usr/share/joetoo-kwin/joetoo-kwin-resident.js}"
export JOETOO_KWIND_SCRIPT_NAME="${JOETOO_KWIND_SCRIPT_NAME:-joetoo-bridge}"
pidfile="${XDG_RUNTIME_DIR}/joetoo-kwin/joetoo-kwind.supervisor.pid"

# Retain OpenRC's default start, stop and status functions. This daemon stays
# in the foreground and must not supervise or launch Konsole/SSH descendants.
respawn_delay=10
respawn_max=5
respawn_period=120

# Explicitly override any global OpenRC cgroup cleanup policy for this service.
# Supervision must never imply permission to terminate managed windows.
rc_cgroup_cleanup="NO"

start_pre() {
    if [ "$(id -u)" -eq 0 ]; then
        eerror "joetoo-kwind must run as the graphical user, not root"
        return 1
    fi
    # rc-service -U runs in the invoking user's environment, not as root.
    # HOME must be nonempty and absolute before proceeding:
    # without it, the XDG fallback could accidentally target /.config.
    if [ -z "${HOME:-}" ] || [ "${HOME#/}" = "$HOME" ]; then
        eerror "HOME must be set to an absolute user home directory"
        return 1
    fi
    if [ -n "${XDG_CONFIG_HOME:-}" ] &&
       [ "${XDG_CONFIG_HOME#/}" = "$XDG_CONFIG_HOME" ]; then
        eerror "XDG_CONFIG_HOME must be absolute when set"
        return 1
    fi
    if [ -z "${XDG_RUNTIME_DIR:-}" ] || [ "${XDG_RUNTIME_DIR#/}" = "$XDG_RUNTIME_DIR" ] ||
       [ ! -d "$XDG_RUNTIME_DIR" ]; then
        eerror "XDG_RUNTIME_DIR must name an existing absolute user runtime directory"
        return 1
    fi
    # Guard against a misdirected runtime directory, e.g. a stale 'sudo' env.
    if [ "$(stat -c %u -- "$XDG_RUNTIME_DIR")" != "$(id -u)" ]; then
        eerror "XDG_RUNTIME_DIR is not owned by the current user"
        return 1
    fi
    if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
        if [ -S "$XDG_RUNTIME_DIR/bus" ]; then
            export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
        else
            eerror "No graphical D-Bus session address was passed to joetoo-kwind"
            eerror "OpenRC may have filtered DBUS_SESSION_BUS_ADDRESS, and no XDG_RUNTIME_DIR/bus socket exists"
            eerror "Allow DBUS_SESSION_BUS_ADDRESS in the user OpenRC rc.conf, preserving other entries"
            eerror "See project README.md (or run tools/joetoo-kwind-configure-openrc-user --apply)"
            return 1
        fi
    fi
    checkpath -d -m 0700 "$XDG_RUNTIME_DIR/joetoo-kwin" || return 1
}
