#!/bin/bash
# Copyright 2025-2026 Joseph Brendler
# SPDX-License-Identifier: GPL-3.0-or-later
# Adapted from archive/step1-candidate/joetoo-kwin-plan-functions.
# Sourced by the client. These arrays are launch intent, never runtime identity.
# Later -o and -m l/r must consume this policy rather than copy its formulas.
# Severity and color globals are supplied by the caller's script_header_joetoo.
# shellcheck disable=SC2154

plan_defaults() {
    # Work-area discovery is unresolved: dimensions must be supplied explicitly.
    screen_width=""
    screen_height=""
    desktop_limit=20
    dt_win_limit=4
    min_window_exposure_px=32
    initial_focus_timeout_ms=500
    initial_focus_poll_interval_ms=25
    sftp_capability_timeout_ms=2000
    vnc_ssh_start_timeout_ms=10000
    vnc_viewer_ready_timeout_ms=120000
    vnc_supervisor_poll_interval_ms=100
    vnc_cleanup_timeout_ms=2000
    vnc_local_port_attempts=3
    vnc_identity_event_limit=256
    vnc_identity_settle_ms=500
    vnc_dbus_timeout_ms=3000
    vnc_identity_start_timeout_ms=1000
    vnc_placement_timeout_ms=15000
    # Offline configured RDP intent; runtime dispatch belongs to Stage 2.
    rdp_remote_width=1024
    rdp_remote_height=768
    RDP_SMART_SIZING=$TRUE
    rdp_initial_client_width=800
    rdp_initial_client_height=600
    rdp_windowing_backend=auto
    sftp_advisory_enabled=$TRUE
    sftp_advisory_timeout_ms=2000
    sftp_advisory_ssh_port=22
    terminal_width_percent=87
    terminal_gap_percent=2
    terminal_height_percent=85
    terminal_left_percent=1
    terminal_top_percent=5
    terminal_row_gap_percent=3
    graphical_left_percent=5
    graphical_top_percent=3
    graphical_width_percent=94
    graphical_height_percent=90
    declare -ga desktop_session_list=()
}

plan_error() {
    j_msg "-${err}" -p "${PN}: $1"
    return 2
}

# Geometry is also used by interactive moves, without a session recipe list.
validate_layout_geometry() {
    local _vp_name _vp_value
    for _vp_name in screen_width screen_height desktop_limit terminal_width_percent \
        terminal_gap_percent terminal_height_percent terminal_left_percent terminal_top_percent \
        terminal_row_gap_percent graphical_left_percent graphical_top_percent \
        graphical_width_percent graphical_height_percent; do
        _vp_value=${!_vp_name-}
        # Bound length BEFORE arithmetic, avoiding overflow and Bash expressions.
        if [[ ! $_vp_value =~ ^(0|[1-9][0-9]{0,4})$ ]]; then
            plan_error "${_vp_name} must be a nonnegative decimal integer (at most five digits): [${_vp_value}]"
            return 2
        fi
    done
    if (( screen_width < 1 || screen_width > 32768 || screen_height < 1 || screen_height > 32768 ||
        desktop_limit < 1 || desktop_limit > 256 )); then
        plan_error 'invalid configured screen dimensions or desktop limit (no display autodetection)'
        return 2
    fi
    for _vp_name in terminal_width_percent terminal_height_percent graphical_width_percent graphical_height_percent; do
        if (( ${!_vp_name} < 1 || ${!_vp_name} > 100 )); then
            plan_error "${_vp_name} must be between 1 and 100"; return 2
        fi
    done
    for _vp_name in terminal_gap_percent terminal_left_percent terminal_top_percent terminal_row_gap_percent \
        graphical_left_percent graphical_top_percent; do
        if (( ${!_vp_name} > 100 )); then
            plan_error "${_vp_name} must be between 0 and 100"; return 2
        fi
    done
    # Reject overflow of the intended region even if integer rounding might hide it.
    if (( terminal_left_percent + terminal_width_percent > 100 ||
        terminal_top_percent + terminal_height_percent > 100 ||
        graphical_left_percent + graphical_width_percent > 100 ||
        graphical_top_percent + graphical_height_percent > 100 )); then
        plan_error 'configured regions extend beyond the display'; return 2
    fi
    return 0
}

validate_plan() {
    local _vp_name _vp_value _vp_record _vp_delimiters _vp_declaration
    local _vp_desktop _vp_program _vp_mode _vp_target _vp_layer _vp_explicit _vp_total _vp_sftp_dir _vp_uri _vp_rdp_target
    # Reset all derived state so rebuilding a plan cannot accumulate old entries.
    declare -ga planned_desktop=() planned_slot=() planned_program=() planned_mode=() planned_target=()
    declare -ga planned_x=() planned_y=() planned_width=() planned_height=() planned_layer=()
    declare -ga planned_explicit=() desktop_groups=()
    declare -ga planned_rdp_target=()
    declare -g rdp_settings="" # Validated nonsecret sizing/backend JSON, not a runtime launch.
    declare -g vnc_bounds="" # Validated JSON consumed by the configured VNC launcher.
    # shellcheck disable=SC2034
    declare -ga planned_sftp_uri=()
    declare -gA preferred_slot=() planned_stack_slots=()
    declare -gA implicit_counts=() total_counts=() terminal_counts=() terminal_slots=() next_slot=()

    validate_layout_geometry || return $?
    if [[ $sftp_advisory_enabled != "$TRUE" && -n $sftp_advisory_enabled ]] ||
        [[ ! $sftp_advisory_timeout_ms =~ ^[1-9][0-9]{0,4}$ || ! $sftp_advisory_ssh_port =~ ^[1-9][0-9]{0,4}$ ]] ||
        (( sftp_advisory_timeout_ms > 10000 || sftp_advisory_ssh_port > 65535 )); then
        plan_error 'invalid SFTP advisory settings: enabled TRUE/FALSE, timeout 1..10000 ms, port 1..65535'; return 2
    fi
    if [[ ! $sftp_capability_timeout_ms =~ ^[1-9][0-9]{0,4}$ ]] || (( sftp_capability_timeout_ms > 10000 )); then
        plan_error 'sftp_capability_timeout_ms must be 1..10000 ms'; return 2
    fi
    # These new observation bounds fit inside the existing ten-second lease.
    if [[ ! $initial_focus_timeout_ms =~ ^[1-9][0-9]{0,3}$ ||
          ! $initial_focus_poll_interval_ms =~ ^[1-9][0-9]{0,2}$ ]] ||
        (( initial_focus_timeout_ms > 2000 || initial_focus_poll_interval_ms > 250 ||
           initial_focus_poll_interval_ms > initial_focus_timeout_ms )); then
        plan_error 'invalid initial focus timing: timeout 1..2000 ms; interval 1..250 ms and <= timeout'; return 2
    fi
    if [[ ! $dt_win_limit =~ ^[1-9][0-9]{0,2}$ || ! $min_window_exposure_px =~ ^[1-9][0-9]{0,4}$ ]] ||
        (( dt_win_limit > 256 || min_window_exposure_px > 32768 )); then
        plan_error 'invalid dt_win_limit (1..256) or min_window_exposure_px (1..32768)'; return 2
    fi
    _vp_declaration=$(declare -p desktop_session_list 2>/dev/null) || return 2
    if [[ $_vp_declaration != 'declare -a '* || ${#desktop_session_list[@]} == 0 ]]; then
        plan_error 'desktop_session_list must be a nonempty indexed Bash array'; return 2
    fi
    for _vp_record in "${desktop_session_list[@]}"; do
        _vp_delimiters=${_vp_record//[^|]/}
        if (( ${#_vp_delimiters} != 3 && ${#_vp_delimiters} != 4 )) || [[ $_vp_record == *[$'\n\r\t\e']* ]]; then
            # A malformed target may contain credentials. Never echo the record.
            plan_error 'expected four or five single-line pipe-delimited fields (entry redacted)'; return 2
        fi
        IFS='|' read -r _vp_desktop _vp_program _vp_mode _vp_target _vp_layer <<< "$_vp_record"
        if [[ ! $_vp_desktop =~ ^[1-9][0-9]{0,2}$ ]] || (( _vp_desktop > desktop_limit )); then
            plan_error "invalid desktop or desktop exceeds limit: [${_vp_desktop}]"; return 2
        fi
        if [[ ! $_vp_program =~ ^[a-zA-Z0-9_][a-zA-Z0-9_.+-]*$ ]]; then
            plan_error "program must be an executable basename: [${_vp_program}]"; return 2
        fi
        if [[ $_vp_program == sdl-freerdp && $_vp_mode != rdp ]]; then
            plan_error 'sdl-freerdp requires rdp mode'; return 2
        fi
        case $_vp_mode in
            ssh|swr|via-ssh|local|direct) ;;
            rdp) [[ $_vp_program == sdl-freerdp ]] || { plan_error 'rdp mode requires sdl-freerdp'; return 2; } ;;
            sftp) [[ $_vp_program == dolphin ]] || { plan_error 'sftp mode requires Dolphin'; return 2; } ;;
            *) plan_error "unsupported mode [${_vp_mode}]"; return 2 ;;
        esac
        _vp_rdp_target=""
        if [[ $_vp_mode == rdp ]]; then
            _vp_sftp_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P) || return 2
            _vp_rdp_target=$(printf '%s' "$_vp_target" | python3 "$_vp_sftp_dir/joetoo_kwin_rdp_target.py" --target) || return 2
            if [[ -z $rdp_settings ]]; then
                rdp_settings=$(python3 "$_vp_sftp_dir/joetoo_kwin_rdp_target.py" --settings \
                    "$rdp_remote_width" "$rdp_remote_height" "$RDP_SMART_SIZING" \
                    "$rdp_initial_client_width" "$rdp_initial_client_height" "$rdp_windowing_backend") || return 2
            fi
        fi
        _vp_uri=""
        if [[ $_vp_mode == sftp ]]; then
            _vp_sftp_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P) || return 2
            # Unvalidated userinfo stays on stdin, never a child command line.
            _vp_uri=$(printf '%s' "$_vp_target" | python3 "$_vp_sftp_dir/joetoo_kwin_sftp_target.py") || return 2
        fi
        if [[ $_vp_program == vncviewer && $_vp_mode == ssh ]]; then
            _vp_sftp_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P) || return 2
            printf '%s' "$_vp_target" | python3 "$_vp_sftp_dir/joetoo_kwin_vnc_target.py" --target >/dev/null || return 2
            # shellcheck disable=SC2034
            vnc_bounds=$(python3 "$_vp_sftp_dir/joetoo_kwin_vnc_target.py" --settings \
                "$vnc_ssh_start_timeout_ms" "$vnc_viewer_ready_timeout_ms" "$vnc_supervisor_poll_interval_ms" \
                "$vnc_cleanup_timeout_ms" "$vnc_local_port_attempts" "$vnc_identity_event_limit" \
                "$vnc_identity_settle_ms" "$vnc_dbus_timeout_ms" "$vnc_placement_timeout_ms" "$vnc_identity_start_timeout_ms") || return 2
        fi
        if [[ $_vp_mode != direct && -z $_vp_target && ! ( $_vp_program == dolphin && $_vp_mode == local ) ]]; then
            plan_error "missing target for mode [${_vp_mode}]"; return 2
        fi
        # A blank fifth field is an implicit panel, as in the approved example.
        _vp_explicit=0
        if [[ -n $_vp_layer ]]; then _vp_explicit=1; else _vp_layer=panel; fi
        case $_vp_layer in panel|under|over) ;; *) plan_error 'invalid layer'; return 2 ;; esac
        [[ -v total_counts[$_vp_desktop] ]] || desktop_groups+=("$_vp_desktop")
        total_counts[$_vp_desktop]=$(( ${total_counts[$_vp_desktop]:-0} + 1 ))
        implicit_counts[$_vp_desktop]=$(( ${implicit_counts[$_vp_desktop]:-0} + 1 - _vp_explicit ))
        if [[ $_vp_layer == panel ]]; then
            terminal_counts[$_vp_desktop]=$(( ${terminal_counts[$_vp_desktop]:-0} + 1 ))
        fi
        planned_layer+=("$_vp_layer"); planned_explicit+=("$_vp_explicit")
        planned_desktop+=("$_vp_desktop")
        planned_program+=("$_vp_program")
        planned_mode+=("$_vp_mode")
        planned_target+=("$_vp_target")
        planned_sftp_uri+=("$_vp_uri")
        planned_rdp_target+=("$_vp_rdp_target")
    done
    for _vp_desktop in "${desktop_groups[@]}"; do
        _vp_total=${total_counts[$_vp_desktop]}
        if (( _vp_total > 256 )); then
            plan_error 'desktop group exceeds bounded transaction cohort (256)'; return 2
        fi
        if (( ${implicit_counts[$_vp_desktop]} > dt_win_limit )); then
            plan_error "desktop [$_vp_desktop] implicit entries exceed dt_win_limit"; return 2
        fi
        if (( _vp_total > dt_win_limit )); then
            j_msg "-${warn}" -p "Desktop [$_vp_desktop]: explicit layers exceed ordinary layout budget [$_vp_total/$dt_win_limit]"
        fi
        if (( ${terminal_counts[$_vp_desktop]:-0} > 4 )); then
            plan_error "desktop [$_vp_desktop] has more than four panel windows; allocator limit"; return 2
        fi
    done
    return 0
}

# Shared terminal policy: count/slot in, geometry_x/y/width/height out.
# A two-terminal request here will also serve the later interactive l/r workflow.
terminal_geometry() {
    local _tg_count=$1 _tg_slot=$2 _tg_columns _tg_rows _tg_col _tg_row
    local _tg_region _tg_gap _tg_height _tg_row_gap
    if [[ ! $_tg_count =~ ^[1-4]$ || ! $_tg_slot =~ ^[1-4]$ ]] || (( _tg_slot > _tg_count )); then
        plan_error 'invalid terminal count or slot'; return 2
    fi
    _tg_columns=$_tg_count; _tg_rows=1
    if (( _tg_count == 4 )); then _tg_columns=2; _tg_rows=2; fi
    _tg_col=$(( (_tg_slot - 1) % _tg_columns ))
    _tg_row=$(( (_tg_slot - 1) / _tg_columns ))
    _tg_region=$(( screen_width * terminal_width_percent / 100 ))
    _tg_gap=$(( screen_width * terminal_gap_percent / 100 ))
    _tg_height=$(( screen_height * terminal_height_percent / 100 ))
    _tg_row_gap=$(( screen_height * terminal_row_gap_percent / 100 ))
    geometry_width=$(( (_tg_region - (_tg_columns - 1) * _tg_gap) / _tg_columns ))
    geometry_height=$(( (_tg_height - (_tg_rows - 1) * _tg_row_gap) / _tg_rows ))
    geometry_x=$(( screen_width * terminal_left_percent / 100 + _tg_col * (geometry_width + _tg_gap) ))
    geometry_y=$(( screen_height * terminal_top_percent / 100 + _tg_row * (geometry_height + _tg_row_gap) ))
    if (( geometry_width < 1 || geometry_height < 1 )); then
        plan_error 'terminal gutters leave no usable window area'; return 2
    fi
    return 0
}

calculate_plan() {
    local _cp_i _cp_desktop _cp_slot _cp_terminal_slot _cp_key _cp_offset _cp_warning _cp_dir
    local -A _cp_cascade=()
    local _cp_group _cp_layer _cp_preferred
    for ((_cp_i=0; _cp_i<${#planned_desktop[@]}; _cp_i++)); do
        _cp_desktop=${planned_desktop[$_cp_i]}
        _cp_slot=$(( ${next_slot[$_cp_desktop]:-0} + 1 ))
        next_slot[$_cp_desktop]=$_cp_slot
        if [[ ${planned_layer[$_cp_i]} == panel ]]; then
            _cp_terminal_slot=$(( ${terminal_slots[$_cp_desktop]:-0} + 1 ))
            terminal_slots[$_cp_desktop]=$_cp_terminal_slot
            terminal_geometry "${terminal_counts[$_cp_desktop]}" "$_cp_terminal_slot" || return $?
        else
            # Provisional graphical underlay geometry. This does not control
            # KWin stacking or focus; these require later native validation.
            geometry_x=$(( screen_width * graphical_left_percent / 100 ))
            geometry_y=$(( screen_height * graphical_top_percent / 100 ))
            geometry_width=$(( screen_width * graphical_width_percent / 100 ))
            geometry_height=$(( screen_height * graphical_height_percent / 100 ))
            # Share a cascade across under/over entries in desktop-local file
            # order, avoiding identical cross-layer rectangles where room exists.
            _cp_key=$_cp_desktop
            _cp_offset=$(( ${_cp_cascade[$_cp_key]:-0} * min_window_exposure_px ))
            _cp_cascade[$_cp_key]=$(( ${_cp_cascade[$_cp_key]:-0} + 1 ))
            geometry_x=$(( geometry_x + _cp_offset )); geometry_y=$(( geometry_y + _cp_offset ))
            (( geometry_x + geometry_width <= screen_width )) || geometry_x=$(( screen_width - geometry_width ))
            (( geometry_y + geometry_height <= screen_height )) || geometry_y=$(( screen_height - geometry_height ))
        fi
        if (( geometry_width < 1 || geometry_height < 1 || geometry_x < 0 || geometry_y < 0 ||
            geometry_x + geometry_width > screen_width || geometry_y + geometry_height > screen_height )); then
            plan_error 'calculated geometry cannot fit configured display'; return 2
        fi
        planned_slot+=("$_cp_slot")
        planned_x+=("$geometry_x"); planned_y+=("$geometry_y")
        planned_width+=("$geometry_width"); planned_height+=("$geometry_height")
        j_msg "-${debug}" -p "Planned desktop [${_cp_desktop}] slot [${_cp_slot}]: ${geometry_x},${geometry_y} ${geometry_width}x${geometry_height}"
    done
    for _cp_group in "${desktop_groups[@]}"; do
        planned_stack_slots[$_cp_group]=""; _cp_preferred=""
        for _cp_layer in under panel over; do
            for ((_cp_i=0; _cp_i<${#planned_desktop[@]}; _cp_i++)); do
                if [[ ${planned_desktop[$_cp_i]} == "$_cp_group" && ${planned_layer[$_cp_i]} == "$_cp_layer" ]]; then
                    planned_stack_slots[$_cp_group]+="${planned_slot[$_cp_i]} "
                    [[ $_cp_layer == under ]] || _cp_preferred=${planned_slot[$_cp_i]}
                fi
            done
        done
        preferred_slot[$_cp_group]=$_cp_preferred
        _cp_preferred=${preferred_slot[$_cp_group]}
        j_msg "-${info}" -m "Desktop [$_cp_group]: implicit [${implicit_counts[$_cp_group]}], explicit [$(( total_counts[$_cp_group] - implicit_counts[$_cp_group] ))]; initial stack slots bottom-to-top [${planned_stack_slots[$_cp_group]}], preferred focus slot [${_cp_preferred:-none}] (intent only)"
    done
    _cp_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P) || return 1
    _cp_warning=$(
        for ((_cp_i=0; _cp_i<${#planned_desktop[@]}; _cp_i++)); do
            printf '%s %s %s %s %s %s %s\n' "${planned_desktop[$_cp_i]}" "${planned_layer[$_cp_i]}" "${planned_slot[$_cp_i]}" \
                "${planned_x[$_cp_i]}" "${planned_y[$_cp_i]}" "${planned_width[$_cp_i]}" "${planned_height[$_cp_i]}"
        done | python3 "$_cp_dir/joetoo-kwin-exposure.py" "$min_window_exposure_px"
    ) || return 1
    while IFS= read -r _cp_warning; do
        [[ -z $_cp_warning ]] || j_msg "-${warn}" -p "$_cp_warning (frame prediction; compositor/decorations may differ)"
    done <<< "$_cp_warning"
    return 0
}

print_plan() {
    local _pp_i _pp_col _pp_length _pp_padding _pp_line _pp_color _pp_layer
    local -a _pp_cells=(Desktop Slot Program Mode Target Layer X Y Width Height)
    local -a _pp_widths=()
    if [[ ${1:-dry-run} == launch ]]; then
        j_msg "-${notice}" -p "LAUNCH PLAN: [${#planned_desktop[@]}] windows; confirmation required"
    else
        j_msg "-${notice}" -p "DRY RUN: [${#planned_desktop[@]}] windows; planner launches no applications"
    fi
    j_msg "-${notice}" -p "Execution desktop groups: [${desktop_groups[*]}]; preserve entry order within each group"
    for _pp_layer in "${planned_layer[@]}"; do
        if [[ $_pp_layer != panel ]]; then
            j_msg "-${notice}" -p 'Exposure is a frame-rectangle prediction; compositor visibility and decoration hit targets require native validation'
            break
        fi
    done
    j_msg "-${notice}" -p "The sourced trusted Bash configuration may have side effects."
    j_msg "-${notice}" -p "Configured display: [${screen_width}x${screen_height}] (not autodetected); terminal width budget: [${terminal_width_percent}%]"
    for ((_pp_i=0; _pp_i<${#planned_desktop[@]}; _pp_i++)); do
        _pp_cells+=("${planned_desktop[$_pp_i]}" "${planned_slot[$_pp_i]}"
            "${planned_program[$_pp_i]}" "${planned_mode[$_pp_i]}" "${planned_target[$_pp_i]:--}"
            "${planned_layer[$_pp_i]}" "${planned_x[$_pp_i]}" "${planned_y[$_pp_i]}"
            "${planned_width[$_pp_i]}" "${planned_height[$_pp_i]}")
    done
    # Measure visible columns using the header, including longer targets. Keep
    # padding plain: pad() adds a color reset, while each row is colored by j_msg.
    # printf only generates spaces; severity, colors and routing stay with j_msg.
    for ((_pp_i=0; _pp_i<${#_pp_cells[@]}; _pp_i++)); do
        _pp_col=$(( _pp_i % 10 ))
        _pp_length=$(get_msg_len "${_pp_cells[$_pp_i]}") || return 1
        if (( _pp_length > ${_pp_widths[$_pp_col]:-0} )); then
            _pp_widths[_pp_col]=$_pp_length
        fi
    done
    _pp_line=""; _pp_color=$BCon
    for ((_pp_i=0; _pp_i<${#_pp_cells[@]}; _pp_i++)); do
        _pp_col=$(( _pp_i % 10 ))
        _pp_line+=${_pp_cells[$_pp_i]}
        if (( _pp_col == 9 )); then
            j_msg "-${notice}" -m "${_pp_color}${_pp_line}${Boff}"
            _pp_line=""; _pp_color=$BGon
        else
            _pp_length=$(get_msg_len "${_pp_cells[$_pp_i]}") || return 1
            printf -v _pp_padding '%*s' "$(( _pp_widths[_pp_col] - _pp_length + 2 ))" ''
            _pp_line+=$_pp_padding
        fi
    done
    return 0
}
