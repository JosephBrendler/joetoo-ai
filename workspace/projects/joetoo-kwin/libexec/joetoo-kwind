"""Non-root OpenRC-supervised KWin session-bus broker.

Preserves the move/launch contract, and initializes KWin resident JS;
application process supervision and window persistence are not yet implemented.
"""

# Standard Python libraries: JSON messages, process environment and IDs,
# POSIX signals and file metadata, elapsed time, and unique request tokens.
# No window-launching or SSH process control modules are needed here.
import json
import math
from copy import deepcopy
import os
import re
import signal
import secrets
import stat
import sys
import time
import uuid

# dbus-python makes this process both a session-bus service (Broker) and
# a client of KWin's own D-Bus scripting interface (ResidentCoordinator).
# GLib supplies one event loop to dispatch messages, timers, and signals.
import dbus
import dbus.service
from dbus.mainloop.glib import DBusGMainLoop
from gi.repository import GLib

# The installed daemon and registry module must reside in the same libexec
# directory. The headless test loader does not add that directory to sys.path.
_libexec_dir = os.path.dirname(os.path.realpath(__file__))
if _libexec_dir not in sys.path:
    sys.path.insert(0, _libexec_dir)
from joetoo_kwin_registry import RegistryError, WindowRegistry
# Lazy factories preserve non-VNC startup when optional deployment files have
# not yet been installed. VNC preflight reports their absence explicitly.
def DesktopObserver(bounds):
    from joetoo_kwin_vnc_identity import DesktopObserver as observer_type
    return observer_type(bounds)


def viewer_settings(data):
    from joetoo_kwin_vnc_target import settings
    return settings(data)

# Our D-Bus address has three parts:
#   BUS  = unique service name that the Python process requests ownership of;
#   PATH = object address *within* that service;
#   IFACE = method namespace presented by the object.
# An individual call also names a method, e.g. IFACE + ".Submit".
BUS = "org.joetoo.KWinBridge"
PATH = "/org/joetoo/KWinBridge"
IFACE = BUS


def matches_class(expected, resource_class, desktop_file):
    """Accept either the advertised class or the final component of an app ID."""
    # strip() removes surrounding whitespace; casefold() compares without
    # case distinctions. A dotted desktop-file ID may have a namespace prefix
    # such as "org.kde." before the expected application class.
    # This is *provisional* class matching, not proof of window identity.
    target = str(expected).strip().casefold()
    if not target:
        return False
    for actual in (resource_class, desktop_file):
        actual = str(actual).strip().casefold()
        if actual == target or actual.endswith("." + target):
            return True
    return False


def validate_session_environment():
    """Reject root/wrong runtime-dir; never silently autolaunch a new D-Bus bus."""
    # The caller must be the ordinary graphical user. geteuid() is the
    # effective numeric user ID; zero would give the broker root privileges.
    if os.geteuid() == 0:
        raise RuntimeError("joetoo-kwind must not run as root")
    # .get(key, "") returns an empty default for a missing variable.
    # The graphical session's runtime directory must be an absolute path.
    runtime = os.environ.get("XDG_RUNTIME_DIR", "")
    if not runtime or not os.path.isabs(runtime):
        raise RuntimeError("XDG_RUNTIME_DIR must be an absolute path")
    # os.stat() reads file metadata; unlike opening a file it does not
    # execute anything. Re-raise an unavailable directory as a clear error.
    try:
        info = os.stat(runtime)
    except OSError as exc:
        raise RuntimeError("XDG_RUNTIME_DIR is unavailable") from exc
    # Require an actual directory owned by this account. st_mode describes
    # file type/permissions; st_uid gives its owner's numeric user ID.
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.geteuid():
        raise RuntimeError("XDG_RUNTIME_DIR must be a user-owned directory")
    # Use the existing session-bus address when OpenRC passed it through.
    # Otherwise look only for an already-existing Unix socket; never start
    # a separate D-Bus daemon, which could address the wrong Plasma session.
    if not os.environ.get("DBUS_SESSION_BUS_ADDRESS"):
        socket_path = os.path.join(runtime, "bus")
        try:
            is_socket = stat.S_ISSOCK(os.stat(socket_path).st_mode)
        except OSError:
            is_socket = False
        if not is_socket:
            raise RuntimeError("No user session bus address or runtime bus socket")
        os.environ["DBUS_SESSION_BUS_ADDRESS"] = "unix:path=" + socket_path


# dbus.service.Object is a base class that exposes Python methods over D-Bus.
# Only one request record is held in memory at this early milestone. The
# broker is NOT a parent/process supervisor for Konsole or SSH applications.
class Broker(dbus.service.Object):
    def __init__(self, bus_name):
        # super() initializes dbus-python's parent object with the acquired
        # service name and this object's path. `self` is this Broker instance;
        # None means that no move/launch request has been submitted yet.
        super().__init__(bus_name, PATH)
        self.request = None
        # Transient diagnostic observations are NOT a managed-window registry.
        # No observed window becomes eligible for -d or -x; these records are
        # session-local and deliberately disappear when this broker restarts.
        self.observed_windows = {}
        # Lifecycle history is bounded independently of geometry traffic.
        # These events describe observation only, never managed ownership.
        self.observation_events = []
        # Highest lifecycle event ID evicted by the 128-record cap. A probe
        # started before that event cannot claim to list every new candidate.
        self.observation_evicted_through = 0
        # Each living UUID needs at most one coalesced change summary.
        # This is NOT a second managed-window registry.
        self.observation_changes = {}
        # Sequence numbers identify retained events only during THIS broker
        # lifetime. They do not survive restart or identify a KWin session.
        self.observation_sequence = 0
        # The current resident script is the source of our inventory. Revisions
        # order its asynchronous messages; they never grant window ownership.
        self.observation_source = None
        self.observation_revision = -1
        self.observation_synced = False
        self.initial_layout = None
        self.initial_layout_protocol = 0
        self.single_raise_protocol = 0
        self.viewer_protocol = 0
        self.move_protocol = 0  # Advertised by the synchronized resident, not inferred.
        # Step 1.3b diagnostic-only: one pending correlation probe. This is
        # deliberately NOT the managed-window registry of Step 1.4.
        self.correlation = None
        # Step 1.4b: ownership and correlation kept entirely broker-private.
        # None of these methods is exposed as a D-Bus registration API.
        self.registry = WindowRegistry()
        self._managed_correlation = None
        # Private SDL prototype; deliberately has no D-Bus entry points.
        self._rdp_registration = None
        self._sdl_pending_auth = None
        self._sdl_registered = {}  # Metadata only: registration still closes its FDs.
        self._sdl_placement = None
        self._sdl_traces = []  # Diagnostic snapshots only; never transaction authority.

    def _sdl_bus_connection(self):
        address = os.environ.get("DBUS_SESSION_BUS_ADDRESS", "")
        if os.geteuid() == 0 or not address.startswith("unix:") or ";" in address:
            raise dbus.DBusException("Existing local user bus required",
                                     name="org.freedesktop.DBus.Error.AccessDenied")
        return self.connection

    @staticmethod
    def _sdl_error(name):
        return dbus.DBusException("SDL registration request rejected", name=name)

    @staticmethod
    def _sdl_discard_credentials(credentials):
        # Late asynchronous replies still own their transferred descriptor.
        received = credentials.get("ProcessFD")
        if received is not None:
            try:
                os.close(received.take())
            except Exception:
                pass

    def _sdl_response(self, request_id):
        result = self._rdp_report(request_id)
        answer = {k: result[k] for k in ("state", "request_id", "managed_id", "window_uuid") if k in result}
        answer.update(protocol=1, placement="not_requested", remote_session="unverified")
        c = self._rdp_registration
        if c and c.get("profile") is not None:
            answer.update(profile=c["profile"], bounds=deepcopy(c["bounds"]))
        if result["state"] != "pending":
            detail = result.get("detail", "")
            reasons = (("registered", "registered"), ("Competing", "competing_uuid"),
                       ("expired", "expired"), ("cancelled", "cancelled"),
                       ("caller", "caller_lost"), ("child identity", "child_identity_rejected"),
                       ("cleanup", "cleanup_failed"), ("budget", "budget_exhausted"),
                       ("source", "source_lost"), ("history", "history_incomplete"),
                       ("revision gap", "history_incomplete"), ("marker", "marker_lost"),
                       ("marked viewer", "marker_lost"), ("absent", "viewer_lost"),
                       ("client exited", "child_identity_rejected"),
                       ("registry", "duplicate_ownership"), ("backend", "backend_unverified"))
            answer["reason"] = next((code for text, code in reasons if text in detail), "evidence_rejected")
        return answer

    @staticmethod
    def _sdl_owner_alive(c):
        try:
            return c["owner_identity"].alive() and c["owner_bus"].get_is_connected()
        except Exception:
            return False

    def _sdl_authorize(self, request_id, sender):
        if not isinstance(sender, str) or not sender.startswith(":"):
            raise self._sdl_error("org.freedesktop.DBus.Error.AccessDenied")
        c = self._rdp_registration
        if not c or "owner_name" not in c:
            raise self._sdl_error(IFACE + ".UnknownRequest")
        # Authorize BEFORE polling, cancellation, expiry or child/FD inspection.
        if sender != c["owner_name"]:
            raise self._sdl_error("org.freedesktop.DBus.Error.AccessDenied")
        if request_id != c["id"]:
            raise self._sdl_error(IFACE + ".UnknownRequest")
        return c

    @dbus.service.method(IFACE, in_signature="s", out_signature="s",
                         sender_keyword="sender", async_callbacks=("reply", "error"))
    def BeginSdlRegistration(self, payload, sender=None, reply=None, error=None):
        """Authenticate one persistent launcher asynchronously, then arm intent."""
        from joetoo_kwin_rdp_launch import settings, expected_backend, CallerIdentity, boot_ticks, executable_identity
        started = time.monotonic()
        def reject(name):
            error(self._sdl_error(name))
        try:
            if not isinstance(sender, str) or not sender.startswith(":"):
                return reject("org.freedesktop.DBus.Error.AccessDenied")
            if len(payload.encode("utf-8")) > 8192:
                raise ValueError("message size")
            def unique(pairs):
                result = {}
                for key, value in pairs:
                    if key in result:
                        raise ValueError("duplicate key")
                    result[key] = value
                return result
            def invalid_constant(value):
                raise ValueError("nonfinite number")
            data = json.loads(payload, object_pairs_hook=unique, parse_constant=invalid_constant)
            if (not isinstance(data, dict) or set(data) not in ({"protocol", "desktop", "slot", "bounds"},
                                                       {"protocol", "desktop", "slot", "bounds", "profile"})
                    or type(data["protocol"]) is not int or data["protocol"] != 1
                    or any(type(data[k]) is not int or not 1 <= data[k] <= 256 for k in ("desktop", "slot"))
                    or not isinstance(data["bounds"], dict)):
                raise ValueError("schema")
            profile = data.get("profile")
            if "profile" in data and profile is None:
                raise ValueError("null profile")
            expected_backend(profile)
            limits = settings(data["bounds"], profile)
            if set(data["bounds"]) - set(limits):
                raise ValueError("unknown bounds")
            bus = self._sdl_bus_connection()
        except dbus.DBusException as exc:
            return error(exc)
        except Exception:
            return reject(IFACE + ".BadArguments")
        if self._sdl_pending_auth is not None:
            return reject(IFACE + ".Busy")
        job = dict(deadline=started + limits["rdp_registration_timeout_ms"] / 1000,
                   floor=boot_ticks(), timer=None, match=None)
        self._sdl_pending_auth = job
        def release():
            timer, job["timer"] = job["timer"], None
            match, job["match"] = job["match"], None
            if self._sdl_pending_auth is job:
                self._sdl_pending_auth = None
            okay = True
            for resource, action in ((timer, GLib.source_remove), (match, lambda m: m.remove())):
                if resource is not None:
                    try:
                        action(resource)
                    except Exception:
                        okay = False
            return okay
        def failed(name):
            if self._sdl_pending_auth is job:
                release()
                reject(name)
        def lost(name, old, new):
            if str(name) == sender and not new:
                failed("org.freedesktop.DBus.Error.AccessDenied")
        def watch():
            if self._sdl_pending_auth is not job:
                return GLib.SOURCE_REMOVE
            if not bus.get_is_connected():
                failed("org.freedesktop.DBus.Error.AccessDenied")
                return GLib.SOURCE_REMOVE
            if time.monotonic() >= job["deadline"]:
                failed("org.freedesktop.DBus.Error.Timeout")
                return GLib.SOURCE_REMOVE
            return True
        def authenticated(credentials):
            if self._sdl_pending_auth is not job:
                self._sdl_discard_credentials(credentials)
                return
            owner = None
            try:
                owner = CallerIdentity(credentials)
                if time.monotonic() >= job["deadline"]:
                    owner.close()
                    return failed("org.freedesktop.DBus.Error.Timeout")
                if not bus.get_is_connected():
                    raise PermissionError("Caller bus disconnected")
                executable = executable_identity()
                spec = self._begin_rdp_registration(data["desktop"], data["slot"], limits, profile=profile)
                c = self._rdp_registration
                c.update(owner_name=sender, owner_identity=owner, owner_bus=bus, owner_match=job["match"],
                         boot_floor=job["floor"], executable=executable, deadline=job["deadline"])
                job["match"] = None
                # No bus lookup on every poll: pinned sender + live ProcessFD.
                def owner_lost(name, old, new):
                    if str(name) == sender and not new and self._rdp_registration is c:
                        self._rdp_finish(c, "failed", "RDP caller lost")
                # Replace the authentication-phase handler with the transaction
                # handler in the same non-reentrant event-loop callback.
                c["owner_match"].remove()
                c["owner_match"] = bus.add_signal_receiver(owner_lost, signal_name="NameOwnerChanged",
                    dbus_interface="org.freedesktop.DBus", bus_name="org.freedesktop.DBus",
                    path="/org/freedesktop/DBus", arg0=sender)
                if not release():
                    self._rdp_finish(c, "failed", "RDP cleanup failed")
                result = self._sdl_response(spec["request_id"])
                result.update(title_marker=spec["title_marker"], bounds=spec["bounds"])
                reply(json.dumps(result, sort_keys=True))
            except Exception as exc:
                if owner is not None:
                    owner.close()
                c = self._rdp_registration
                if c and c.get("owner_identity") is owner and c["state"] == "PENDING":
                    self._rdp_finish(c, "failed", "RDP caller evidence rejected")
                failed("org.freedesktop.DBus.Error.NotSupported" if isinstance(exc, NotImplementedError)
                       else "org.freedesktop.DBus.Error.AccessDenied" if isinstance(exc, PermissionError)
                       else IFACE + ".Busy" if isinstance(exc, RegistryError) else IFACE + ".InvalidRequest")
        try:
            job["timer"] = GLib.timeout_add(limits["rdp_registration_poll_ms"], watch)
            if not job["timer"]:
                raise RuntimeError("watchdog")
            job["match"] = bus.add_signal_receiver(lost, signal_name="NameOwnerChanged",
                dbus_interface="org.freedesktop.DBus", bus_name="org.freedesktop.DBus",
                path="/org/freedesktop/DBus", arg0=sender)
            proxy = bus.get_object("org.freedesktop.DBus", "/org/freedesktop/DBus", introspect=False)
            remaining = job["deadline"] - time.monotonic()
            if remaining <= 0:
                return failed("org.freedesktop.DBus.Error.Timeout")
            dbus.Interface(proxy, "org.freedesktop.DBus").GetConnectionCredentials(sender,
                reply_handler=authenticated,
                error_handler=lambda exc: failed("org.freedesktop.DBus.Error.AccessDenied"),
                timeout=remaining)
        except Exception:
            failed("org.freedesktop.DBus.Error.NotSupported")

    @dbus.service.method(IFACE, in_signature="sih", out_signature="s", sender_keyword="sender")
    def BindSdlRegistration(self, request_id, pid, log_fd, sender=None):
        from joetoo_kwin_rdp_launch import ChildIdentity, BackendEvidence
        descriptor = None
        child = reader = None
        c = None
        try:
            c = self._sdl_authorize(request_id, sender)
            if c["state"] != "PENDING" or c["pid"] is not None:
                raise self._sdl_error(IFACE + ".InvalidRequest")
            if not self._rdp_guard(c):
                return json.dumps(self._sdl_response(request_id), sort_keys=True)
            descriptor = log_fd.take()
            if isinstance(pid, bool):
                raise ValueError("Invalid child PID")
            options = dict(profile=c["profile"], bounds=c["bounds"]) if c.get("profile") else {}
            child = ChildIdentity(c["owner_identity"], int(pid), descriptor, c["boot_floor"],
                                  c["executable"], c["bounds"]["rdp_backend_log_byte_limit"], **options)
            with os.fdopen(os.dup(descriptor), "rb") as stream:
                reader = BackendEvidence(child, stream, c["bounds"], **(dict(profile=c["profile"]) if c.get("profile") else {}))
            self._bind_rdp_process(request_id, child, reader)
            child = reader = None  # The core now owns their descriptor cleanup.
            return json.dumps(self._sdl_response(request_id), sort_keys=True)
        except dbus.DBusException:
            raise
        except Exception:
            if c is not None and c["state"] == "PENDING":
                self._rdp_finish(c, "failed", "RDP child identity rejected")
                return json.dumps(self._sdl_response(request_id), sort_keys=True)
            raise self._sdl_error(IFACE + ".BadArguments") from None
        finally:
            for item in (reader, child):
                if item is not None:
                    item.close()
            if descriptor is None:
                # Even unauthorized/repeated calls must release received FDs.
                try:
                    descriptor = log_fd.take()
                except Exception:
                    pass
            if descriptor is not None:
                os.close(descriptor)

    @dbus.service.method(IFACE, in_signature="s", out_signature="s", sender_keyword="sender")
    def PollSdlRegistration(self, request_id, sender=None):
        self._sdl_authorize(request_id, sender)
        self._poll_rdp_registration(request_id)
        return json.dumps(self._sdl_response(request_id), sort_keys=True)

    @dbus.service.method(IFACE, in_signature="s", out_signature="s", sender_keyword="sender")
    def CancelSdlRegistration(self, request_id, sender=None):
        self._sdl_authorize(request_id, sender)
        self._cancel_rdp_registration(request_id)
        return json.dumps(self._sdl_response(request_id), sort_keys=True)

    def _begin_rdp_registration(self, desktop, slot, bounds, profile=None):
        """Arm an explicit native SDL intent; NEVER arm placement.

        Public transport, production recipe/security policy and native invocation
        are separate approval gates. Only an in-process launch orchestrator can
        currently use these methods. Registry serialization is shared with the
        existing managed paths, but their selectors/placement stay unchanged.
        """
        from joetoo_kwin_rdp_launch import settings, expected_backend, APPLICATION
        limits = settings(bounds, profile)
        if self._sdl_placement and (not self._sdl_placement.get("terminal") or self._sdl_placement.get("cleanup_uncertain")):
            raise RegistryError("SDL placement is active")
        backend = expected_backend(profile)
        # OpenRC can inherit a login-TTY label even for the running Plasma X11
        # session. Select only by the explicit profile; independently require
        # the bound child's actual SDL backend, never this environment hint.
        if any(type(v) is not int or not 1 <= v <= 256 for v in (desktop, slot)):
            raise RegistryError("Invalid RDP desktop/slot")
        if not callable(getattr(GLib, "timeout_add", None)):
            raise RegistryError("RDP watchdog unavailable")
        if self._initial_layout_active() or (self.request and self.request["state"] in
                                             ("PENDING", "RUNNING", "VERIFYING")):
            raise RegistryError("Placement is still active")
        self._expire_managed_correlation()
        if (self._managed_correlation and
                (self._managed_correlation["state"] == "PENDING" or
                 self._managed_correlation.get("observer_cleanup_uncertain"))):
            raise RegistryError("Managed launch is still active")
        if self.correlation and self.correlation["state"] == "PENDING" and time.monotonic() < self.correlation["deadline"]:
            raise RegistryError("Diagnostic correlation is still active")
        for record in self.registry.managed_windows.values():
            if record.recipe.get("desktop") == desktop and record.recipe.get("slot") == slot:
                raise RegistryError("Managed desktop/slot conflict")
        identifier = uuid.uuid4().hex
        marker = "joetoo-rdp-" + secrets.token_hex(32)
        c = self._new_correlation(identifier, APPLICATION, marker)
        c.update(bounds=limits, profile=profile, expected_backend=backend, revision=self.observation_revision, windows={},
                 events=0, process=None, reader=None, backend=None, timer=None)
        c["deadline"] = time.monotonic() + limits["rdp_registration_timeout_ms"] / 1000
        self.registry.begin_launch(identifier, source=c["source"],
            synchronized=self.observation_synced, baseline=c["baseline"],
            recipe={"desktop": desktop, "slot": slot, "program": "sdl-freerdp",
                    "mode": "development-registration-only", "target": ""})
        self._rdp_registration = c
        def watch():
            if self._rdp_registration is not c or c["state"] != "PENDING":
                return GLib.SOURCE_REMOVE
            self._poll_rdp_registration(identifier)
            return c["state"] == "PENDING"
        try:
            c["timer"] = GLib.timeout_add(limits["rdp_registration_poll_ms"], watch)
            if not c["timer"]:
                raise RuntimeError("watchdog setup failed")
        except Exception:
            self._rdp_finish(c, "failed", "RDP watchdog setup failed")
            raise RegistryError("RDP watchdog setup failed") from None
        return {"request_id": identifier, "title_marker": marker, "bounds": deepcopy(limits)}

    def _bind_rdp_process(self, request_id, process, reader):
        """Actual owned child handle, not a caller-supplied UUID/backend claim.

        reader is the private BackendEvidence adapter for that child's log.
        Its read_backend() must establish SDL's actual native video driver.
        Neither this broker nor the reader owns termination of the application.
        """
        c = self._rdp_registration
        if not c or c["id"] != request_id or c["state"] != "PENDING" or c["pid"] is not None:
            raise RegistryError("Inactive RDP launch")
        if time.monotonic() >= c["deadline"]:
            self._rdp_finish(c, "timeout", "RDP registration expired")
            raise RegistryError("RDP registration expired")
        if reader.pid != process.pid:
            raise RegistryError("RDP backend reader PID mismatch")
        self.registry.mark_running(request_id, process.pid)
        c.update(pid=process.pid, process=process, reader=reader)
        self._rdp_recheck_x11()

    def _rdp_cleanup(self, c):
        """Bounded, idempotent callback/reader release, without signalling viewers."""
        timer, c["timer"] = c["timer"], None
        reader, c["reader"] = c["reader"], None
        okay = True
        try:
            if timer is not None:
                GLib.source_remove(timer)
        except Exception:
            okay = False
        try:
            if reader is not None:
                reader.close()
        except Exception:
            okay = False
        for resource in (c.get("process"), c.get("owner_identity"), c.get("owner_match")):
            try:
                if callable(getattr(resource, "close", None)):
                    resource.close()
                elif callable(getattr(resource, "remove", None)):
                    resource.remove()
            except Exception:
                okay = False
        c["process"] = None
        c["owner_match"] = None
        return okay

    def _rdp_finish(self, c, state, detail, identifier=None):
        if c["state"] != "PENDING":
            return
        if state == "registered" and c.get("owner_identity") is not None and not self._sdl_owner_alive(c):
            state, detail = "failed", "RDP caller lost"
        provenance = None
        if state == "registered" and c.get("owner_identity") is not None:
            child, owner = c["process"], c["owner_identity"]
            provenance = dict(pid=child.pid, start=child.start, executable=child.executable,
                log_inode=child.log_inode, owner_name=c["owner_name"], owner_pid=owner.pid,
                owner_start=owner.start, source=c["source"], revision=self.observation_revision,
                marker=c["title_token"], profile=c.get("profile"), bounds=deepcopy(c["bounds"]),
                invalid=False, actions=set())
        if not self._rdp_cleanup(c):
            state, detail = "failed", "RDP evidence cleanup failed"
        answer = {"state": state, "request_id": c["id"], "detail": detail,
                  "placement": "not_requested", "remote_session": "unverified"}
        if state == "registered":
            try:
                record = self.registry.register_match(c["id"],
                    dict(state="MATCHED", request_id=c["id"], evidence="pid",
                         candidate_history_complete=True, pid=c["pid"], window_uuid=identifier),
                    current_windows=self.observed_windows, source=self.observation_source,
                    synchronized=self.observation_synced)
                answer.update(managed_id=record.managed_id, window_uuid=record.window_uuid)
                if provenance is not None:
                    provenance.update(managed_id=record.managed_id, uuid=record.window_uuid,
                                      registration_id=record.request_id)
                    self._sdl_registered[record.managed_id] = provenance
            except RegistryError:
                state, detail = "failed", "RDP registry rejected ownership"
                answer.update(state=state, detail=detail)
        if state != "registered":
            self.registry.finish_failed(c["id"], state, detail)
        c["state"] = state
        c["result"] = answer
        # Only one bounded terminal result remains; late events cannot revive it.
        c["windows"].clear()

    def _cancel_rdp_registration(self, request_id):
        c = self._rdp_registration
        if c and c["id"] == request_id:
            self._rdp_finish(c, "failed", "RDP launch cancelled")
        return self._rdp_report(request_id)

    def _rdp_report(self, request_id):
        c = self._rdp_registration
        if not c or c["id"] != request_id:
            return {"state": "unknown"}
        return deepcopy(c["result"] or {"state": "pending", "request_id": request_id,
                                        "placement": "not_requested"})

    def _rdp_guard(self, c):
        if c.get("owner_identity") is not None and not self._sdl_owner_alive(c):
            self._rdp_finish(c, "failed", "RDP caller lost")
        elif not self.observation_synced or c["source"] != self.observation_source:
            self._rdp_finish(c, "failed", "RDP observation source lost")
        elif self.observation_evicted_through > c["event_floor"]:
            self._rdp_finish(c, "failed", "RDP lifecycle history incomplete")
        elif time.monotonic() >= c["deadline"]:
            self._rdp_finish(c, "timeout", "RDP registration expired")
        return c["state"] == "PENDING"

    def _rdp_capture(self, c, event, details):
        """Observe each accepted caption transition BEFORE generic coalescing.

        Store all new UUID births until the bounded transaction ends, even before
        PID binding; a vanished/renamed marker must not disappear between polls.
        Normal-window qualification comes from the existing resident contract.
        """
        identifier = details["uuid"]
        if identifier in c["baseline"]:
            return
        entry = c["windows"].get(identifier)
        if entry is None:
            if len(c["windows"]) >= c["bounds"]["rdp_registration_window_limit"]:
                self._rdp_finish(c, "failed", "RDP window budget exhausted")
                return
            entry = c["windows"][identifier] = {
                "added": event == "added", "birth": deepcopy(details),
                "latest": deepcopy(details), "marked": False, "removed": False,
                "identity_changed": False, "first_qualified_at": None}
        elif event == "added" or (c["expected_backend"] == "x11" and entry["removed"]):
            self._rdp_finish(c, "failed", "RDP duplicate window lifecycle")
            return
        if (details["pid"] != entry["birth"]["pid"] or
                details["resource_class"].casefold() != entry["birth"]["resource_class"].casefold()):
            entry["identity_changed"] = True
        entry["latest"] = deepcopy(details)
        marker = c["title_token"]
        if entry["marked"] and (details["caption"] != marker or
                                (event == "removed" and c["expected_backend"] != "x11")):
            self._rdp_finish(c, "failed", "RDP marked viewer lost or changed")
            return
        if marker in details["caption"]:
            if details["caption"] != marker:
                self._rdp_finish(c, "failed", "RDP marker is not exact")
                return
            entry["marked"] = True
        entry["removed"] = event == "removed"
        if c["expected_backend"] == "x11" and sum(
                e["marked"] and not e["removed"] for e in c["windows"].values()) > 1:
            self._rdp_finish(c, "ambiguous", "Competing RDP viewer UUIDs")

    def _rdp_observation(self, event=None, details=None):
        self._sdl_trace_observation(event, details)
        self._sdl_track_registered(event, details)
        c = self._rdp_registration
        if not c or c["state"] != "PENDING" or not self._rdp_guard(c):
            return
        # Missing revisions can hide a transient marked competitor, including a
        # changed caption which the general observation cache would coalesce.
        if self.observation_revision != c["revision"] + 1:
            self._rdp_finish(c, "failed", "RDP observation revision gap")
            return
        c["revision"] = self.observation_revision
        c["events"] += 1
        if c["events"] > c["bounds"]["rdp_registration_event_limit"]:
            self._rdp_finish(c, "failed", "RDP event budget exhausted")
            return
        if details is not None:
            self._rdp_capture(c, event, details)
        else:
            # Inventory refresh is not creation evidence. Check retained births
            # against its live state, without fabricating added/removed records.
            for identifier, entry in list(c["windows"].items()):
                if entry["marked"] and identifier not in self.observed_windows and not (
                        c["expected_backend"] == "x11" and entry["removed"]):
                    self._rdp_finish(c, "failed", "RDP viewer absent from inventory")
                    return
            for window in self.observed_windows.values():
                if c["state"] != "PENDING":
                    break
                self._rdp_capture(c, "existing", window)

    def _rdp_recheck_x11(self):
        """Event-driven qualification after cache/history updates, without a second timer."""
        c = self._rdp_registration
        if c and c["state"] == "PENDING" and c.get("expected_backend") == "x11":
            self._poll_rdp_registration(c["id"])

    def _poll_rdp_x11(self, c):
        # Backend proof may arrive after a predecessor's observed removal. Keep
        # and validate every marked tombstone; disappearance never erases birth.
        # Survival is a legacy heuristic: a 600 ms predecessor can qualify at
        # 500 ms. The terminal registry result must never follow its replacement.
        live_candidates = []
        for identifier, entry in c["windows"].items():
            if not entry["marked"]:
                continue
            retained = any(e["event"] == "added" and e["window_uuid"] == identifier
                           and e["event_id"] > c["event_floor"] for e in self.observation_events)
            if (not entry["added"] or not retained or entry["identity_changed"] or
                    any(w["pid"] != c["pid"] or w["resource_class"].casefold() != c["expected_class"]
                        for w in (entry["birth"], entry["latest"]))):
                self._rdp_finish(c, "failed", "RDP viewer ownership history mismatch")
                return self._rdp_report(c["id"])
            if entry["removed"]:
                continue
            live = self.observed_windows.get(identifier)
            if (live is None or live["pid"] != c["pid"] or
                    live["resource_class"].casefold() != c["expected_class"] or live["caption"] != c["title_token"]):
                self._rdp_finish(c, "failed", "RDP live viewer ownership mismatch")
                return self._rdp_report(c["id"])
            live_candidates.append((identifier, entry))
        if len(live_candidates) > 1:
            self._rdp_finish(c, "ambiguous", "Competing RDP viewer UUIDs")
        elif live_candidates and c["backend"] == "x11":
            identifier, entry = live_candidates[0]
            try:
                alive = c["process"].poll() is None
            except Exception:
                alive = False
            if not alive or not self._rdp_guard(c):
                if c["state"] == "PENDING":
                    self._rdp_finish(c, "failed", "RDP client exited before registration")
                return self._rdp_report(c["id"])
            now = time.monotonic()
            if entry["first_qualified_at"] is None:
                entry["first_qualified_at"] = now
            if now >= entry["first_qualified_at"] + c["bounds"]["rdp_x11_identity_settle_ms"] / 1000:
                # Poll is pidfd/start/parent/executable/FD/environment validation
                # on the public path. Recheck it after evidence reads and dwell.
                try:
                    alive = c["process"].poll() is None
                except Exception:
                    alive = False
                if alive and self._rdp_guard(c):
                    self._rdp_finish(c, "registered", "RDP viewer registered; remote state unverified", identifier)
                elif c["state"] == "PENDING":
                    self._rdp_finish(c, "failed", "RDP client exited before registration")
        return self._rdp_report(c["id"])

    def _poll_rdp_registration(self, request_id):
        c = self._rdp_registration
        if not c or c["id"] != request_id or c["state"] != "PENDING":
            return self._rdp_report(request_id)
        if not self._rdp_guard(c) or c["pid"] is None:
            return self._rdp_report(request_id)
        try:
            alive = c["process"].poll() is None
        except Exception:
            alive = False
        if not alive:
            self._rdp_finish(c, "failed", "RDP client exited before registration")
            return self._rdp_report(request_id)
        try:
            c["backend"] = c["reader"].read_backend()
        except Exception:
            self._rdp_finish(c, "failed", "RDP backend evidence unavailable")
            return self._rdp_report(request_id)
        if c["backend"] not in (None, c["expected_backend"]):
            self._rdp_finish(c, "failed", "RDP native-Wayland backend required" if c["expected_backend"] == "wayland"
                             else "RDP native-X11 backend required")
            return self._rdp_report(request_id)
        if c["expected_backend"] == "x11":
            return self._poll_rdp_x11(c)
        marked = [(identifier, entry) for identifier, entry in c["windows"].items() if entry["marked"]]
        if len(marked) > 1:
            self._rdp_finish(c, "ambiguous", "Competing RDP viewer UUIDs")
        elif marked:
            identifier, entry = marked[0]
            live = self.observed_windows.get(identifier)
            added_retained = any(e["event"] == "added" and e["window_uuid"] == identifier
                                 and e["event_id"] > c["event_floor"] for e in self.observation_events)
            if (not entry["added"] or not added_retained or entry["removed"] or
                    entry["identity_changed"] or live is None or
                    any(w["pid"] != c["pid"] or w["resource_class"].casefold() != c["expected_class"]
                        for w in (entry["birth"], entry["latest"], live)) or
                    live["caption"] != c["title_token"]):
                self._rdp_finish(c, "failed", "RDP viewer ownership evidence mismatch")
            elif c["backend"] == "wayland":
                # Recheck the child after reading backend evidence; exit during
                # that read cannot authorize ownership of a leftover surface.
                try:
                    alive = c["process"].poll() is None
                except Exception:
                    alive = False
                if alive:
                    self._rdp_finish(c, "registered", "RDP viewer registered; remote state unverified", identifier)
                else:
                    self._rdp_finish(c, "failed", "RDP client exited before registration")
        return self._rdp_report(request_id)

    def _sdl_trace(self, trace, stage, **fields):
        """Bounded sanitized receipt-time diagnostics; never change an outcome."""
        if not trace:
            return
        try:
            key = (stage, fields.get("phase"), fields.get("result"), fields.get("guard"),
                   fields.get("sender_matches"), fields.get("after_terminal"))
            if stage != "post_observation" and key in trace["seen"]:
                return
            if trace["count"] >= trace["limit"] and stage != "terminal":
                if trace.get("limited"):
                    return
                trace["limited"] = True
                stage, fields = "trace_limit", {}
            trace["seen"].add(key)
            trace["count"] += 1
            row = dict(stage=stage, request_id=trace["id"], window_uuid=trace["uuid"],
                       receipt_elapsed_ms=max(0, int((time.monotonic() - trace["started"]) * 1000)))
            row.update(fields)
            print("joetoo-kwind: SDL placement diagnostic " + json.dumps(row, sort_keys=True),
                  file=sys.stderr, flush=True)
        except Exception:
            pass  # Diagnostic sink failure must not change placement or cleanup.

    def _sdl_trace_frame(self, trace, window):
        """Copy only bounded numerical frame/membership data, never captions."""
        try:
            geometry = window["geometry"]
            frame = {k: geometry[k] for k in ("x", "y", "width", "height")}
            if any(type(v) not in (int, float) or not math.isfinite(v) or abs(v) > 32768 for v in frame.values()):
                return {"frame_available": False}
            desktops = window["desktops"]
            if len(desktops) > 256 or any(type(d) is not int or not 1 <= d <= 256 for d in desktops):
                return {"frame_available": False}
            return dict(frame_available=True, geometry=frame, desktops=list(desktops),
                on_all_desktops=bool(window["on_all_desktops"]),
                geometry_match=frame == trace["target"],
                position_match=all(frame[k] == trace["target"][k] for k in ("x", "y")),
                size_match=all(frame[k] == trace["target"][k] for k in ("width", "height")),
                desktop_match=desktops == [trace["desktop"]] and not window["on_all_desktops"])
        except Exception:
            return {"frame_available": False}

    def _sdl_trace_phase(self, c):
        r = self.request
        return r["state"] if r and r["id"] == c["id"] else "UNARMED"

    def _sdl_trace_observation(self, event, details):
        # Passive use of accepted existing observations. No timer, subscription,
        # movement, transaction revival or ownership transfer is introduced.
        now = time.monotonic()
        for trace in self._sdl_traces:
            if not trace.get("ended") or now >= trace["post_until"] or trace["post_count"] >= trace["post_limit"]:
                continue
            if not self.observation_synced or self.observation_source != trace["source"]:
                self._sdl_trace(trace, "post_source_changed")
                trace["post_until"] = now
                continue
            window = details if details and details["uuid"] == trace["uuid"] else None
            if details is not None and window is None:
                continue
            if details is None:
                window = self.observed_windows.get(trace["uuid"])
            frame = self._sdl_trace_frame(trace, window)
            present = window is not None and event != "removed"
            signature = (json.dumps(frame, sort_keys=True), present)
            if signature == trace.get("last_frame"):
                continue
            trace["last_frame"] = signature
            trace["post_count"] += 1
            self._sdl_trace(trace, "post_observation", present=present, after_terminal=True, causality="unproven", **frame)
            if trace["post_count"] == trace["post_limit"]:
                self._sdl_trace(trace, "post_observation_limit")

    def _sdl_track_registered(self, event, details):
        """Retain identity continuity using existing observations, without new observers."""
        for meta in self._sdl_registered.values():
            if meta["invalid"] or meta["revision"] == self.observation_revision:
                continue
            if (not self.observation_synced or self.observation_source != meta["source"]
                    or self.observation_revision != meta["revision"] + 1):
                meta["invalid"] = True
            meta["revision"] = self.observation_revision
            windows = [details] if details is not None else list(self.observed_windows.values())
            if details is None and meta["uuid"] not in self.observed_windows:
                meta["invalid"] = True
            for w in windows:
                if w["uuid"] == meta["uuid"]:
                    if (event in ("added", "removed") or w["pid"] != meta["pid"] or
                            w["resource_class"].casefold() != "com.freerdp.client.sdl3" or w["caption"] != meta["marker"]):
                        meta["invalid"] = True
                elif w["pid"] == meta["pid"] and w["caption"] == meta["marker"]:
                    meta["invalid"] = True

    def _sdl_placement_record(self, meta):
        record = self.registry.get_window(meta["managed_id"])
        launch = self.registry.requests.get(meta["registration_id"])
        w = self.observed_windows.get(meta["uuid"])
        if (meta["invalid"] or not self.observation_synced or self.observation_source != meta["source"]
                or not record or record.presence != "present" or record.window_uuid != meta["uuid"]
                or record.request_id != meta["registration_id"] or not launch or launch.state != "succeeded"
                or launch.result != record.managed_id or not w or w["pid"] != meta["pid"]
                or w["resource_class"].casefold() != "com.freerdp.client.sdl3" or w["caption"] != meta["marker"]):
            raise ValueError("SDL placement ownership unavailable")
        return record

    def _sdl_placement_valid(self, c):
        c["guard_failed"] = True
        try:
            c["diagnostic_stage"] = "guard_record"
            self._sdl_placement_record(c["meta"])
            # Validate live placement ownership and process continuity.
            # Fixed diagnostic stages contain no private identity data.
            # Mechanical deadline enforcement belongs to the shared request.
            # Option C: timeouts now belong to the shared request. Retained
            # process handles protect continuity without reconstructing them.
            for stage, check in (
                    ("guard_operator", lambda: c["operator"].alive()),
                    ("guard_kwin", lambda: c["kwin_identity"].alive()),
                    ("guard_child", lambda: c["child"].poll() is None),
                    ("guard_bus", lambda: c["bus"].get_is_connected())):
                c["diagnostic_stage"] = stage
                if not check():
                    # ChildIdentity.poll already checks its pinned caller. Do
                    # not repeat that read on every successful advancement.
                    if stage == "guard_child" and not c["launch_owner"].alive():
                        c["diagnostic_stage"] = "guard_launcher"
                    return False
            c["guard_failed"] = False
            return True
        except Exception:
            return False

    def _sdl_placement_finish(self, c, state, reason):
        if c.get("terminal"):
            return
        r = self.request
        trace = c.get("trace")
        phase = self._sdl_trace_phase(c)
        if trace:
            # Preserve the preceding phase and guard before generic ERROR wins.
            self._sdl_trace(trace, "terminal_begin", phase=phase, guard=c.get("diagnostic_stage", "unknown"),
                deadline_expired=time.monotonic() >= c["deadline"], requested_outcome=state,
                guard_failed=bool(c.get("guard_failed")),
                source_match=self.observation_synced and self.observation_source == trace["source"],
                identity_continuity=not c["meta"]["invalid"],
                **self._sdl_trace_frame(trace, self.observed_windows.get(trace["uuid"])))
        if r and r.get("id") == c["id"]:
            if state != "succeeded":
                r.update(state="ERROR", detail=reason)
            self._sync_managed_placement()
        okay = True
        for key in ("timer", "match", "child", "operator", "launch_owner", "kwin_identity"):
            obj = c.pop(key, None)
            if obj is None:
                continue
            try:
                if key == "timer": GLib.source_remove(obj)
                elif key == "match": obj.remove()
                else: obj.close()
            except Exception:
                okay = False
                c.setdefault("unreleased", []).append((key, obj))
        if not okay:
            c["cleanup_uncertain"] = True
            state, reason = "failed", "Placement cleanup incomplete"
            if r and r.get("id") == c["id"]:
                r.update(state="ERROR", detail=reason)
        record = self.registry.get_window(c["meta"]["managed_id"])
        if record and record.placement == "pending":
            if state == "succeeded" and (not r or r["state"] != "OK" or record.presence != "present"):
                state, reason = "failed", "Placement was not verified"
            self.registry.set_placement(record.window_uuid, "succeeded" if state == "succeeded" else "failed")
        c["terminal"] = dict(protocol=1, request_id=c["id"], managed_id=c["meta"]["managed_id"],
            window_uuid=c["meta"]["uuid"], registration="registered", remote_session="unverified",
            placement=state, reason=reason)
        if trace:
            trace["ended"] = True
            trace["post_until"] = time.monotonic() + trace["post_ms"] / 1000
            trace["retain_until"] = trace["post_until"]
            self._sdl_trace(trace, "terminal", phase=phase, outcome=state,
                guard=c.get("diagnostic_stage", "unknown"), deadline_expired=time.monotonic() >= c["deadline"],
                guard_failed=bool(c.get("guard_failed")),
                cleanup_uncertain=bool(c.get("cleanup_uncertain")),
                **self._sdl_trace_frame(trace, self.observed_windows.get(trace["uuid"])))
        callback = c.pop("reply", None)
        if callback:
            callback(json.dumps(c["terminal"], sort_keys=True))

    def _sdl_finalize_placement(self):
        """Project a shared terminal state through cleanup, without another guard/clock."""
        c = self._sdl_placement
        if not c or c.get("terminal"):
            return False
        r = self.request
        if r and r.get("id") == c["id"] and r["state"] in ("OK", "ERROR"):
            self._sdl_placement_finish(c, "succeeded" if r["state"] == "OK" else "failed", "verified" if r["state"] == "OK" else r.get("placement_error", r["detail"]))
            return False
        return True

    @dbus.service.method(IFACE, in_signature="s", out_signature="s", sender_keyword="sender",
                         async_callbacks=("reply", "error"))
    def SubmitSdlPlacement(self, payload, sender=None, reply=None, error=None):
        """Authenticate a separate same-user operator; never accept a raw UUID."""
        from joetoo_kwin_rdp_launch import CallerIdentity, ChildIdentity, _inode
        try:
            def unique(pairs):
                result = {}
                for k, v in pairs:
                    if k in result: raise ValueError("duplicate field")
                    result[k] = v
                return result
            if not isinstance(payload, str) or len(payload) > 8192: raise ValueError("size")
            data = json.loads(payload, object_pairs_hook=unique)
            keys = {"protocol", "confirmed", "managed_id", "action_id", "source", "revision",
                    "desktop", "slot", "x", "y", "width", "height", "timeout_ms"}
            if (set(data) != keys or type(data["protocol"]) is not int or data["protocol"] != 1
                    or data["confirmed"] is not True or not isinstance(sender, str) or not sender.startswith(":")):
                raise ValueError("schema")
            if not isinstance(data["managed_id"], str) or not re.fullmatch(r"win-[0-9]+", data["managed_id"]):
                raise ValueError("managed ID required")
            if not isinstance(data["action_id"], str) or not re.fullmatch(r"[0-9a-f]{32}", data["action_id"]):
                raise ValueError("action ID required")
            for k in ("revision", "desktop", "slot", "x", "y", "width", "height", "timeout_ms"):
                if type(data[k]) is not int: raise ValueError("integer required")
            if not (1 <= data["desktop"] <= 256 and 1 <= data["slot"] <= 256 and
                    -32768 <= data["x"] <= 32768 and -32768 <= data["y"] <= 32768 and
                    1 <= data["width"] <= 32768 and 1 <= data["height"] <= 32768): raise ValueError("geometry")
            limits = viewer_settings({"vnc_placement_timeout_ms": data["timeout_ms"]})
            meta = self._sdl_registered[data["managed_id"]]
            record = self._sdl_placement_record(meta)
            if (data["source"] != self.observation_source or data["revision"] != self.observation_revision
                    or (data["desktop"], data["slot"]) != (record.recipe.get("desktop"), record.recipe.get("slot"))
                    or data["action_id"] in meta["actions"] or len(meta["actions"]) >= self.registry._completed_limit):
                raise ValueError("stale action or destination")
            if (self._sdl_placement and (not self._sdl_placement.get("terminal") or self._sdl_placement.get("cleanup_uncertain")) or self._sdl_pending_auth
                    or self.registry._active_request_id or self._initial_layout_active()
                    or self.request and self.request["state"] in ("PENDING", "RUNNING", "VERIFYING")):
                raise RegistryError("Placement busy")
            for other in self.registry.managed_windows.values():
                if other.managed_id != record.managed_id and (other.recipe.get("desktop"), other.recipe.get("slot")) == (data["desktop"], data["slot"]):
                    raise ValueError("slot conflict")
            bus = self._sdl_bus_connection()
        except Exception as exc:
            return error(self._sdl_error(IFACE + (".Busy" if isinstance(exc, RegistryError) else ".InvalidRequest")))
        c = dict(id=uuid.uuid4().hex, meta=meta, sender=sender, bus=bus, reply=reply,
                 deadline=time.monotonic() + limits["vnc_placement_timeout_ms"] / 1000, terminal=None)
        self._sdl_placement = c
        for previous in self._sdl_traces:
            if previous["uuid"] == meta["uuid"] and previous.get("ended"):
                self._sdl_trace(previous, "post_superseded")
                previous["post_until"] = time.monotonic()
        trace = dict(id=c["id"], uuid=meta["uuid"], source=meta["source"], started=time.monotonic(),
            target={k: data[k] for k in ("x", "y", "width", "height")}, desktop=data["desktop"],
            count=0, limit=meta["bounds"]["rdp_registration_event_limit"], seen=set(), ended=False,
            post_count=0, post_limit=meta["bounds"]["rdp_registration_window_limit"],
            post_ms=meta["bounds"]["rdp_registration_timeout_ms"], post_until=0, retain_until=0)
        c["trace"] = trace
        self._sdl_traces = [t for t in self._sdl_traces if not t.get("ended") or time.monotonic() < t["retain_until"]]
        self._sdl_traces.append(trace)
        self._sdl_traces = self._sdl_traces[-self.registry._completed_limit:]
        meta["actions"].add(data["action_id"])
        def fail(*args, stage=None, reason="Placement authentication/source unavailable"):
            if self._sdl_placement is c and not c.get("terminal"):
                # One fixed stage label per failed attempt, using the daemon's
                # existing stderr convention. Never log exception arguments,
                # credentials, process metadata, request IDs or evidence text.
                if stage is not None:
                    c["diagnostic_stage"] = stage
                try:
                    print("joetoo-kwind: SDL placement preflight failed stage=" +
                          c["diagnostic_stage"], file=sys.stderr, flush=True)
                except Exception:
                    pass  # An unavailable diagnostic sink cannot bypass cleanup.
                self._sdl_placement_finish(c, "failed", reason)
        def remaining():
            value = c["deadline"] - time.monotonic()
            if value <= 0 or c.get("terminal"): raise ValueError("expired")
            return value
        def received(credentials, key, continuation):
            if c.get("terminal"):
                self._sdl_discard_credentials(credentials)
                return
            try:
                c["diagnostic_stage"] = key + "_credentials_verify"
                c[key] = CallerIdentity(credentials)
                c["diagnostic_stage"] = key + "_continuation"
                continuation()
            except Exception:
                fail()
        def credentials(name, key, continuation):
            try:
                c["diagnostic_stage"] = key + "_credentials_request"
                daemon.GetConnectionCredentials(name, reply_handler=lambda value: received(value, key, continuation),
                    error_handler=lambda *unused: fail(stage=key + "_credentials_reply"), timeout=remaining())
            except Exception: fail()
        def arm():
            fd = None
            try:
                c["diagnostic_stage"] = "record_recheck"
                self._sdl_placement_record(meta)
                c["diagnostic_stage"] = "revision_recheck"
                if self.observation_revision != data["revision"]: raise ValueError("owner/source changed")
                c["diagnostic_stage"] = "launcher_pid_recheck"
                if c["launch_owner"].pid != meta["owner_pid"]: raise ValueError("owner/source changed")
                c["diagnostic_stage"] = "launcher_start_recheck"
                if c["launch_owner"].start != meta["owner_start"]: raise ValueError("owner/source changed")
                # Nonblocking open cannot wait on a substituted pipe; verify the
                # owned regular inode before constructing the existing validator.
                c["diagnostic_stage"] = "stdout_open"
                fd = os.open('/proc/' + str(meta["pid"]) + '/fd/1', os.O_RDONLY | os.O_NONBLOCK)
                c["diagnostic_stage"] = "stdout_stat"
                if not stat.S_ISREG(os.fstat(fd).st_mode): raise ValueError("stdout replaced")
                c["diagnostic_stage"] = "stdout_inode"
                if _inode('/proc/' + str(meta["pid"]) + '/fd/1') != meta["log_inode"]:
                    raise ValueError("stdout replaced")
                # ChildIdentity validates start/executable/parent/stdout; the
                # following equality binds its snapshot to registration.
                c["diagnostic_stage"] = "child_identity"
                c["child"] = ChildIdentity(c["launch_owner"], meta["pid"], fd, meta["start"],
                    meta["executable"], meta["bounds"]["rdp_backend_log_byte_limit"],
                    profile=meta["profile"], bounds=meta["bounds"])
                c["diagnostic_stage"] = "child_snapshot"
                if c["child"].start != meta["start"] or c["child"].log_inode != meta["log_inode"]:
                    raise ValueError("child replaced")
                c["diagnostic_stage"] = "deadline_recheck"
                remaining()
                if not self._sdl_placement_valid(c): raise ValueError("placement authority lost")
                trace["kwin_name"] = c["kwin_name"]
                self._sdl_trace(trace, "operator_authenticated", phase="UNARMED")
                self._sdl_trace(trace, "initial_frame", **self._sdl_trace_frame(trace, self.observed_windows.get(meta["uuid"])))
                c["arming"] = True
                c["diagnostic_stage"] = "submit"
                self._submit("sdl", *(data[k] for k in ("desktop", "x", "y", "width", "height")))
                c["diagnostic_stage"] = "request_bind"
                self.request.update(id=c["id"], placement_uuid=meta["uuid"], move_source=meta["source"],
                    registration_request_id=meta["registration_id"], placement_deadline=c["deadline"], preserve_desktop=False,
                    preserve_position=False, preserve_size=False)
                c["diagnostic_stage"] = "registry_pending"
                self.registry.set_placement(meta["uuid"], "pending")
                c.pop("arming", None)
                self._sdl_trace(trace, "armed", phase=self.request["state"])
                c["diagnostic_stage"] = "reply"
                cb = c.pop("reply")
                cb(json.dumps(dict(protocol=1, request_id=c["id"], managed_id=meta["managed_id"],
                    window_uuid=meta["uuid"], registration="registered", placement="pending", remote_session="unverified")))
            except Exception: fail()
            finally:
                c.pop("arming", None)
                if fd is not None: os.close(fd)
        def kwin_owner(name):
            if c.get("terminal"): return
            if not str(name).startswith(":"): return fail(stage="kwin_owner_name")
            c["kwin_name"] = str(name)
            credentials(str(name), "kwin_identity", arm)
        def original():
            try:
                c["diagnostic_stage"] = "kwin_owner_request"
                daemon.GetNameOwner("org.kde.KWin", reply_handler=kwin_owner,
                    error_handler=lambda *unused: fail(stage="kwin_owner_reply"), timeout=remaining())
            except Exception: fail()
        def lost(name, old, new):
            if str(name) in (sender, meta["owner_name"], "org.kde.KWin") and old and old != new:
                fail(stage="owner_changed", reason="Placement bus owner changed")
        try:
            c["diagnostic_stage"] = "bus_proxy"
            daemon = dbus.Interface(bus.get_object("org.freedesktop.DBus", "/org/freedesktop/DBus", introspect=False), "org.freedesktop.DBus")
            c["diagnostic_stage"] = "owner_watch"
            c["match"] = bus.add_signal_receiver(lost, signal_name="NameOwnerChanged",
                dbus_interface="org.freedesktop.DBus", bus_name="org.freedesktop.DBus", path="/org/freedesktop/DBus")
            def tick():
                if c.get("terminal"): return GLib.SOURCE_REMOVE
                if not c.get("child"):
                    if time.monotonic() >= c["deadline"]:
                        fail(stage="auth_deadline", reason="Placement authentication deadline expired")
                    return not bool(c.get("terminal"))
                self._advance_placement()
                return not bool(c.get("terminal"))
            c["diagnostic_stage"] = "watchdog_setup"
            c["timer"] = GLib.timeout_add(meta["bounds"]["rdp_registration_poll_ms"], tick)
            if not c["timer"]: raise ValueError("timer")
            credentials(sender, "operator", lambda: credentials(meta["owner_name"], "launch_owner", original))
        except Exception: fail()

    def _sdl_placement_authorize(self, request_id, sender):
        c = self._sdl_placement
        if not c or sender != c["sender"]:
            raise self._sdl_error("org.freedesktop.DBus.Error.AccessDenied")
        if request_id != c["id"]:
            raise self._sdl_error(IFACE + ".UnknownRequest")
        return c

    @dbus.service.method(IFACE, in_signature="s", out_signature="s", sender_keyword="sender")
    def TakeSdlPlacement(self, source, sender=None):
        c = self._sdl_placement
        trace = c.get("trace") if c else None
        self._sdl_trace(trace, "take_received", phase=self._sdl_trace_phase(c) if c else "UNARMED")
        try:
            answer = self._take_sdl_placement(source, sender)
        except Exception:
            self._sdl_trace(trace, "take_rejected")
            raise
        self._sdl_trace(trace, "take_accepted" if answer else "take_rejected", phase=self._sdl_trace_phase(c) if c else "UNARMED")
        return answer

    def _take_sdl_placement(self, source, sender=None):
        c, r = self._sdl_placement, self.request
        if not c or sender != c.get("kwin_name"):
            raise self._sdl_error("org.freedesktop.DBus.Error.AccessDenied")
        self._advance_placement()
        if (c.get("terminal") or not r or r["id"] != c["id"] or r["state"] != "PENDING"):
            return ""
        if source != c["meta"]["source"]:
            self._sdl_placement_finish(c, "failed", "Placement claim rejected")
            return ""
        r["state"] = "RUNNING"
        out = {k: r[k] for k in ("id", "desktop", "x", "y", "width", "height",
            "preserve_desktop", "preserve_position", "preserve_size")}
        out.update(source=source, window_uuid=c["meta"]["uuid"], pid=c["meta"]["pid"],
                   resource_class="com.freerdp.client.sdl3", title_marker=c["meta"]["marker"],
                   remaining_ms=max(0, int((c["deadline"] - time.monotonic()) * 1000)), sdl_diagnostic=1)
        return json.dumps(out)

    @dbus.service.method(IFACE, in_signature="s", out_signature="s", sender_keyword="sender")
    def PollSdlPlacement(self, request_id, sender=None):
        c = self._sdl_placement_authorize(request_id, sender)
        if not c.get("terminal"):
            self._advance_placement()
        return json.dumps(c.get("terminal") or dict(protocol=1, request_id=c["id"],
            managed_id=c["meta"]["managed_id"], window_uuid=c["meta"]["uuid"],
            registration="registered", placement="pending", remote_session="unverified"), sort_keys=True)

    @dbus.service.method(IFACE, in_signature="s", out_signature="s", sender_keyword="sender")
    def CancelSdlPlacement(self, request_id, sender=None):
        c = self._sdl_placement_authorize(request_id, sender)
        self._sdl_placement_finish(c, "failed", "Operator cancelled placement")
        return json.dumps(c["terminal"], sort_keys=True)

    def _submit(self, kind, desktop, x, y, width, height, app_class=""):
        pending = self._sdl_placement
        if pending and (not pending.get("terminal") or pending.get("cleanup_uncertain")) and not pending.get("arming"):
            raise dbus.DBusException("SDL placement is active", name=IFACE + ".Busy")
        self._expire_managed_correlation()
        if (self._managed_correlation and self._managed_correlation.get("viewer")
                and (self._managed_correlation["state"] == "PENDING" or self._managed_correlation.get("observer_cleanup_uncertain"))):
            raise dbus.DBusException("Viewer readiness or cleanup is pending", name=IFACE + ".Busy")
        if self._initial_layout_active():
            raise dbus.DBusException("Initial layout is still active", name=IFACE + ".Busy")
        # Shared implementation for Submit (move) and SubmitLaunch (launch).
        # `_submit` is an internal Python method, not an exported D-Bus name.
        # In-flight verification is still a placement request: never allow a
        # second request to overwrite the UUID before it settles or times out.
        self._advance_placement()
        if (self.request is not None
                and self.request["state"] in ("PENDING", "RUNNING", "VERIFYING")
                # monotonic() is an elapsed-time clock, not wall-clock time.
                # Only a recent pending/running request blocks another one.
                and time.monotonic() - self.request["created"] < 20):
            raise dbus.DBusException("Previous request has not completed",
                                     name=IFACE + ".Busy")

        # Enforce the broker's current bounds before accepting a request.
        # The Bash CLI also validates input, but direct D-Bus clients can
        # bypass it, so the broker must perform its own checks.
        if not (1 <= desktop <= 256 and
                -32768 <= x <= 32768 and -32768 <= y <= 32768 and
                1 <= width <= 32768 and 1 <= height <= 32768):
            raise dbus.DBusException("Desktop, position, or size out of range",
                                     name=IFACE + ".BadArguments")

        if kind == "launch" and not (0 < len(app_class) <= 128):
            raise dbus.DBusException("Expected application class is required",
                                     name=IFACE + ".BadArguments")

        # Save one in-memory request as a Python dictionary (key/value map).
        # uuid4().hex is a random *transaction* ID, NOT a KWin window UUID.
        # PENDING -> RUNNING -> OK/ERROR is the request state transition.
        self.request = {
            "id": uuid.uuid4().hex,
            "kind": kind,
            "desktop": int(desktop),
            "x": int(x), "y": int(y),
            "width": int(width), "height": int(height),
            "app_class": str(app_class),
            "state": "PENDING", "detail": "",
            "created": time.monotonic(),
        }
        return self.request["id"]

    def _take(self, kind):
        # The KWin JS "Take" callback claims a pending request of this kind.
        # `r` is another reference to the current request dictionary; changing
        # r["state"] also changes self.request["state"].
        r = self.request
        if r is None or r["state"] != "PENDING" or r["kind"] != kind:
            return ""
        r["state"] = "RUNNING"
        # Dictionary comprehension: copy only the selected fields into a
        # smaller dictionary, then encode it as JSON text for the JS callback.
        # Launch class and internal timestamps are not part of this payload.
        return json.dumps({k: r[k] for k in
                           ("id", "desktop", "x", "y", "width", "height")})

    # A decorator (@...) exports the next Python method on this D-Bus
    # interface. A D-Bus signature describes argument/result wire types:
    # "i" = signed 32-bit integer, "s" = string, "" = no arguments/result.
    # The methods below are the six public calls used by Bash and KWin JS.
    @dbus.service.method(IFACE, in_signature="iiiii", out_signature="s")
    def Submit(self, desktop, x, y, width, height):
        # CLI arms a move and receives the request ID as a string.
        return self._submit("move", desktop, x, y, width, height)

    @dbus.service.method(IFACE, in_signature="iiiiibbb", out_signature="s")
    def SubmitMove(self, desktop, x, y, width, height,
                   preserve_desktop, preserve_position, preserve_size):
        """Additive move intent; legacy Submit/launch validation stays unchanged."""
        if not self.observation_synced or self.move_protocol != 1:
            raise dbus.DBusException("Resident lacks optional-move protocol 1",
                                     name=IFACE + ".Unsupported")
        flags = (preserve_desktop, preserve_position, preserve_size)
        # dbus.Boolean is integer-like; accept only the boolean wire domain.
        if any(value not in (False, True) for value in flags):
            raise dbus.DBusException("Invalid preservation flags", name=IFACE + ".BadArguments")
        pd, pp, ps = map(bool, flags)
        if ((pd and desktop != 0) or (pp and (x != 0 or y != 0))
                or (ps and (width != 0 or height != 0))):
            raise dbus.DBusException("Preserved fields require zero placeholders",
                                     name=IFACE + ".BadArguments")
        rid = self._submit("move_optional", 1 if pd else desktop,
                           0 if pp else x, 0 if pp else y,
                           1 if ps else width, 1 if ps else height)
        self.request.update(desktop=int(desktop), x=int(x), y=int(y),
                            width=int(width), height=int(height),
                            preserve_desktop=pd, preserve_position=pp, preserve_size=ps,
                            move_source=self.observation_source)
        return rid

    @dbus.service.method(IFACE, in_signature="ss", out_signature="s")
    def TakeMove(self, source, window_uuid):
        """Bind to the window captured by the new shortcut; old Take cannot claim it."""
        r = self.request
        if r is None or r["kind"] != "move_optional" or r["state"] != "PENDING":
            return ""
        try:
            identifier = str(uuid.UUID(window_uuid))
        except (ValueError, TypeError, AttributeError):
            identifier = None
        if (source != r["move_source"] or source != self.observation_source
                or not self.observation_synced or identifier not in self.observed_windows
                or time.monotonic() >= r["created"] + 15):
            r.update(state="ERROR", detail="Optional move target/source missing or request stale")
            return ""
        r.update(state="RUNNING", placement_uuid=identifier)
        payload = {key: r[key] for key in (
            "id", "desktop", "x", "y", "width", "height", "preserve_desktop",
            "preserve_position", "preserve_size")}
        payload["remaining_ms"] = max(0, int((r["created"] + 15 - time.monotonic()) * 1000))
        return json.dumps(payload)

    @staticmethod
    def _move_snapshot(value):
        """Bound resolved frame/membership values before installing expectations."""
        geometry = value["geometry"]
        for key in ("x", "y", "width", "height"):
            number = geometry[key]
            if (isinstance(number, bool) or not isinstance(number, (int, float))
                    or number > 32768
                    or number < (-32768 if key in ("x", "y") else 1)
                    or not math.isfinite(number)):
                raise ValueError("invalid resolved geometry")
        desktops = value["desktops"]
        sticky = value["on_all_desktops"]
        if (not isinstance(sticky, bool) or not isinstance(desktops, list)
                or len(desktops) > 256 or (not sticky and not desktops)
                or any(type(d) is not int or not 1 <= d <= 256 for d in desktops)
                or len(set(desktops)) != len(desktops)):
            raise ValueError("invalid resolved desktop membership")
        return {"geometry": {key: geometry[key] for key in ("x", "y", "width", "height")},
                "desktops": sorted(desktops), "on_all_desktops": sticky}

    def _resolve_move(self, r, payload, identifier):
        # The resident resolves live values at application time. It may fill only
        # omitted fields, never replace explicit intent or the captured UUID.
        if (identifier != r["placement_uuid"] or payload["source"] != r["move_source"]
                or self.observation_source != r["move_source"]
                or time.monotonic() >= r.get("placement_deadline", r["created"] + 15)):
            raise ValueError("stale or mismatched move resolution")
        before = self._move_snapshot(payload["captured"])
        resolved = self._move_snapshot(payload["resolved"])
        expected = dict(before["geometry"])
        for key in ("x", "y", "width", "height"):
            preserve = r["preserve_position"] if key in ("x", "y") else r["preserve_size"]
            if not preserve:
                expected[key] = r[key]
        desktops = before["desktops"] if r["preserve_desktop"] else [r["desktop"]]
        sticky = before["on_all_desktops"] if r["preserve_desktop"] else False
        if resolved != {"geometry": expected, "desktops": desktops, "on_all_desktops": sticky}:
            raise ValueError("resolution changed explicit intent or preserved values")
        return expected, desktops, sticky

    @dbus.service.method(IFACE, in_signature="", out_signature="s")
    def Take(self):
        # Resident JS obtains the queued move request as JSON text.
        return self._take("move")

    @dbus.service.method(IFACE, in_signature="siiiii", out_signature="s")
    def SubmitLaunch(self, app_class, desktop, x, y, width, height):
        # CLI arms a class-qualified launch *before* starting the application.
        return self._submit("launch", desktop, x, y, width, height, app_class)

    @dbus.service.method(IFACE, in_signature="ss", out_signature="s")
    def TakeLaunch(self, resource_class, desktop_file):
        # KWin calls this after windowAdded. Only the first matching pending
        # launch is eligible; no persistent window identity is recorded here.
        r = self.request
        if (r is None or r["state"] != "PENDING" or r["kind"] != "launch"
                or not matches_class(r["app_class"], resource_class, desktop_file)):
            return ""
        return self._take("launch")

    def _sync_managed_placement(self):
        """Cross-check target UUID and record placement without granting ownership.

        Registration and placement can complete in either order. A successful
        placement on a different UUID must NEVER be attributed to the managed
        window, even when both have the same application class or PID.
        """
        r = self.request
        if r is None or not r.get("registration_request_id"):
            return
        launch = self.registry.requests.get(r["registration_request_id"])
        if launch is None or launch.state != "succeeded":
            return
        managed = self.registry.get_window(launch.result)
        if managed is None:
            return
        if managed.placement == "not_requested":
            if managed.presence != "present":
                return
            self.registry.set_placement(managed.window_uuid, "pending")
            managed = self.registry.get_window(managed.window_uuid)
        target = r.get("placement_uuid")
        if target is not None and target != managed.window_uuid:
            r["state"] = "ERROR"
            r["detail"] = "placement UUID differs from positively registered UUID"
        if r["kind"] == "sdl":
            return  # SDL commits placement state only after bounded FD/watch cleanup.
        if managed.placement != "pending":
            return
        if (r["state"] == "OK" and target == managed.window_uuid
                and managed.presence == "present"):
            self.registry.set_placement(managed.window_uuid, "succeeded")
        elif r["state"] == "ERROR":
            self.registry.set_placement(managed.window_uuid, "failed")

    def _advance_placement(self, removed_uuid=None):
        """Resolve VERIFYING from exact-UUID KWin observations or deadline.

        KWin's resident already emits changed/removed events on geometry and
        desktop changes. No arbitrary sleeps or JS timer API are needed.
        """
        r = self.request
        if r and r["kind"] == "sdl":
            c = self._sdl_placement
            # The adapter owns authorization/resources, not a second state
            # machine. A terminal request cannot be revived by observations.
            if r["state"] in ("OK", "ERROR"):
                if c and c["id"] == r["id"] and not c.get("terminal"):
                    self._sdl_finalize_placement()
                return
            if c and c.get("terminal"):
                return
            if not c or c["id"] != r["id"]:
                r.update(state="ERROR", detail="Placement authorization unavailable")
                return
            self._sdl_track_registered(None, None)
            if not self._sdl_placement_valid(c):
                stage = c.get("diagnostic_stage")
                if not self.observation_synced or self.observation_source != c["meta"]["source"]:
                    reason = "Placement observation source lost"
                else:
                    reason = {"guard_record": "Placement registered identity/history lost",
                              "guard_operator": "Placement operator lost",
                              "guard_launcher": "Placement launcher lost",
                              "guard_kwin": "Placement KWin owner lost",
                              "guard_child": "Placement child identity lost",
                              "guard_bus": "Placement bus disconnected"}.get(stage, "Placement identity lost")
                self._sdl_placement_finish(c, "failed", reason)
                return
            elif r["state"] in ("PENDING", "RUNNING", "VERIFYING") and time.monotonic() >= r["placement_deadline"]:
                phase = r["state"]
                c["diagnostic_stage"] = "placement_deadline"
                reason = {"PENDING": "Placement claim deadline expired",
                          "RUNNING": "Placement completion deadline expired",
                          "VERIFYING": "Placement geometry confirmation timed out"}[phase]
                # Preserve the preceding phase for the bounded diagnostic.
                self._sdl_placement_finish(c, "failed", reason)
                return
        if (r and r["kind"] == "viewer" and r["state"] in ("RUNNING", "VERIFYING")
                and time.monotonic() >= r["viewer_placement_deadline"]):
            r.update(state="ERROR", detail="Verified viewer placement deadline expired")
            self._sync_managed_placement()
        if r is None or r["state"] != "VERIFYING":
            return
        identifier = r["placement_uuid"]
        if r["observation_source"] != self.observation_source:
            r["state"] = "ERROR"
            r["detail"] = "resident observation source changed during placement"
        elif removed_uuid == identifier:
            r["state"] = "ERROR"
            r["detail"] = "target window disappeared during placement"
        else:
            observed = self.observed_windows.get(identifier)
            if observed is not None:
                geo = observed["geometry"]
                desired = all(geo[key] == r[key]
                              for key in ("x", "y", "width", "height"))
                desktop_ok = (observed["desktops"] == [r["desktop"]]
                              and not observed["on_all_desktops"])
                if r["kind"] in ("move_optional", "sdl"):
                    desktop_ok = (sorted(observed["desktops"]) == r["expected_desktops"]
                                  and observed["on_all_desktops"] == r["expected_sticky"])
                if desired and desktop_ok:
                    r["state"] = "OK"
                    # Optional moves report verified membership, not the zero
                    # request placeholder. Keep legacy Submit's format intact.
                    after = f'[{r["desktop"]}]'
                    if r["kind"] in ("move_optional", "sdl"):
                        after = ('[all desktops]' if observed["on_all_desktops"] else
                                 '[' + ','.join(map(str, sorted(observed["desktops"]))) + ']')
                    r["detail"] = (f'{r["kind"]}: {observed["caption"]} '
                                   f'(pid={observed["pid"]}) '
                                   f'before={r["placement_before"]} '
                                   f'after={after} '
                                   f'({geo["x"]},{geo["y"]}) '
                                   f'{geo["width"]}x{geo["height"]} '
                                   f'tiled={str(r["placement_tiled"]).lower()} '
                                   f'fullscreen={str(r["placement_fullscreen"]).lower()}')
            if (r["state"] == "VERIFYING" and
                    time.monotonic() >= r.get("placement_deadline", r["created"] + 15.0)):
                observed = self.observed_windows.get(identifier)
                actual = "window not observed"
                if observed is not None:
                    actual = (f'desktops={observed["desktops"]} '
                              f'geometry={observed["geometry"]}')
                r["state"] = "ERROR"
                r["detail"] = "placement confirmation timed out: " + actual
        if r["state"] in ("OK", "ERROR"):
            self._sync_managed_placement()
            if r["kind"] == "sdl":
                self._sdl_finalize_placement()

    @dbus.service.method(IFACE, in_signature="sss", out_signature="", sender_keyword="sender")
    def Complete(self, request_id, result, detail, sender=None):
        trace = next((t for t in reversed(self._sdl_traces) if t["id"] == request_id), None)
        kind = result if result in ("VERIFY", "ERROR", "OK") else "INVALID"
        c = self._sdl_placement
        trusted = bool(trace and trace.get("kwin_name") and sender == trace["kwin_name"])
        self._sdl_trace(trace, "complete_received", result=kind, phase=self._sdl_trace_phase(c) if c and c["id"] == request_id else "RETAINED", sender_matches=trusted, after_terminal=bool(trace and trace["ended"]))
        # Only bounded, fixed resident stage names are logged. Keep the actual
        # original VERIFY/ERROR detail byte-for-byte for the existing handler.
        if trace and trusted and isinstance(detail, str) and len(detail) <= 8192:
            try:
                wrapped = json.loads(detail)
                if (isinstance(wrapped, dict) and set(wrapped) == {"sdl_diagnostic", "detail"}
                        and isinstance(wrapped["detail"], str)):
                    detail = wrapped["detail"]
                    stages = wrapped["sdl_diagnostic"]
                    allowed = {"uuid_selected", "uuid_rejected", "callback_rejected", "assignment_attempt", "assignment_returned"}
                    if trusted and isinstance(stages, list) and len(stages) <= len(allowed) and all(type(v) is str and v in allowed for v in stages):
                        for stage in stages:
                            self._sdl_trace(trace, "resident_" + stage, after_terminal=bool(trace and trace["ended"]))
            except (ValueError, TypeError):
                pass
        before = trace.get("accepted", 0) if trace else 0
        try:
            answer = self._complete_placement(request_id, result, detail, sender)
        except Exception:
            self._sdl_trace(trace, "complete_rejected", result=kind)
            raise
        if trace and trace.get("accepted", 0) == before:
            self._sdl_trace(trace, "complete_rejected", result=kind)
        return answer

    def _complete_placement(self, request_id, result, detail, sender=None):
        """KWin reports accepted assignment; broker confirms observed state.

        Preserve existing OK/ERROR messages for legacy callers and tests.
        VERIFY is an additive result, with an exact KWin UUID and diagnostics.
        """
        r = self.request
        if r and r["kind"] == "sdl" and r["id"] == request_id:
            c = self._sdl_placement
            if not c or sender != c.get("kwin_name"):
                raise self._sdl_error("org.freedesktop.DBus.Error.AccessDenied")
            self._advance_placement()
            if c.get("terminal"):
                return
            if result == "OK":
                raise self._sdl_error(IFACE + ".BadArguments")
        if r is None or r["id"] != request_id or r["state"] != "RUNNING":
            raise dbus.DBusException("Unknown or inactive request",
                                     name=IFACE + ".InvalidRequest")
        if r["kind"] == "viewer" and (not self.observation_synced or
                self.observation_source != r.get("viewer_source")):
            r.update(state="ERROR", detail="Viewer placement source replaced")
            self._sync_managed_placement()
            return
        if r["kind"] == "viewer" and result == "OK":
            raise dbus.DBusException("Viewer placement requires exact UUID verification", name=IFACE + ".BadArguments")
        if r["kind"] == "move_optional" and result == "OK":
            raise dbus.DBusException("Optional moves require UUID verification", name=IFACE + ".BadArguments")
        if result not in ("OK", "ERROR", "VERIFY"):
            raise dbus.DBusException("Invalid completion result",
                                     name=IFACE + ".BadArguments")
        if result == "VERIFY":
            try:
                payload = json.loads(detail)
                identifier = str(uuid.UUID(payload["window_uuid"]))
                if r["kind"] == "sdl" and identifier != r["placement_uuid"]:
                    raise ValueError("SDL placement UUID mismatch")
                if r["kind"] == "viewer" and identifier != r.get("viewer_uuid"):
                    raise ValueError("viewer placement UUID mismatch")
                before = payload["before"]
                if (not isinstance(before, str) or len(before) > 256
                        or not isinstance(payload["tiled"], bool)
                        or not isinstance(payload["fullscreen"], bool)):
                    raise ValueError("invalid placement detail")
                if r["kind"] in ("move_optional", "sdl"):
                    resolved_geometry, resolved_desktops, resolved_sticky = self._resolve_move(r, payload, identifier)
            except (KeyError, TypeError, ValueError, AttributeError) as exc:
                raise dbus.DBusException("Invalid placement verification",
                                         name=IFACE + ".BadArguments") from exc
            if not self.observation_synced:
                r["state"] = "ERROR"
                r["detail"] = "KWin observation is not synchronized"
            else:
                if r["kind"] in ("move_optional", "sdl"):
                    r.update(resolved_geometry)
                    r["expected_desktops"] = resolved_desktops
                    r["expected_sticky"] = resolved_sticky
                r["state"] = "VERIFYING"
                if r["kind"] == "sdl":
                    trace = self._sdl_placement.get("trace")
                    if trace:
                        trace["accepted"] = trace.get("accepted", 0) + 1
                    self._sdl_trace(trace, "complete_accepted", result="VERIFY")
                    self._sdl_trace(trace, "verifying_entered", phase="VERIFYING")
                r["placement_uuid"] = identifier
                r["placement_before"] = before
                r["placement_tiled"] = payload["tiled"]
                r["placement_fullscreen"] = payload["fullscreen"]
                r["observation_source"] = self.observation_source
                self._advance_placement()
        else:
            r["state"] = result
            r["detail"] = str(detail)[:1024]
            if r["kind"] == "sdl":
                r["placement_error"] = "Placement resident reported ERROR"
                trace = self._sdl_placement.get("trace")
                if trace:
                    trace["accepted"] = trace.get("accepted", 0) + 1
                self._sdl_trace(trace, "complete_accepted", result=result)
        self._sync_managed_placement()
        if r["kind"] == "sdl":
            self._sdl_finalize_placement()

    @dbus.service.method(IFACE, in_signature="s", out_signature="s")
    def Status(self, request_id):
        self._advance_placement()
        r = self.request
        if r is None or r["id"] != request_id:
            return "UNKNOWN"
        return r["state"] + (" " + r["detail"] if r["detail"] else "")

    # Step 1.4d: a launch-intent interface, NOT an arbitrary registration API.
    # The broker alone creates registration records, after exact PID/UUID
    # correlation; clients cannot provide a window UUID or managed ID.
    @dbus.service.method(IFACE, in_signature="siiiiii", out_signature="s")
    def SubmitManagedLaunch(self, app_class, desktop, slot, x, y, width, height):
        """Atomically arm placement and broker-owned managed correlation."""
        if not isinstance(slot, int) or isinstance(slot, bool) or not 1 <= slot <= 256:
            raise dbus.DBusException("Invalid launch slot", name=IFACE + ".BadArguments")
        # Original launch association is independent of observed geometry and
        # desktop membership. Missing/uncertain entries retain their reservation
        # until an explicit future reconciliation policy releases ownership.
        for record in self.registry.managed_windows.values():
            if (record.recipe.get("desktop") == desktop
                    and record.recipe.get("slot") == slot):
                raise dbus.DBusException(
                    f"Managed desktop/slot already associated with {record.managed_id} "
                    f"(presence={record.presence})", name=IFACE + ".SlotConflict")
        previous_request = self.request
        placement_id = self._submit("launch", desktop, x, y, width, height, app_class)
        try:
            registration_id = self._begin_managed_launch(
                expected_class=app_class,
                recipe={"desktop": int(desktop), "slot": int(slot),
                        "program": str(app_class), "mode": "local", "target": ""})
        except RegistryError as exc:
            # Both arms must succeed or neither may remain active. Since D-Bus
            # dispatch is single-threaded here, no resident event can consume
            # the newly created placement request before this method returns.
            self.request = previous_request
            raise dbus.DBusException(str(exc), name=IFACE + ".InvalidRequest") from exc
        self.request["registration_request_id"] = registration_id
        return json.dumps({"placement_request_id": placement_id,
                           "registration_request_id": registration_id}, sort_keys=True)

    @dbus.service.method(IFACE, in_signature="si", out_signature="")
    def SetManagedLaunchPid(self, request_id, pid):
        """Supply the freshly spawned child's PID; never choose a KWin UUID."""
        if not isinstance(pid, int) or isinstance(pid, bool) or pid <= 0:
            raise dbus.DBusException("Invalid launch PID", name=IFACE + ".BadArguments")
        try:
            self._set_managed_launch_pid(request_id, pid)
        except RegistryError as exc:
            raise dbus.DBusException(str(exc), name=IFACE + ".InvalidRequest") from exc

    @dbus.service.method(IFACE, in_signature="s", out_signature="s")
    def PollManagedLaunch(self, request_id):
        """Report privately verified registration; caller supplies no UUID."""
        return json.dumps(self._poll_managed_launch(request_id), sort_keys=True)


    def _initial_layout_active(self):
        r = self.initial_layout
        if r is None or r["state"] not in ("PENDING", "RUNNING"):
            return False
        if (time.monotonic() >= r["deadline"] or not self.observation_synced
                or r["source"] != self.observation_source
                or any(item["uuid"] not in self.observed_windows
                       or (record := self.registry.get_window(item["uuid"])) is None
                       or record.presence != "present"
                       for item in r["entries"])):
            r.update(state="FAILED", detail="Initial layout expired or cohort/source disappeared")
            return False
        return True

    @dbus.service.method(IFACE, in_signature="s", out_signature="s")
    def SubmitInitialLayout(self, payload):
        """Freeze broker-owned registrations, never accept launcher-selected UUIDs."""
        self._advance_placement()
        self._expire_managed_correlation()
        if ((self._sdl_placement and (not self._sdl_placement.get("terminal") or self._sdl_placement.get("cleanup_uncertain")))
                or self._initial_layout_active() or
                (self.request and self.request["state"] in ("PENDING", "RUNNING", "VERIFYING")) or
                any(r.state in ("pending", "running") for r in self.registry.requests.values()) or
                (self.correlation and self.correlation["state"] == "PENDING"
                 and time.monotonic() < self.correlation["deadline"])):
            raise dbus.DBusException("Another transaction is active", name=IFACE + ".Busy")
        if not self.observation_synced or self.initial_layout_protocol != 1:
            raise dbus.DBusException("Resident lacks initial-layout protocol 1", name=IFACE + ".Unsupported")
        try:
            if len(payload) > 65536:
                raise ValueError("layout payload too large")
            message = json.loads(payload)
            if (not {"entries"} <= set(message) <= {"entries", "focus_timeout_ms", "focus_poll_interval_ms", "single_raise"}
                    or not 1 <= len(message["entries"]) <= 256):
                raise ValueError("invalid cohort")
            single_raise = message.get("single_raise", False)
            if "single_raise" in message and (single_raise is not True or self.single_raise_protocol != 1):
                raise ValueError("single-window raise capability unavailable or invalid")
            if single_raise and (len(message["entries"]) != 1 or message["entries"][0].get("layer") != "over"):
                raise ValueError("single-window raise requires exactly one over registration")
            # Defaults retain old callers; new launchers convey effective user
            # configuration explicitly. Never assume daemon environment values.
            focus_timeout = message.get("focus_timeout_ms", 500)
            focus_interval = message.get("focus_poll_interval_ms", 25)
            if (type(focus_timeout) is not int or type(focus_interval) is not int
                    or not 1 <= focus_timeout <= 2000
                    or not 1 <= focus_interval <= min(250, focus_timeout)):
                raise ValueError("invalid focus observation timing")
            entries = []
            for item in message["entries"]:
                if set(item) != {"registration_request_id", "layer"} or item["layer"] not in ("under", "panel", "over"):
                    raise ValueError("invalid layer entry")
                launch = self.registry.requests[item["registration_request_id"]]
                record = self.registry.get_window(launch.result) if launch.state == "succeeded" else None
                if (record is None or record.presence != "present" or record.placement != "succeeded"
                        or launch.source != self.observation_source):
                    raise ValueError("registration not positively placed/present")
                observed = self.observed_windows[record.window_uuid]
                if observed["desktops"] != [record.recipe["desktop"]] or observed["on_all_desktops"]:
                    raise ValueError("cohort moved away from intended desktop before initialization")
                entries.append({"uuid": record.window_uuid, "layer": item["layer"],
                                "desktop": record.recipe["desktop"],
                                "geometry": dict(observed["geometry"]),
                                "desktops": list(observed["desktops"]),
                                "on_all_desktops": observed["on_all_desktops"]})
            if len({e["uuid"] for e in entries}) != len(entries) or len({e["desktop"] for e in entries}) != 1:
                raise ValueError("duplicate UUID or mixed desktop groups")
        except (ValueError, KeyError, TypeError, AttributeError, RegistryError) as exc:
            raise dbus.DBusException(str(exc), name=IFACE + ".BadArguments") from exc
        preferred = next((e["uuid"] for layer in ("over", "panel")
                          for e in reversed(entries) if e["layer"] == layer), None)
        ordered = [e["uuid"] for layer in ("under", "panel", "over") for e in entries if e["layer"] == layer]
        self.initial_layout = dict(id=uuid.uuid4().hex, state="PENDING", entries=entries,
                                   order=ordered, preferred_uuid=preferred,
                                   source=self.observation_source, deadline=time.monotonic() + 10,
                                   focus_timeout_ms=focus_timeout, focus_poll_interval_ms=focus_interval,
                                   geometry="placed", stacking="pending", focus="pending", detail="")
        if single_raise:
            self.initial_layout["single_raise"] = True
            desktop = entries[0]["desktop"]
            self.initial_layout["raise_peers"] = {
                key: deepcopy({name: value[name] for name in ("geometry", "desktops", "on_all_desktops")})
                for key, value in self.observed_windows.items() if key != entries[0]["uuid"]
                and (value["on_all_desktops"] or desktop in value["desktops"])}
        return self.initial_layout["id"]

    @dbus.service.method(IFACE, in_signature="s", out_signature="s")
    def TakeInitialLayout(self, source):
        if not self._initial_layout_active():
            return ""
        r = self.initial_layout
        if r["state"] != "PENDING" or source != r["source"]:
            return ""
        r["state"] = "RUNNING"
        return json.dumps({key: r[key] for key in ("id", "entries", "order", "preferred_uuid", "source",
                                                 "focus_timeout_ms", "focus_poll_interval_ms")} |
                          {"remaining_ms": max(0, int((r["deadline"] - time.monotonic()) * 1000))} |
                          ({"single_raise": True} if r.get("single_raise") else {}))

    @dbus.service.method(IFACE, in_signature="ss", out_signature="")
    def CompleteInitialLayout(self, request_id, payload):
        if not self._initial_layout_active() or self.initial_layout["id"] != request_id or self.initial_layout["state"] != "RUNNING":
            raise dbus.DBusException("Inactive initial layout", name=IFACE + ".InvalidRequest")
        r = self.initial_layout
        try:
            if len(payload) > 65536:
                raise ValueError("completion too large")
            result = json.loads(payload)
            if type(result.get("current_desktop")) is not int or type(result.get("focus_attempted")) is not bool:
                raise ValueError("invalid focus observation")
            if result["source"] != r["source"]:
                raise ValueError("wrong resident source")
            if (type(result.get("focus_elapsed_ms", 0)) is not int
                    or not 0 <= result.get("focus_elapsed_ms", 0) <= 10000):
                raise ValueError("invalid focus elapsed observation")
            # Completion is evidence from the resident, not permission to change
            # ownership. Geometry remains independently observed by the broker.
            # A target can disappear after the active-request check. Take one
            # guarded lookup per UUID; absence is failed evidence, not malformed
            # resident JSON or permission to adopt another window.
            observations = [(e, self.observed_windows.get(e["uuid"])) for e in r["entries"]]
            missing = next((e["uuid"] for e, observed in observations if observed is None), None)
            unchanged = all(observed is not None
                            and observed.get("geometry") == e["geometry"]
                            and observed.get("desktops") == e["desktops"]
                            and observed.get("on_all_desktops") == e["on_all_desktops"]
                            for e, observed in observations)
            stack_ok = result.get("order") == r["order"] and result.get("geometry_unchanged") is True and unchanged
            if r.get("single_raise"):
                # Resident evidence must cover the full normal-window stack on this
                # desktop, not the vacuous ordering of a one-element cohort.
                order = result.get("raise_order")
                desktop = r["entries"][0]["desktop"]
                expected = {key for key, value in self.observed_windows.items()
                            if value["on_all_desktops"] or desktop in value["desktops"]}
                peers_unchanged = all(self.observed_windows.get(key) is not None and
                    all(self.observed_windows[key][name] == value[name] for name in value)
                    for key, value in r["raise_peers"].items())
                raise_ok = (isinstance(order, list) and all(isinstance(key, str) for key in order)
                            and len(order) == len(set(order)) and set(order) == expected
                            and bool(order) and order[-1] == r["order"][0] and peers_unchanged)
                stack_ok = stack_ok and raise_ok
                if not raise_ok and not result.get("error"):
                    result["error"] = "Single-window raise or existing-peer geometry did not verify"

            visible = (r["preferred_uuid"] is not None and result.get("current_desktop") == r["entries"][0]["desktop"])
            if r["preferred_uuid"] is None:
                focus_ok = result.get("focus_attempted") is False and result.get("active_uuid") == result.get("before_active_uuid")
                focus = "no automatic target" if focus_ok else "failed"
            elif not visible:
                focus_ok = result.get("focus_attempted") is False and result.get("active_uuid") == result.get("before_active_uuid")
                focus = "preferred target retained; inactive desktop" if focus_ok else "failed"
            else:
                focus_ok = result.get("focus_attempted") is True and result.get("active_uuid") == r["preferred_uuid"]
                focus = "verified" if focus_ok else "failed"
            ok = stack_ok and focus_ok and not result.get("error")
            detail = str(result.get("error", ""))
            if not detail and not focus_ok:
                detail = ("Preferred focus did not verify: target=" + str(r["preferred_uuid"])
                          + " observed=" + str(result.get("active_uuid")))
            r.update(state="SUCCEEDED" if ok else "FAILED", geometry="unchanged" if unchanged and result.get("geometry_unchanged") is True else "changed or unverified",
                     stacking="verified" if stack_ok else "failed", focus=focus,
                     detail=("Cohort UUID [" + missing + "]: observation disappeared during completion"
                             if missing else detail)[:512], observed_active_uuid=result.get("active_uuid"),
                     focus_observation=str(result.get("focus_observation", "immediate"))[:64],
                     focus_elapsed_ms=result.get("focus_elapsed_ms"),
                     initial_active_uuid=result.get("initial_active_uuid"),
                     focus_attempted=result.get("focus_attempted"), observed_order=result.get("order", []),
                     before_active_uuid=result.get("before_active_uuid"), current_desktop=result.get("current_desktop"))
        except (ValueError, KeyError, TypeError, AttributeError) as exc:
            raise dbus.DBusException("Invalid initial-layout completion", name=IFACE + ".BadArguments") from exc

    @dbus.service.method(IFACE, in_signature="s", out_signature="s")
    def InitialLayoutStatus(self, request_id):
        self._initial_layout_active()
        r = self.initial_layout
        if r is None or r["id"] != request_id:
            return json.dumps({"state": "UNKNOWN"})
        return json.dumps({key: r.get(key) for key in ("id", "state", "geometry", "stacking", "focus", "detail",
                                                       "preferred_uuid", "observed_active_uuid", "focus_attempted", "order",
                                                       "observed_order", "before_active_uuid", "current_desktop",
                                                       "focus_observation", "focus_elapsed_ms", "initial_active_uuid",
                                                       "focus_timeout_ms", "focus_poll_interval_ms")} |
                          {"entries": [{k: e[k] for k in ("uuid", "layer", "desktop")} for e in r["entries"]]})

    # TigerVNC only: a deferred, role-qualified launch. Generic launch/correlation
    # stays unchanged; no class-qualified placement is armed during authentication.
    @dbus.service.method(IFACE, in_signature="s", out_signature="s")
    def SubmitManagedViewerLaunch(self, payload):
        observer = None
        previous = self.request
        try:
            if len(payload) > 8192:
                raise ValueError("Viewer request too large")
            data = json.loads(payload)
            bounds = viewer_settings(data)
            if not self.viewer_protocol or not self.observation_synced:
                raise ValueError("Resident cannot resolve X11/XWayland viewer identity")
            desktop, slot = data["desktop"], data["slot"]
            geometry = [data[k] for k in ("x", "y", "width", "height")]
            if any(type(v) is not int for v in [desktop, slot] + geometry) or not 1 <= slot <= 256:
                raise ValueError("Invalid viewer layout")
            for record in self.registry.managed_windows.values():
                if record.recipe.get("desktop") == desktop and record.recipe.get("slot") == slot:
                    raise ValueError("Managed desktop/slot conflict")
            placement = self._submit("launch", desktop, *geometry, "vncviewer")
            # Connect and select the root BEFORE the viewer is allowed to start.
            observer = DesktopObserver(bounds)
            registration = self._begin_managed_launch(expected_class="vncviewer",
                recipe={"desktop": desktop, "slot": slot, "program": "vncviewer", "mode": "ssh", "target": ""})
            c = self._managed_correlation
            c.update(viewer=True, observer=observer, bounds=bounds, role_xids=set(),
                     destroyed_xids=set(), claim=None, selected=None,
                     deadline=time.monotonic() + (bounds["vnc_ssh_start_timeout_ms"] + 2 * bounds["vnc_dbus_timeout_ms"]) / 1000)
            self._viewer_schedule_expiry(c)
            self.request.update(kind="viewer", state="WAIT_VIEWER", registration_request_id=registration)
            return json.dumps({"registration_request_id": registration, "placement_request_id": placement})
        except (ValueError, KeyError, TypeError, RegistryError, RuntimeError, OSError) as exc:
            if observer: observer.close()
            self.request = previous
            raise dbus.DBusException(str(exc), name=IFACE + ".InvalidRequest") from exc

    def _viewer_schedule_expiry(self, c):
        # A crashed/unpolled launcher must not leave the identity observer
        # installed indefinitely. Ordinary tests stub GLib; production uses
        # its existing broker event loop, not a new policy daemon.
        if not hasattr(GLib, "timeout_add"): return
        if c.get("expiry_timer"): GLib.source_remove(c["expiry_timer"])
        generation = object()
        c["expiry_generation"] = generation
        def expire():
            if c.get("expiry_generation") is not generation: return GLib.SOURCE_REMOVE
            c["expiry_timer"] = None
            self._viewer_observe(c)
            return GLib.SOURCE_REMOVE
        c["expiry_timer"] = GLib.timeout_add(max(1, math.ceil((c["deadline"] - time.monotonic()) * 1000)), expire)

    def _viewer_close(self, c):
        c["observer_cleanup_uncertain"] = c["observer"].close() is False
        c["expiry_generation"] = None
        if c.get("expiry_timer"):
            GLib.source_remove(c["expiry_timer"]); c["expiry_timer"] = None
        return not c["observer_cleanup_uncertain"]

    def _viewer_fail(self, c, detail, state="failed"):
        if c["state"] != "PENDING":
            return
        self.registry.finish_failed(c["id"], state, detail)
        c["state"] = "TIMEOUT" if state == "timeout" else "STALE_SOURCE"
        c["managed_result"] = {"state": state, "request_id": c["id"], "detail": detail}
        self._viewer_close(c)
        r = self.request
        if r and r.get("registration_request_id") == c["id"]:
            r.update(state="ERROR", detail=detail)

    def _viewer_observe(self, c):
        if c["state"] != "PENDING": return
        if not self.observation_synced or self.observation_source != c["source"]:
            self._viewer_fail(c, "Viewer observation source replaced"); return
        if time.monotonic() >= c["deadline"]:
            self._viewer_fail(c, "Viewer readiness timed out; authentication outcome unknown", "timeout"); return
        if self.observation_evicted_through > c["event_floor"]:
            self._viewer_fail(c, "Viewer lifecycle history incomplete"); return
        try:
            for kind, xid in c["observer"].drain(c["bounds"]["vnc_identity_event_limit"]):
                if kind == "destroyed":
                    c["destroyed_xids"].add(xid); c["role_xids"].discard(xid)
                elif xid not in c["destroyed_xids"] and xid not in c["role_xids"]:
                    c["observer"].select(xid, 1 << 17)
                    c["role_xids"].add(xid)
                if len(c["role_xids"] | c["destroyed_xids"]) > c["bounds"]["vnc_identity_event_limit"]:
                    raise RuntimeError("Viewer identity history limit exceeded")
        except (OSError, RuntimeError, ValueError):
            self._viewer_fail(c, "Viewer identity observer unavailable or incomplete")

    @dbus.service.method(IFACE, in_signature="s", out_signature="s")
    def TakeManagedViewer(self, source):
        c = self._managed_correlation
        if not c or not c.get("viewer"): return ""
        self._viewer_observe(c)
        if c["state"] != "PENDING" or source != c["source"] or c["pid"] is None or not c["role_xids"]:
            return ""
        c["claim"] = uuid.uuid4().hex
        return json.dumps({"id": c["id"], "claim": c["claim"], "source": c["source"],
                           "pid": c["pid"], "xids": sorted(c["role_xids"])})

    @dbus.service.method(IFACE, in_signature="s", out_signature="s")
    def CompleteManagedViewer(self, payload):
        c = self._managed_correlation
        if not c or not c.get("viewer"): return ""
        self._viewer_observe(c)
        try:
            if len(payload) > 65536: raise ValueError("Oversized viewer resolution")
            data = json.loads(payload)
            if (c["state"] != "PENDING" or data["id"] != c["id"] or (not c["claim"] or data["claim"] != c["claim"])
                    or data["source"] != c["source"]): return ""
            c["claim"] = None
            matches = data["matches"]
            if not isinstance(matches, list): raise ValueError("Invalid viewer resolution")
            if len(matches) > 1:
                self._viewer_fail(c, "Competing TigerVNC desktop identities", "ambiguous"); return ""
            if not matches:
                c["selected"] = None; return ""
            match = matches[0]
            xid, identifier = match["xid"], str(uuid.UUID(match["uuid"]))
            if type(xid) is not int or xid not in c["role_xids"] or xid in c["destroyed_xids"]:
                raise ValueError("Stale viewer XID")
            live = self.observed_windows.get(identifier)
            if (not live or live["pid"] != c["pid"] or identifier in c["baseline"]
                    or not matches_class("vncviewer", live["resource_class"], live["desktop_file"])):
                raise ValueError("Viewer identity is not a new live PID/class match")
            if not any(e["event"] == "added" and e["event_id"] > c["event_floor"]
                       and e["window_uuid"] == identifier for e in self.observation_events):
                raise ValueError("Viewer lacks new-window lifecycle")
            now = time.monotonic()
            if not c["selected"] or c["selected"][:2] != (xid, identifier):
                c["selected"] = (xid, identifier, now); return ""
            if now - c["selected"][2] < c["bounds"]["vnc_identity_settle_ms"] / 1000:
                return ""
            if not self._viewer_close(c):
                self._viewer_fail(c, "Viewer identity observer cleanup uncertain"); return ""
            managed = self.registry.register_match(c["id"], dict(state="MATCHED", request_id=c["id"],
                evidence="pid", candidate_history_complete=True, pid=c["pid"], window_uuid=identifier),
                current_windows=self.observed_windows, source=self.observation_source, synchronized=self.observation_synced)
            c["state"] = "MATCHED"
            c["managed_result"] = dict(state="registered", request_id=c["id"], managed_id=managed.managed_id,
                                       window_uuid=identifier)
            r = self.request
            r.update(state="RUNNING", created=now, viewer_uuid=identifier, viewer_source=c["source"],
                     viewer_placement_deadline=now + c["bounds"]["vnc_placement_timeout_ms"] / 1000)
            self._sync_managed_placement()
            return json.dumps({key: r[key] for key in ("id", "desktop", "x", "y", "width", "height")} |
                              {"window_uuid": identifier, "source": c["source"], "remaining_ms": c["bounds"]["vnc_placement_timeout_ms"]})
        except (ValueError, KeyError, TypeError, RegistryError):
            self._viewer_fail(c, "Invalid or stale viewer identity resolution")
            return ""

    @dbus.service.method(IFACE, in_signature="s", out_signature="")
    def CancelManagedViewerLaunch(self, request_id):
        c = self._managed_correlation
        if c and c.get("viewer") and c["id"] == request_id:
            self._viewer_fail(c, "Viewer launch cancelled or exited before readiness; cause unverified")
            if c.get("observer_cleanup_uncertain") and not self._viewer_close(c):
                raise dbus.DBusException("Viewer observer cleanup uncertain", name=IFACE + ".Busy")

    # Step 1.3b.1: a read-only launch correlation probe. It does not replace
    # SubmitLaunch/TakeLaunch, move a window or grant managed ownership.
    @dbus.service.method(IFACE, in_signature="ss", out_signature="s")
    def BeginCorrelation(self, expected_class, title_token):
        """Snapshot KWin identities before the caller launches its command."""
        expected_class = str(expected_class).strip()
        if (not expected_class or len(expected_class) > 128
                or len(title_token) > 128):
            raise dbus.DBusException("Invalid correlation hints",
                                     name=IFACE + ".BadArguments")
        if not self.observation_synced or not self.observation_source:
            raise dbus.DBusException("Wait for KWin inventory synchronization",
                                     name=IFACE + ".NotSynchronized")
        if self._initial_layout_active():
            raise dbus.DBusException("Initial layout is still active", name=IFACE + ".Busy")
        now = time.monotonic()
        self._expire_managed_correlation(now)
        if (self._managed_correlation is not None
                and self._managed_correlation["state"] == "PENDING"):
            raise dbus.DBusException("A managed launch is already active",
                                     name=IFACE + ".Busy")
        if (self.correlation is not None
                and self.correlation["state"] not in
                ("MATCHED", "AMBIGUOUS", "TIMEOUT", "STALE_SOURCE")
                and now < self.correlation["deadline"]):
            raise dbus.DBusException("A correlation probe is already active",
                                     name=IFACE + ".Busy")
        request_id = uuid.uuid4().hex
        self.correlation = self._new_correlation(
            request_id, expected_class, title_token)
        return request_id

    def _new_correlation(self, request_id, expected_class, title_token):
        """Broker-owned correlation snapshot; no ownership implied."""
        now = time.monotonic()
        return {
            "id": request_id, "expected_class": expected_class,
            "title_token": str(title_token), "pid": None,
            "source": self.observation_source,
            "baseline": set(self.observed_windows),
            "event_floor": self.observation_sequence,
            "created": now, "deadline": now + 15.0,
            "first_unique": None, "first_unique_at": None,
            "state": "PENDING", "result": None,
        }

    def _expire_managed_correlation(self, now=None):
        """Release an expired, unpolled private launch without adoption.

        An interrupted launch caller must not hold the broker's one active
        registry request forever. Only this broker-private transaction can be
        expired here; the public diagnostic correlation remains independent.
        """
        c = self._managed_correlation
        if c is None or c["state"] != "PENDING":
            return
        if now is None:
            now = time.monotonic()
        if c.get("viewer"):
            self._viewer_observe(c)
            if c["state"] != "PENDING":
                return
        if now < c["deadline"]:
            return
        self.registry.finish_failed(c["id"], "timeout", "TIMEOUT")
        c["state"] = "TIMEOUT"
        c["managed_result"] = {"state": "timeout", "request_id": c["id"],
                               "detail": "TIMEOUT"}

    def _begin_managed_launch(self, *, expected_class, recipe, run_id=None,
                              title_token=""):
        """Internal-only launch intent; the public probe cannot authorize it.

        A trusted broker-side launch orchestrator will call this before
        launching an application (Step 1.5). No D-Bus entry point yet exists.
        """
        expected_class = str(expected_class).strip()
        if not expected_class or len(expected_class) > 128 or len(title_token) > 128:
            raise RegistryError("invalid managed correlation hints")
        if (self.correlation is not None
                and self.correlation["state"] == "PENDING"
                and time.monotonic() < self.correlation["deadline"]):
            raise RegistryError("diagnostic correlation is still active")
        self._expire_managed_correlation()
        if (self._managed_correlation is not None
                and self._managed_correlation["state"] == "PENDING"):
            raise RegistryError("managed correlation is still active")
        request_id = uuid.uuid4().hex
        self.registry.begin_launch(
            request_id, source=self.observation_source,
            synchronized=self.observation_synced,
            baseline=self.observed_windows, recipe=recipe, run_id=run_id)
        self._managed_correlation = self._new_correlation(
            request_id, expected_class, title_token)
        return request_id

    def _set_managed_launch_pid(self, request_id, pid):
        """Private launch-PID handoff; never use public SetCorrelationPid."""
        c = self._managed_correlation
        if (c is None or c["id"] != request_id or c["pid"] is not None
                or c["state"] != "PENDING" or time.monotonic() >= c["deadline"]):
            raise RegistryError("inactive managed correlation")
        self.registry.mark_running(request_id, pid)
        c["pid"] = pid
        if c.get("viewer"):
            c["deadline"] = time.monotonic() + c["bounds"]["vnc_viewer_ready_timeout_ms"] / 1000
            self._viewer_schedule_expiry(c)

    def _poll_managed_launch(self, request_id):
        """Internal-only correlation, registration and terminal reporting."""
        c = self._managed_correlation
        if c is None or c["id"] != request_id:
            return {"state": "UNKNOWN"}
        if "managed_result" in c:
            return deepcopy(c["managed_result"])
        if c.get("viewer"):
            self._viewer_observe(c)
            return deepcopy(c.get("managed_result", {"state": "pending", "request_id": request_id, "detail": "waiting for TigerVNC desktop readiness; authentication may be pending"}))
        result = json.loads(self._poll_correlation(c))
        outcome = result["state"]
        if outcome == "MATCHED":
            try:
                managed = self.registry.register_match(
                    request_id, result, current_windows=self.observed_windows,
                    source=self.observation_source,
                    synchronized=self.observation_synced)
            except RegistryError as exc:
                self.registry.finish_failed(request_id, "failed", str(exc))
                answer = {"state": "failed", "request_id": request_id,
                          "detail": str(exc)}
            else:
                self._sync_managed_placement()
                answer = {"state": "registered", "request_id": request_id,
                          "managed_id": managed.managed_id,
                          "window_uuid": managed.window_uuid}
        elif outcome in ("AMBIGUOUS", "TIMEOUT", "STALE_SOURCE"):
            terminal = {"AMBIGUOUS": "ambiguous", "TIMEOUT": "timeout",
                        "STALE_SOURCE": "failed"}[outcome]
            self.registry.finish_failed(request_id, terminal, outcome)
            answer = {"state": terminal, "request_id": request_id,
                      "detail": outcome}
        else:
            return {"state": "pending", "request_id": request_id}
        c["managed_result"] = answer
        return deepcopy(answer)

    @dbus.service.method(IFACE, in_signature="si", out_signature="")
    def SetCorrelationPid(self, request_id, pid):
        """Record the shell-spawned child PID after the process starts."""
        c = self.correlation
        if (c is None or c["id"] != request_id or c["pid"] is not None
                or c["state"] != "PENDING" or time.monotonic() >= c["deadline"]
                or not isinstance(pid, int) or isinstance(pid, bool) or pid <= 0):
            raise dbus.DBusException("Unknown, expired or invalid correlation",
                                     name=IFACE + ".InvalidRequest")
        c["pid"] = int(pid)

    def _correlation_class_candidates(self, c):
        """Describe retained new-class observations; never decide ownership.

        An addition event proves this UUID was *observed* after the request
        began. It does NOT prove that the request caused the window. Read the
        latest snapshot for a living UUID, or the last removal snapshot for a
        closed one, while retaining the original addition's event identity.
        """
        results = []
        seen = set()
        for event in self.observation_events:
            identifier = event["window_uuid"]
            if (event["event"] != "added"
                    or event["event_id"] <= c["event_floor"]
                    or identifier in c["baseline"] or identifier in seen):
                continue
            seen.add(identifier)
            current = self.observed_windows.get(identifier)
            details = current or event["window"]
            if current is None:
                # The window may already have closed. A retained removal
                # snapshot is newer than its addition snapshot, when present.
                for later in reversed(self.observation_events):
                    if (later["window_uuid"] == identifier
                            and later["event"] == "removed"
                            and later["event_id"] > event["event_id"]):
                        details = later["window"]
                        break
            # On some applications KWin learns the class only after the
            # windowAdded signal. Allow the latest or original class to
            # qualify, but neither is sufficient evidence of ownership.
            expected = c["expected_class"]
            if not (matches_class(expected, details["resource_class"],
                                  details["desktop_file"])
                    or matches_class(expected, event["window"]["resource_class"],
                                     event["window"]["desktop_file"])):
                continue
            if c["pid"] is not None and details["pid"] == c["pid"]:
                evidence = "pid"
            elif c["title_token"] and c["title_token"] in details["caption"]:
                evidence = "class_title_hint"
            else:
                evidence = "class_only"
            results.append({
                "window_uuid": identifier,
                "pid": details["pid"],
                "event_id": event["event_id"],
                "currently_observed": current is not None,
                "evidence": evidence,
            })
        # observation_events is ordered by broker-local event_id; ordering
        # results likewise makes diagnostics stable across successive polls.
        return results

    @dbus.service.method(IFACE, in_signature="s", out_signature="s")
    def PollCorrelation(self, request_id):
        """Return current evidence; never infer ownership from a title/class."""
        c = self.correlation
        if c is None or c["id"] != request_id:
            return json.dumps({"state": "UNKNOWN"})
        return self._poll_correlation(c)

    def _poll_correlation(self, c):
        """One evaluator for diagnostic and broker-private correlation."""
        if c["result"] is not None:
            return json.dumps(c["result"], sort_keys=True)

        def finish(state, **fields):
            # Terminal results are stable for this broker-local request ID.
            c["state"] = state
            c["result"] = dict(state=state, request_id=c["id"], **fields)
            return json.dumps(c["result"], sort_keys=True)

        if not self.observation_synced or c["source"] != self.observation_source:
            return finish("STALE_SOURCE", class_candidates=[],
                          candidate_history_complete=False)
        # The diagnostic list is independent of the exact-PID selection path.
        # Do not promote class/timing matches into a MATCHED or AMBIGUOUS state.
        diagnostic = {
            "class_candidates": self._correlation_class_candidates(c),
            "candidate_history_complete": (
                self.observation_evicted_through <= c["event_floor"]),
        }
        # A "changed" event does not establish window creation. Only a UUID
        # from an "added" lifecycle record after BeginCorrelation is eligible.
        # The history is bounded: if the record was evicted, fail closed.
        fresh_ids = {
            e["window_uuid"] for e in self.observation_events
            if e["event"] == "added" and e["event_id"] > c["event_floor"]
        }
        candidates = {
            identifier: details
            for identifier, details in self.observed_windows.items()
            if (identifier not in c["baseline"] and identifier in fresh_ids
                and matches_class(c["expected_class"],
                                  details["resource_class"], details["desktop_file"]))
        }
        # PID is direct evidence worth testing, but it is not a universal
        # identity contract: a shell child may exec, fork or delegate a window.
        by_pid = sorted(identifier for identifier, w in candidates.items()
                        if c["pid"] is not None and w["pid"] == c["pid"])
        # A unique visible title is a useful diagnostic HINT, not proof.
        by_title = sorted(identifier for identifier, w in candidates.items()
                          if c["title_token"] and c["title_token"] in w["caption"])
        if len(by_pid) > 1:
            return finish("AMBIGUOUS", candidates=by_pid, evidence="pid",
                          **diagnostic)
        now = time.monotonic()
        if len(by_pid) == 1 and diagnostic["candidate_history_complete"]:
            # Permit another same-PID KWin window to arrive before returning
            # a unique diagnostic match (the probe never enrolls ownership).
            # If lifecycle events were evicted during the probe, a different
            # matching window may be missing: do not assert uniqueness.
            if c["first_unique"] != by_pid[0]:
                c["first_unique"] = by_pid[0]
                c["first_unique_at"] = now
            elif now - c["first_unique_at"] >= 0.5:
                return finish("MATCHED", window_uuid=by_pid[0],
                              pid=c["pid"], evidence="pid", **diagnostic)
        else:
            c["first_unique"] = None
            c["first_unique_at"] = None
        if now >= c["deadline"]:
            return finish("TIMEOUT", title_hints=by_title,
                          pid_candidates=by_pid, **diagnostic)
        return json.dumps({"state": "PENDING", "request_id": c["id"],
                           "pid_candidates": by_pid,
                           "title_hints": by_title,
                           **diagnostic}, sort_keys=True)


    def _bound_observation_events(self):
        """Limit lifecycle history and remember whether a probe lost events."""
        if len(self.observation_events) > 128:
            dropped = self.observation_events[:-128]
            self.observation_evicted_through = dropped[-1]["event_id"]
            del self.observation_events[:-128]

    def _refresh_registered_window(self, identifier, details):
        """Reconcile one existing registration, never adopt an observed UUID."""
        record = self.registry.managed_windows.get(identifier)
        if record is None:
            return
        if details is None:
            self.registry.set_presence(identifier, "missing")
        elif record.presence == "present":
            # PID changes or a mismatched identity are cause for uncertainty,
            # not for trusting an observation as a replacement registration.
            if details["pid"] != record.observation["pid"]:
                self.registry.set_presence(identifier, "uncertain")
            else:
                self.registry.set_presence(identifier, "present", details)
        # A previously missing/uncertain record cannot be re-adopted by an
        # inventory refresh or a later class/title/UUID observation.

    # Step 1.3a: KWin's resident reports facts, not ownership decisions.
    # One JSON string avoids altering the six established move/launch methods.
    # The new signature 's' means one string arrives on the session bus;
    # out_signature='' means there is no reply value. The sender is not yet
    # authenticated as KWin, so observations must NEVER authorize closes.
    @staticmethod
    def _normalized_window(details):
        """Validate/copy a KWin snapshot before changing any broker state."""
        identifier = str(uuid.UUID(details["uuid"]))
        geometry = details["geometry"]
        if (not isinstance(details["pid"], int) or isinstance(details["pid"], bool)
                or not isinstance(details["desktops"], list)
                or not isinstance(details["on_all_desktops"], bool)
                or not all(isinstance(details[field], str) for field in
                           ("resource_class", "resource_name", "desktop_file", "caption"))
                or not all(isinstance(geometry[field], (int, float)) and
                           not isinstance(geometry[field], bool) for field in
                           ("x", "y", "width", "height"))):
            raise ValueError("invalid observation fields")
        # Never mutate the dictionary supplied by a caller in-place.
        return dict(details, uuid=identifier)

    @staticmethod
    def _source_revision(message):
        """Read an optional resident source/revision pair as one unit."""
        source = message.get("source")
        revision = message.get("revision")
        if source is None and revision is None:
            return None  # Older diagnostic clients; never proof of ownership.
        if (not isinstance(source, str) or not (1 <= len(source) <= 96)
                or not isinstance(revision, int) or isinstance(revision, bool)
                or revision < 1):
            raise ValueError("invalid observation source/revision")
        return source, revision

    @dbus.service.method(IFACE, in_signature="s", out_signature="")
    def ObserveWindow(self, payload):
        # Preserve the existing single-string method and payload-size bound.
        if len(payload) > 4096:
            raise dbus.DBusException("Observation too large", name=IFACE + ".BadArguments")
        try:
            message = json.loads(payload)
            event = message["event"]
            if event not in ("existing", "added", "changed", "removed"):
                raise ValueError("invalid observation event")
            details = self._normalized_window(message["window"])
            source_revision = self._source_revision(message)
        except (TypeError, ValueError, KeyError, AttributeError) as exc:
            raise dbus.DBusException("Malformed window observation",
                                     name=IFACE + ".BadArguments") from exc

        identifier = details["uuid"]
        if source_revision is not None:
            source, revision = source_revision
            # A newly loaded resident must establish itself with a complete
            # inventory before we accept its incremental events. Conversely,
            # drop delayed messages belonging to the prior resident instance.
            if self.observation_source is None:
                self.observation_source = source
            if source != self.observation_source or revision <= self.observation_revision:
                c = self._rdp_registration
                if c and c["state"] == "PENDING" and c.get("expected_backend") == "x11":
                    self._rdp_finish(c, "failed", "RDP observation source/revision gap")
                return
            self.observation_revision = revision
        elif self.observation_synced:
            # Legacy, unsequenced calls cannot supersede synchronized state.
            return
        # Private SDL tracking is inactive unless explicitly armed in-process.
        # Tap validated, ordered reports before caption changes are coalesced.
        self._rdp_observation(event, details)
        if event == "existing" and identifier in self.observed_windows:
            # A manual refresh republishes every live window. Update current
            # state, but do NOT fabricate another window-creation event.
            self.observed_windows[identifier] = details
            self._refresh_registered_window(identifier, details)
            self._advance_placement()
            self._rdp_recheck_x11()
            return

        # Only allocate an ID for a retained lifecycle record or change
        # summary. A sequence is unique within one broker process, but is
        # deliberately not a durable or globally unique event identity.
        self.observation_sequence += 1
        record = {"event_id": self.observation_sequence,
                  "event": event, "window_uuid": identifier,
                  "window": details}

        if event == "changed":
            # Keep one most-recent update per live window. The counter shows
            # how many incoming change reports that entry summarizes. It
            # covers geometry, desktops, captions and other observed fields.
            before = self.observation_changes.get(identifier)
            record["change_count"] = (before["change_count"] + 1
                                      if before else 1)
            self.observation_changes[identifier] = record
            self.observed_windows[identifier] = details
            self._refresh_registered_window(identifier, details)
            self._advance_placement()
            self._rdp_recheck_x11()
            return

        if event == "removed":
            # Drop the live state and coalesced changes. The removal event
            # retains KWin's last known snapshot; never treat that as live.
            self.observed_windows.pop(identifier, None)
            self.observation_changes.pop(identifier, None)
        else:
            self.observed_windows[identifier] = details
        self._refresh_registered_window(
            identifier, None if event == "removed" else details)
        self._advance_placement(removed_uuid=identifier if event == "removed" else None)

        # 'existing', 'added' and 'removed' cannot be evicted by dragging.
        # This is still a bounded diagnostic history, NOT an audit log.
        self.observation_events.append(record)
        self._bound_observation_events()
        self._rdp_recheck_x11()

    # A whole inventory is one D-Bus method call and one broker replacement.
    # Per-window "existing" updates are not an atomic inventory boundary:
    # this snapshot also removes any stale UUIDs left by a missed removal.
    @dbus.service.method(IFACE, in_signature="s", out_signature="")
    def SyncInventory(self, payload):
        if len(payload) > 262144:
            raise dbus.DBusException("Inventory too large", name=IFACE + ".BadArguments")
        try:
            message = json.loads(payload)
            source_revision = self._source_revision(message)
            if source_revision is None:
                raise ValueError("inventory requires source/revision")
            source, revision = source_revision
            move_protocol = message.get("move_protocol", 0)
            if type(move_protocol) is not int or move_protocol not in (0, 1):
                raise ValueError("invalid move protocol")
            windows = message["windows"]
            if not isinstance(windows, list) or len(windows) > 512:
                raise ValueError("invalid inventory length")
            # Validate the entire inventory in a temporary map. Failure must
            # leave the old state untouched, rather than half-synchronized.
            replacement = {}
            for item in windows:
                details = self._normalized_window(item)
                identifier = details["uuid"]
                if identifier in replacement:
                    raise ValueError("duplicate UUID in inventory")
                replacement[identifier] = details
        except (TypeError, ValueError, KeyError, AttributeError) as exc:
            raise dbus.DBusException("Malformed window inventory",
                                     name=IFACE + ".BadArguments") from exc

        if source == self.observation_source and revision <= self.observation_revision:
            c = self._rdp_registration
            if c and c["state"] == "PENDING" and c.get("expected_backend") == "x11":
                self._rdp_finish(c, "failed", "RDP observation revision gap")
            return  # Old/out-of-order inventory; do not roll back live changes.
        # A different resident instance replaces the source after a KWin
        # reload. These UUIDs are still *observed*, never managed windows.
        source_changed = (self.observation_source is not None
                          and source != self.observation_source)
        if source != self.observation_source:
            self.observation_changes.clear()
        self.observation_source = source
        self.observation_revision = revision
        self.observation_synced = True
        self.initial_layout_protocol = (1 if type(message.get("initial_layout_protocol")) is int and message.get("initial_layout_protocol") == 1 else 0)
        self.single_raise_protocol = (1 if type(message.get("single_raise_protocol")) is int and message.get("single_raise_protocol") == 1 else 0)
        self.viewer_protocol = (1 if type(message.get("viewer_protocol")) is int and message.get("viewer_protocol") == 1 else 0)
        self.move_protocol = move_protocol
        # Do not invent "removed" events for entries absent in the snapshot:
        # such entries could predate a broker restart or a missed notification.
        previous = set(self.observed_windows)
        self.observed_windows = replacement
        for identifier in list(self.observation_changes):
            if identifier not in replacement:
                self.observation_changes.pop(identifier, None)
            else:
                self.observation_changes[identifier]["window"] = replacement[identifier]
        # A full inventory is not a launch and never allocates managed IDs.
        # Keep "existing" history limited to genuinely newly discovered UUIDs.
        for identifier, details in replacement.items():
            if identifier not in previous:
                self.observation_sequence += 1
                self.observation_events.append({
                    "event_id": self.observation_sequence, "event": "existing",
                    "window_uuid": identifier, "window": details})
        self._bound_observation_events()
        # An inventory replacement never invents new ownership. A new resident
        # source invalidates prior managed evidence even if UUIDs recur.
        for identifier in list(self.registry.managed_windows):
            if source_changed:
                self.registry.set_presence(identifier, "uncertain")
            else:
                self._refresh_registered_window(
                    identifier, self.observed_windows.get(identifier))
        self._advance_placement()
        self._rdp_observation()
        self._rdp_recheck_x11()

    # Read-only diagnostic query. Output is JSON, not a public management
    # registry: class, caption and PID are observational hints only.
    @dbus.service.method(IFACE, in_signature="", out_signature="s")
    def ListObserved(self):
        # Preserve the familiar 'events' shape for existing jq consumers.
        # Its contents are a merge of independently bounded lifecycle
        # history and latest-per-UUID change summaries, ordered by event_id.
        changes = list(self.observation_changes.values())
        events = sorted(self.observation_events + changes,
                        key=lambda record: record["event_id"])
        return json.dumps({"windows": list(self.observed_windows.values()),
                           "events": events,
                           "lifecycle_events": self.observation_events,
                           "changes": changes,
                           "sync": {"complete": self.observation_synced,
                                    "source": self.observation_source,
                                    "revision": self.observation_revision}}, sort_keys=True)


    # Step 1.4c: read-only managed-window queries. The returned JSON is an
    # explicit allowlist, never a serialization of recipes or registry objects.
    @staticmethod
    def _managed_summary(record):
        return {"managed_id": record.managed_id,
                "window_uuid": record.window_uuid,
                "request_id": record.request_id,
                "run_id": record.run_id,
                "presence": record.presence,
                "placement": record.placement,
                "connection": record.connection,
                "intended": {key: record.recipe.get(key) for key in ("desktop", "slot")}}

    @dbus.service.method(IFACE, in_signature="", out_signature="s")
    def ListManaged(self):
        """List only positively registered windows in managed-ID order."""
        records = sorted(self.registry.managed_windows.values(),
                         key=lambda item: int(item.managed_id[4:]))
        return json.dumps({"count": len(records),
                           "windows": [self._managed_summary(item)
                                       for item in records]}, sort_keys=True)

    @dbus.service.method(IFACE, in_signature="s", out_signature="s")
    def GetManaged(self, identifier):
        """Look up a managed ID or KWin UUID; unknown is not ownership."""
        if not isinstance(identifier, str) or not (1 <= len(identifier) <= 128):
            raise dbus.DBusException("Invalid managed-window identifier",
                                     name=IFACE + ".BadArguments")
        try:
            record = self.registry.get_window(identifier)
        except RegistryError:
            record = None
        if record is None:
            return json.dumps({"state": "UNKNOWN"}, sort_keys=True)
        detail = self._managed_summary(record)
        # Observation is last-known if presence is missing or uncertain.
        # A KWin observation may contain extra fields. Do not forward them.
        observed = record.observation
        geometry = observed["geometry"]
        detail["observation"] = {
            "pid": observed["pid"],
            "resource_class": observed["resource_class"],
            "desktop_file": observed["desktop_file"],
            "caption": observed["caption"][:256],
            "desktops": list(observed["desktops"]),
            "on_all_desktops": observed["on_all_desktops"],
            "geometry": {key: geometry[key]
                         for key in ("x", "y", "width", "height")},
        }
        return json.dumps({"state": "FOUND", "window": detail}, sort_keys=True)

    @dbus.service.method(IFACE, in_signature="", out_signature="s")
    def RegistryStatus(self):
        """Return in-memory registry counts and observer synchronization."""
        presence = {state: 0 for state in ("present", "missing", "uncertain")}
        for record in self.registry.managed_windows.values():
            presence[record.presence] += 1
        requests = {state: 0 for state in
                    ("pending", "running", "succeeded", "failed",
                     "timeout", "ambiguous")}
        for request in self.registry.requests.values():
            requests[request.state] += 1
        return json.dumps({
            # Snapshot only; Status(request_id) remains responsible for advancing
            # verification. Clients conservatively stop on nonterminal snapshots.
            "placement_transaction": ({"id": self.request["id"], "state": self.request["state"]}
                                      if self.request is not None else {"id": None, "state": "IDLE"}),
            "viewer_protocol": self.viewer_protocol,
            "viewer_cleanup_uncertain": bool(self._managed_correlation and self._managed_correlation.get("observer_cleanup_uncertain")),
            "initial_layout_protocol": self.initial_layout_protocol,
            "single_raise_protocol": self.single_raise_protocol,
            "initial_layout_active": self._initial_layout_active(),
            "managed_count": len(self.registry.managed_windows),
            "presence_counts": presence,
            "request_count": len(self.registry.requests),
            "request_counts": requests,
            "observation": {
                "synchronized": self.observation_synced,
                "source": self.observation_source,
                "revision": self.observation_revision,
                "observed_count": len(self.observed_windows),
            },
        }, sort_keys=True)


# Unlike BUS/PATH/IFACE above, these identifiers address KWin's *own*
# D-Bus scripting service, which we use to load our resident JavaScript.
# The defaults are packaging locations; the user OpenRC configuration may
# override them and passes the resolved values through environment variables.
KWIN_BUS = "org.kde.KWin"
KWIN_SCRIPTING = "org.kde.kwin.Scripting"
KWIN_SCRIPT = "org.kde.kwin.Script"
RESIDENT_DEFAULT = "/usr/share/joetoo-kwin/joetoo-kwin-resident.js"
SCRIPT_NAME_DEFAULT = "joetoo-bridge"


class ResidentCoordinator:
    """Load the resident in KWin, never supervise KWin or user applications."""
    # This object is a D-Bus *client*, not another public joetoo method set.
    # A live Python reference keeps the coordinator/timer handlers available
    # while the GLib event loop runs.

    def __init__(self, bus, broker=None):
        # The same existing graphical user's session bus is shared with the
        # Broker; there must not be a separate daemon or KWin process here.
        self.bus = bus
        # Keep a reference to diagnostic sync completion for bounded retries.
        self.broker = broker
        self.file = os.environ.get("JOETOO_KWIND_RESIDENT_JS", RESIDENT_DEFAULT)
        self.name = os.environ.get("JOETOO_KWIND_SCRIPT_NAME", SCRIPT_NAME_DEFAULT)
        # GLib timers have numeric source IDs. None means no timer is queued.
        # last_error suppresses printing the same retry failure repeatedly.
        self.timer = None
        self.last_error = None
        if not os.path.isabs(self.file) or not self.name:
            raise RuntimeError("Resident script path must be absolute and script name nonempty")

    def start(self):
        # Subscribe to the session bus daemon's NameOwnerChanged notifications.
        # arg0 restricts delivery to changes concerning org.kde.KWin. This is
        # event-driven; no separate process continuously polls for restarts.
        self.bus.add_signal_receiver(
            self._owner_changed, signal_name="NameOwnerChanged",
            dbus_interface="org.freedesktop.DBus", bus_name="org.freedesktop.DBus",
            path="/org/freedesktop/DBus", arg0=KWIN_BUS)
        # Schedule first initialization after returning to the event loop.
        # The argument is milliseconds, not seconds.
        self._schedule(1)

    def _owner_changed(self, name, old_owner, new_owner):
        # D-Bus supplies the old/new connection owners. They are not used
        # here: owner disappearance or replacement simply schedules a retry.
        if name == KWIN_BUS:
            if self.broker is not None:
                self.broker.observation_synced = False
            # KWin owns the script. A fresh KWin owner needs initialization.
            self._schedule(1)

    def _schedule(self, delay_ms):
        # Cancel the previously scheduled GLib callback, if one exists, so
        # multiple owner-change signals cannot accumulate duplicate retries.
        if self.timer is not None:
            GLib.source_remove(self.timer)
        # timeout_add registers _attempt as an event-loop callback and
        # returns the ID needed to cancel the pending call later.
        self.timer = GLib.timeout_add(delay_ms, self._attempt)

    def _attempt(self):
        # This callback executes on the GLib main loop. The scheduled source
        # has fired; clear its ID before either retrying or reporting success.
        self.timer = None
        try:
            result = self.ensure_loaded()
            # A newly started script reports its inventory at initialization;
            # one that survived the Python broker restart needs an explicit
            # refresh, otherwise quiet preexisting windows remain invisible.
            if result == "reused":
                self.request_inventory_refresh()
        except (OSError, RuntimeError, dbus.DBusException) as exc:
            # KWin, its D-Bus interface, or our resident file may not yet be
            # ready. Log a changed error once, then retry in five seconds.
            detail = str(exc)
            if detail != self.last_error:
                print(f"joetoo-kwind: resident unavailable: {detail}",
                      file=sys.stderr, flush=True)
            self.last_error = detail
            self._schedule(5000)
        else:
            self.last_error = None
            print(f"joetoo-kwind: KWin resident {result}: {self.name}", flush=True)
            # Invocation returns before the resident's asynchronous inventory
            # reaches us. If it is still absent, recheck/retry in one second.
            if self.broker is not None and not self.broker.observation_synced:
                self._schedule(1000)
        # SOURCE_REMOVE tells GLib not to automatically repeat *this* timer;
        # _schedule explicitly creates another only when necessary.
        return GLib.SOURCE_REMOVE

    def ensure_loaded(self):
        """Return 'reused' or 'started', without creating duplicate scripts."""
        # Resolve KWin's scripting object, then bind to its named interface.
        # introspect=False avoids an extra D-Bus introspection round trip;
        # each method call has its own bounded timeout (in seconds).
        proxy = self.bus.get_object(KWIN_BUS, "/Scripting", introspect=False)
        scripting = dbus.Interface(proxy, KWIN_SCRIPTING)
        # Presence is not identical to *running*: a script manually loaded
        # without a subsequent `run()` may exist but not execute callbacks.
        # Reuse prevents duplicate handler registrations during broker restart.
        if scripting.isScriptLoaded(self.name, timeout=5):
            return "reused"
        # Only inspect the configured file if a new load is required.
        # isfile() checks its type; access(..., R_OK) checks readability.
        if not os.path.isfile(self.file) or not os.access(self.file, os.R_OK):
            raise RuntimeError(f"resident script is not readable: {self.file}")
        # loadScript registers a named KWin script and returns an object ID.
        # Registering alone does *not* execute the script; `run()` comes next.
        script_id = int(scripting.loadScript(self.file, self.name, timeout=5))
        if script_id < 0:
            if scripting.isScriptLoaded(self.name, timeout=5):
                return "reused"  # Someone else registered it first.
            raise RuntimeError("KWin refused resident load")
        # An f-string inserts the numeric ID into the object path used by
        # KWin's per-script run method (e.g. /Scripting/Script3).
        script_path = f"/Scripting/Script{script_id}"
        script_proxy = self.bus.get_object(KWIN_BUS, script_path, introspect=False)
        try:
            dbus.Interface(script_proxy, KWIN_SCRIPT).run(timeout=10)
        except dbus.DBusException:
            # If starting a script we *just loaded* fails, remove that named
            # registration so a later attempt can try cleanly.
            # Only undo a script this instance created; never unload another's.
            scripting.unloadScript(self.name, timeout=5)
            raise
        return "started"

    def request_inventory_refresh(self):
        """Invoke the resident's existing no-hotkey refresh action via D-Bus."""
        proxy = self.bus.get_object("org.kde.kglobalaccel", "/component/kwin",
                                    introspect=False)
        accel = dbus.Interface(proxy, "org.kde.kglobalaccel.Component")
        # This is the same KGlobalAccel action already tested manually on
        # X11 and Wayland; it does not restart KWin or application processes.
        accel.invokeShortcut("joetoo_bridge_observe", timeout=5)


def main():
    try:
        # Fail early unless this is a real non-root user graphical session.
        validate_session_environment()
        # Connect dbus-python to GLib so its method calls and callbacks are
        # dispatched by the same event loop as our signal handlers/timers.
        DBusGMainLoop(set_as_default=True)
        bus = dbus.SessionBus()
        # Request exclusive ownership of our broker service name. If another
        # broker already owns it, fail rather than waiting in the D-Bus queue.
        name = dbus.service.BusName(BUS, bus=bus, do_not_queue=True)
        # Keep this object reachable throughout loop.run(): otherwise a
        # garbage-collected object could no longer serve the six methods.
        broker = Broker(name)  # noqa: F841 - hold D-Bus object for lifetime
        resident = ResidentCoordinator(bus, broker)
        loop = GLib.MainLoop()
        resident.start()

        def graceful_shutdown():
            # Stop this broker's event loop only. Do not terminate KWin,
            # the resident script, or Konsole/SSH processes owned by the user.
            loop.quit()
            return GLib.SOURCE_REMOVE

        # Register the same callback for termination and interrupt signals.
        # OpenRC stop sends a signal to the broker, not to managed windows.
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM,
                             graceful_shutdown)
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGINT,
                             graceful_shutdown)
        print(f"Ready on session bus: {BUS} {PATH}", flush=True)
        # This blocks, dispatching user D-Bus messages and timer callbacks,
        # until graceful_shutdown() asks the loop to quit.
        loop.run()
        return 0
    except (RuntimeError, dbus.DBusException) as exc:
        print(f"joetoo-kwind: {exc}", file=sys.stderr, flush=True)
        return 1


# Python sets __name__ to "__main__" when executing this file directly;
# importing it (e.g. in tests) must not start a live D-Bus broker.
# sys.exit propagates main()'s zero/nonzero result to OpenRC.
if __name__ == "__main__":
    sys.exit(main())
