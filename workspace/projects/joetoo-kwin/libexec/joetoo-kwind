"""Non-root OpenRC-supervised KWin session-bus broker.

Preserves the move/launch contract, and initializes KWin resident JS;
application process supervision and window persistence are not yet implemented.
"""

# Standard Python libraries: JSON messages, process environment and IDs,
# POSIX signals and file metadata, elapsed time, and unique request tokens.
# No window-launching or SSH process control modules are needed here.
import json
from copy import deepcopy
import os
import signal
import stat
import sys
import time
import uuid

# dbus-python makes this process both a session-bus service (Broker) and
# a client of KWin's own D-Bus scripting interface (ResidentCoordinator).
# GLib supplies one event loop to dispatch messages, timers, and signals.
import dbus
import dbus.service
from dbus.mainloop.glib import DBusGMainLoop
from gi.repository import GLib

# The installed daemon and registry module must reside in the same libexec
# directory. The headless test loader does not add that directory to sys.path.
_libexec_dir = os.path.dirname(os.path.realpath(__file__))
if _libexec_dir not in sys.path:
    sys.path.insert(0, _libexec_dir)
from joetoo_kwin_registry import RegistryError, WindowRegistry

# Our D-Bus address has three parts:
#   BUS  = unique service name that the Python process requests ownership of;
#   PATH = object address *within* that service;
#   IFACE = method namespace presented by the object.
# An individual call also names a method, e.g. IFACE + ".Submit".
BUS = "org.joetoo.KWinBridge"
PATH = "/org/joetoo/KWinBridge"
IFACE = BUS


def matches_class(expected, resource_class, desktop_file):
    """Accept either the advertised class or the final component of an app ID."""
    # strip() removes surrounding whitespace; casefold() compares without
    # case distinctions. A dotted desktop-file ID may have a namespace prefix
    # such as "org.kde." before the expected application class.
    # This is *provisional* class matching, not proof of window identity.
    target = str(expected).strip().casefold()
    if not target:
        return False
    for actual in (resource_class, desktop_file):
        actual = str(actual).strip().casefold()
        if actual == target or actual.endswith("." + target):
            return True
    return False


def validate_session_environment():
    """Reject root/wrong runtime-dir; never silently autolaunch a new D-Bus bus."""
    # The caller must be the ordinary graphical user. geteuid() is the
    # effective numeric user ID; zero would give the broker root privileges.
    if os.geteuid() == 0:
        raise RuntimeError("joetoo-kwind must not run as root")
    # .get(key, "") returns an empty default for a missing variable.
    # The graphical session's runtime directory must be an absolute path.
    runtime = os.environ.get("XDG_RUNTIME_DIR", "")
    if not runtime or not os.path.isabs(runtime):
        raise RuntimeError("XDG_RUNTIME_DIR must be an absolute path")
    # os.stat() reads file metadata; unlike opening a file it does not
    # execute anything. Re-raise an unavailable directory as a clear error.
    try:
        info = os.stat(runtime)
    except OSError as exc:
        raise RuntimeError("XDG_RUNTIME_DIR is unavailable") from exc
    # Require an actual directory owned by this account. st_mode describes
    # file type/permissions; st_uid gives its owner's numeric user ID.
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.geteuid():
        raise RuntimeError("XDG_RUNTIME_DIR must be a user-owned directory")
    # Use the existing session-bus address when OpenRC passed it through.
    # Otherwise look only for an already-existing Unix socket; never start
    # a separate D-Bus daemon, which could address the wrong Plasma session.
    if not os.environ.get("DBUS_SESSION_BUS_ADDRESS"):
        socket_path = os.path.join(runtime, "bus")
        try:
            is_socket = stat.S_ISSOCK(os.stat(socket_path).st_mode)
        except OSError:
            is_socket = False
        if not is_socket:
            raise RuntimeError("No user session bus address or runtime bus socket")
        os.environ["DBUS_SESSION_BUS_ADDRESS"] = "unix:path=" + socket_path


# dbus.service.Object is a base class that exposes Python methods over D-Bus.
# Only one request record is held in memory at this early milestone. The
# broker is NOT a parent/process supervisor for Konsole or SSH applications.
class Broker(dbus.service.Object):
    def __init__(self, bus_name):
        # super() initializes dbus-python's parent object with the acquired
        # service name and this object's path. `self` is this Broker instance;
        # None means that no move/launch request has been submitted yet.
        super().__init__(bus_name, PATH)
        self.request = None
        # Transient diagnostic observations are NOT a managed-window registry.
        # No observed window becomes eligible for -d or -x; these records are
        # session-local and deliberately disappear when this broker restarts.
        self.observed_windows = {}
        # Lifecycle history is bounded independently of geometry traffic.
        # These events describe observation only, never managed ownership.
        self.observation_events = []
        # Highest lifecycle event ID evicted by the 128-record cap. A probe
        # started before that event cannot claim to list every new candidate.
        self.observation_evicted_through = 0
        # Each living UUID needs at most one coalesced change summary.
        # This is NOT a second managed-window registry.
        self.observation_changes = {}
        # Sequence numbers identify retained events only during THIS broker
        # lifetime. They do not survive restart or identify a KWin session.
        self.observation_sequence = 0
        # The current resident script is the source of our inventory. Revisions
        # order its asynchronous messages; they never grant window ownership.
        self.observation_source = None
        self.observation_revision = -1
        self.observation_synced = False
        # Step 1.3b diagnostic-only: one pending correlation probe. This is
        # deliberately NOT the managed-window registry of Step 1.4.
        self.correlation = None
        # Step 1.4b: ownership and correlation kept entirely broker-private.
        # None of these methods is exposed as a D-Bus registration API.
        self.registry = WindowRegistry()
        self._managed_correlation = None

    def _submit(self, kind, desktop, x, y, width, height, app_class=""):
        # Shared implementation for Submit (move) and SubmitLaunch (launch).
        # `_submit` is an internal Python method, not an exported D-Bus name.
        # In-flight verification is still a placement request: never allow a
        # second request to overwrite the UUID before it settles or times out.
        self._advance_placement()
        if (self.request is not None
                and self.request["state"] in ("PENDING", "RUNNING", "VERIFYING")
                # monotonic() is an elapsed-time clock, not wall-clock time.
                # Only a recent pending/running request blocks another one.
                and time.monotonic() - self.request["created"] < 20):
            raise dbus.DBusException("Previous request has not completed",
                                     name=IFACE + ".Busy")

        # Enforce the broker's current bounds before accepting a request.
        # The Bash CLI also validates input, but direct D-Bus clients can
        # bypass it, so the broker must perform its own checks.
        if not (1 <= desktop <= 256 and
                -32768 <= x <= 32768 and -32768 <= y <= 32768 and
                1 <= width <= 32768 and 1 <= height <= 32768):
            raise dbus.DBusException("Desktop, position, or size out of range",
                                     name=IFACE + ".BadArguments")

        if kind == "launch" and not (0 < len(app_class) <= 128):
            raise dbus.DBusException("Expected application class is required",
                                     name=IFACE + ".BadArguments")

        # Save one in-memory request as a Python dictionary (key/value map).
        # uuid4().hex is a random *transaction* ID, NOT a KWin window UUID.
        # PENDING -> RUNNING -> OK/ERROR is the request state transition.
        self.request = {
            "id": uuid.uuid4().hex,
            "kind": kind,
            "desktop": int(desktop),
            "x": int(x), "y": int(y),
            "width": int(width), "height": int(height),
            "app_class": str(app_class),
            "state": "PENDING", "detail": "",
            "created": time.monotonic(),
        }
        return self.request["id"]

    def _take(self, kind):
        # The KWin JS "Take" callback claims a pending request of this kind.
        # `r` is another reference to the current request dictionary; changing
        # r["state"] also changes self.request["state"].
        r = self.request
        if r is None or r["state"] != "PENDING" or r["kind"] != kind:
            return ""
        r["state"] = "RUNNING"
        # Dictionary comprehension: copy only the selected fields into a
        # smaller dictionary, then encode it as JSON text for the JS callback.
        # Launch class and internal timestamps are not part of this payload.
        return json.dumps({k: r[k] for k in
                           ("id", "desktop", "x", "y", "width", "height")})

    # A decorator (@...) exports the next Python method on this D-Bus
    # interface. A D-Bus signature describes argument/result wire types:
    # "i" = signed 32-bit integer, "s" = string, "" = no arguments/result.
    # The methods below are the six public calls used by Bash and KWin JS.
    @dbus.service.method(IFACE, in_signature="iiiii", out_signature="s")
    def Submit(self, desktop, x, y, width, height):
        # CLI arms a move and receives the request ID as a string.
        return self._submit("move", desktop, x, y, width, height)

    @dbus.service.method(IFACE, in_signature="", out_signature="s")
    def Take(self):
        # Resident JS obtains the queued move request as JSON text.
        return self._take("move")

    @dbus.service.method(IFACE, in_signature="siiiii", out_signature="s")
    def SubmitLaunch(self, app_class, desktop, x, y, width, height):
        # CLI arms a class-qualified launch *before* starting the application.
        return self._submit("launch", desktop, x, y, width, height, app_class)

    @dbus.service.method(IFACE, in_signature="ss", out_signature="s")
    def TakeLaunch(self, resource_class, desktop_file):
        # KWin calls this after windowAdded. Only the first matching pending
        # launch is eligible; no persistent window identity is recorded here.
        r = self.request
        if (r is None or r["state"] != "PENDING" or r["kind"] != "launch"
                or not matches_class(r["app_class"], resource_class, desktop_file)):
            return ""
        return self._take("launch")

    def _sync_managed_placement(self):
        """Cross-check target UUID and record placement without granting ownership.

        Registration and placement can complete in either order. A successful
        placement on a different UUID must NEVER be attributed to the managed
        window, even when both have the same application class or PID.
        """
        r = self.request
        if r is None or not r.get("registration_request_id"):
            return
        launch = self.registry.requests.get(r["registration_request_id"])
        if launch is None or launch.state != "succeeded":
            return
        managed = self.registry.get_window(launch.result)
        if managed is None:
            return
        if managed.placement == "not_requested":
            if managed.presence != "present":
                return
            self.registry.set_placement(managed.window_uuid, "pending")
            managed = self.registry.get_window(managed.window_uuid)
        target = r.get("placement_uuid")
        if target is not None and target != managed.window_uuid:
            r["state"] = "ERROR"
            r["detail"] = "placement UUID differs from positively registered UUID"
        if managed.placement != "pending":
            return
        if (r["state"] == "OK" and target == managed.window_uuid
                and managed.presence == "present"):
            self.registry.set_placement(managed.window_uuid, "succeeded")
        elif r["state"] == "ERROR":
            self.registry.set_placement(managed.window_uuid, "failed")

    def _advance_placement(self, removed_uuid=None):
        """Resolve VERIFYING from exact-UUID KWin observations or deadline.

        KWin's resident already emits changed/removed events on geometry and
        desktop changes. No arbitrary sleeps or JS timer API are needed.
        """
        r = self.request
        if r is None or r["state"] != "VERIFYING":
            return
        identifier = r["placement_uuid"]
        if r["observation_source"] != self.observation_source:
            r["state"] = "ERROR"
            r["detail"] = "resident observation source changed during placement"
        elif removed_uuid == identifier:
            r["state"] = "ERROR"
            r["detail"] = "target window disappeared during placement"
        else:
            observed = self.observed_windows.get(identifier)
            if observed is not None:
                geo = observed["geometry"]
                desired = all(geo[key] == r[key]
                              for key in ("x", "y", "width", "height"))
                desktop_ok = (observed["desktops"] == [r["desktop"]]
                              and not observed["on_all_desktops"])
                if desired and desktop_ok:
                    r["state"] = "OK"
                    r["detail"] = (f'{r["kind"]}: {observed["caption"]} '
                                   f'(pid={observed["pid"]}) '
                                   f'before={r["placement_before"]} '
                                   f'after=[{r["desktop"]}] '
                                   f'({geo["x"]},{geo["y"]}) '
                                   f'{geo["width"]}x{geo["height"]} '
                                   f'tiled={str(r["placement_tiled"]).lower()} '
                                   f'fullscreen={str(r["placement_fullscreen"]).lower()}')
            if (r["state"] == "VERIFYING" and
                    time.monotonic() >= r["created"] + 15.0):
                observed = self.observed_windows.get(identifier)
                actual = "window not observed"
                if observed is not None:
                    actual = (f'desktops={observed["desktops"]} '
                              f'geometry={observed["geometry"]}')
                r["state"] = "ERROR"
                r["detail"] = "placement confirmation timed out: " + actual
        if r["state"] in ("OK", "ERROR"):
            self._sync_managed_placement()

    @dbus.service.method(IFACE, in_signature="sss", out_signature="")
    def Complete(self, request_id, result, detail):
        """KWin reports accepted assignment; broker confirms observed state.

        Preserve existing OK/ERROR messages for legacy callers and tests.
        VERIFY is an additive result, with an exact KWin UUID and diagnostics.
        """
        r = self.request
        if r is None or r["id"] != request_id or r["state"] != "RUNNING":
            raise dbus.DBusException("Unknown or inactive request",
                                     name=IFACE + ".InvalidRequest")
        if result not in ("OK", "ERROR", "VERIFY"):
            raise dbus.DBusException("Invalid completion result",
                                     name=IFACE + ".BadArguments")
        if result == "VERIFY":
            try:
                payload = json.loads(detail)
                identifier = str(uuid.UUID(payload["window_uuid"]))
                before = payload["before"]
                if (not isinstance(before, str) or len(before) > 256
                        or not isinstance(payload["tiled"], bool)
                        or not isinstance(payload["fullscreen"], bool)):
                    raise ValueError("invalid placement detail")
            except (KeyError, TypeError, ValueError, AttributeError) as exc:
                raise dbus.DBusException("Invalid placement verification",
                                         name=IFACE + ".BadArguments") from exc
            if not self.observation_synced:
                r["state"] = "ERROR"
                r["detail"] = "KWin observation is not synchronized"
            else:
                r["state"] = "VERIFYING"
                r["placement_uuid"] = identifier
                r["placement_before"] = before
                r["placement_tiled"] = payload["tiled"]
                r["placement_fullscreen"] = payload["fullscreen"]
                r["observation_source"] = self.observation_source
                self._advance_placement()
        else:
            r["state"] = result
            r["detail"] = str(detail)[:1024]
        self._sync_managed_placement()

    @dbus.service.method(IFACE, in_signature="s", out_signature="s")
    def Status(self, request_id):
        self._advance_placement()
        r = self.request
        if r is None or r["id"] != request_id:
            return "UNKNOWN"
        return r["state"] + (" " + r["detail"] if r["detail"] else "")

    # Step 1.4d: a launch-intent interface, NOT an arbitrary registration API.
    # The broker alone creates registration records, after exact PID/UUID
    # correlation; clients cannot provide a window UUID or managed ID.
    @dbus.service.method(IFACE, in_signature="siiiiii", out_signature="s")
    def SubmitManagedLaunch(self, app_class, desktop, slot, x, y, width, height):
        """Atomically arm placement and broker-owned managed correlation."""
        if not isinstance(slot, int) or isinstance(slot, bool) or not 1 <= slot <= 256:
            raise dbus.DBusException("Invalid launch slot", name=IFACE + ".BadArguments")
        previous_request = self.request
        placement_id = self._submit("launch", desktop, x, y, width, height, app_class)
        try:
            registration_id = self._begin_managed_launch(
                expected_class=app_class,
                recipe={"desktop": int(desktop), "slot": int(slot),
                        "program": str(app_class), "mode": "local", "target": ""})
        except RegistryError as exc:
            # Both arms must succeed or neither may remain active. Since D-Bus
            # dispatch is single-threaded here, no resident event can consume
            # the newly created placement request before this method returns.
            self.request = previous_request
            raise dbus.DBusException(str(exc), name=IFACE + ".InvalidRequest") from exc
        self.request["registration_request_id"] = registration_id
        return json.dumps({"placement_request_id": placement_id,
                           "registration_request_id": registration_id}, sort_keys=True)

    @dbus.service.method(IFACE, in_signature="si", out_signature="")
    def SetManagedLaunchPid(self, request_id, pid):
        """Supply the freshly spawned child's PID; never choose a KWin UUID."""
        if not isinstance(pid, int) or isinstance(pid, bool) or pid <= 0:
            raise dbus.DBusException("Invalid launch PID", name=IFACE + ".BadArguments")
        try:
            self._set_managed_launch_pid(request_id, pid)
        except RegistryError as exc:
            raise dbus.DBusException(str(exc), name=IFACE + ".InvalidRequest") from exc

    @dbus.service.method(IFACE, in_signature="s", out_signature="s")
    def PollManagedLaunch(self, request_id):
        """Report privately verified registration; caller supplies no UUID."""
        return json.dumps(self._poll_managed_launch(request_id), sort_keys=True)


    # Step 1.3b.1: a read-only launch correlation probe. It does not replace
    # SubmitLaunch/TakeLaunch, move a window or grant managed ownership.
    @dbus.service.method(IFACE, in_signature="ss", out_signature="s")
    def BeginCorrelation(self, expected_class, title_token):
        """Snapshot KWin identities before the caller launches its command."""
        expected_class = str(expected_class).strip()
        if (not expected_class or len(expected_class) > 128
                or len(title_token) > 128):
            raise dbus.DBusException("Invalid correlation hints",
                                     name=IFACE + ".BadArguments")
        if not self.observation_synced or not self.observation_source:
            raise dbus.DBusException("Wait for KWin inventory synchronization",
                                     name=IFACE + ".NotSynchronized")
        now = time.monotonic()
        self._expire_managed_correlation(now)
        if (self._managed_correlation is not None
                and self._managed_correlation["state"] == "PENDING"):
            raise dbus.DBusException("A managed launch is already active",
                                     name=IFACE + ".Busy")
        if (self.correlation is not None
                and self.correlation["state"] not in
                ("MATCHED", "AMBIGUOUS", "TIMEOUT", "STALE_SOURCE")
                and now < self.correlation["deadline"]):
            raise dbus.DBusException("A correlation probe is already active",
                                     name=IFACE + ".Busy")
        request_id = uuid.uuid4().hex
        self.correlation = self._new_correlation(
            request_id, expected_class, title_token)
        return request_id

    def _new_correlation(self, request_id, expected_class, title_token):
        """Broker-owned correlation snapshot; no ownership implied."""
        now = time.monotonic()
        return {
            "id": request_id, "expected_class": expected_class,
            "title_token": str(title_token), "pid": None,
            "source": self.observation_source,
            "baseline": set(self.observed_windows),
            "event_floor": self.observation_sequence,
            "created": now, "deadline": now + 15.0,
            "first_unique": None, "first_unique_at": None,
            "state": "PENDING", "result": None,
        }

    def _expire_managed_correlation(self, now=None):
        """Release an expired, unpolled private launch without adoption.

        An interrupted launch caller must not hold the broker's one active
        registry request forever. Only this broker-private transaction can be
        expired here; the public diagnostic correlation remains independent.
        """
        c = self._managed_correlation
        if c is None or c["state"] != "PENDING":
            return
        if now is None:
            now = time.monotonic()
        if now < c["deadline"]:
            return
        self.registry.finish_failed(c["id"], "timeout", "TIMEOUT")
        c["state"] = "TIMEOUT"
        c["managed_result"] = {"state": "timeout", "request_id": c["id"],
                               "detail": "TIMEOUT"}

    def _begin_managed_launch(self, *, expected_class, recipe, run_id=None,
                              title_token=""):
        """Internal-only launch intent; the public probe cannot authorize it.

        A trusted broker-side launch orchestrator will call this before
        launching an application (Step 1.5). No D-Bus entry point yet exists.
        """
        expected_class = str(expected_class).strip()
        if not expected_class or len(expected_class) > 128 or len(title_token) > 128:
            raise RegistryError("invalid managed correlation hints")
        if (self.correlation is not None
                and self.correlation["state"] == "PENDING"
                and time.monotonic() < self.correlation["deadline"]):
            raise RegistryError("diagnostic correlation is still active")
        self._expire_managed_correlation()
        if (self._managed_correlation is not None
                and self._managed_correlation["state"] == "PENDING"):
            raise RegistryError("managed correlation is still active")
        request_id = uuid.uuid4().hex
        self.registry.begin_launch(
            request_id, source=self.observation_source,
            synchronized=self.observation_synced,
            baseline=self.observed_windows, recipe=recipe, run_id=run_id)
        self._managed_correlation = self._new_correlation(
            request_id, expected_class, title_token)
        return request_id

    def _set_managed_launch_pid(self, request_id, pid):
        """Private launch-PID handoff; never use public SetCorrelationPid."""
        c = self._managed_correlation
        if (c is None or c["id"] != request_id or c["pid"] is not None
                or c["state"] != "PENDING" or time.monotonic() >= c["deadline"]):
            raise RegistryError("inactive managed correlation")
        self.registry.mark_running(request_id, pid)
        c["pid"] = pid

    def _poll_managed_launch(self, request_id):
        """Internal-only correlation, registration and terminal reporting."""
        c = self._managed_correlation
        if c is None or c["id"] != request_id:
            return {"state": "UNKNOWN"}
        if "managed_result" in c:
            return deepcopy(c["managed_result"])
        result = json.loads(self._poll_correlation(c))
        outcome = result["state"]
        if outcome == "MATCHED":
            try:
                managed = self.registry.register_match(
                    request_id, result, current_windows=self.observed_windows,
                    source=self.observation_source,
                    synchronized=self.observation_synced)
            except RegistryError as exc:
                self.registry.finish_failed(request_id, "failed", str(exc))
                answer = {"state": "failed", "request_id": request_id,
                          "detail": str(exc)}
            else:
                self._sync_managed_placement()
                answer = {"state": "registered", "request_id": request_id,
                          "managed_id": managed.managed_id,
                          "window_uuid": managed.window_uuid}
        elif outcome in ("AMBIGUOUS", "TIMEOUT", "STALE_SOURCE"):
            terminal = {"AMBIGUOUS": "ambiguous", "TIMEOUT": "timeout",
                        "STALE_SOURCE": "failed"}[outcome]
            self.registry.finish_failed(request_id, terminal, outcome)
            answer = {"state": terminal, "request_id": request_id,
                      "detail": outcome}
        else:
            return {"state": "pending", "request_id": request_id}
        c["managed_result"] = answer
        return deepcopy(answer)

    @dbus.service.method(IFACE, in_signature="si", out_signature="")
    def SetCorrelationPid(self, request_id, pid):
        """Record the shell-spawned child PID after the process starts."""
        c = self.correlation
        if (c is None or c["id"] != request_id or c["pid"] is not None
                or c["state"] != "PENDING" or time.monotonic() >= c["deadline"]
                or not isinstance(pid, int) or isinstance(pid, bool) or pid <= 0):
            raise dbus.DBusException("Unknown, expired or invalid correlation",
                                     name=IFACE + ".InvalidRequest")
        c["pid"] = int(pid)

    def _correlation_class_candidates(self, c):
        """Describe retained new-class observations; never decide ownership.

        An addition event proves this UUID was *observed* after the request
        began. It does NOT prove that the request caused the window. Read the
        latest snapshot for a living UUID, or the last removal snapshot for a
        closed one, while retaining the original addition's event identity.
        """
        results = []
        seen = set()
        for event in self.observation_events:
            identifier = event["window_uuid"]
            if (event["event"] != "added"
                    or event["event_id"] <= c["event_floor"]
                    or identifier in c["baseline"] or identifier in seen):
                continue
            seen.add(identifier)
            current = self.observed_windows.get(identifier)
            details = current or event["window"]
            if current is None:
                # The window may already have closed. A retained removal
                # snapshot is newer than its addition snapshot, when present.
                for later in reversed(self.observation_events):
                    if (later["window_uuid"] == identifier
                            and later["event"] == "removed"
                            and later["event_id"] > event["event_id"]):
                        details = later["window"]
                        break
            # On some applications KWin learns the class only after the
            # windowAdded signal. Allow the latest or original class to
            # qualify, but neither is sufficient evidence of ownership.
            expected = c["expected_class"]
            if not (matches_class(expected, details["resource_class"],
                                  details["desktop_file"])
                    or matches_class(expected, event["window"]["resource_class"],
                                     event["window"]["desktop_file"])):
                continue
            if c["pid"] is not None and details["pid"] == c["pid"]:
                evidence = "pid"
            elif c["title_token"] and c["title_token"] in details["caption"]:
                evidence = "class_title_hint"
            else:
                evidence = "class_only"
            results.append({
                "window_uuid": identifier,
                "pid": details["pid"],
                "event_id": event["event_id"],
                "currently_observed": current is not None,
                "evidence": evidence,
            })
        # observation_events is ordered by broker-local event_id; ordering
        # results likewise makes diagnostics stable across successive polls.
        return results

    @dbus.service.method(IFACE, in_signature="s", out_signature="s")
    def PollCorrelation(self, request_id):
        """Return current evidence; never infer ownership from a title/class."""
        c = self.correlation
        if c is None or c["id"] != request_id:
            return json.dumps({"state": "UNKNOWN"})
        return self._poll_correlation(c)

    def _poll_correlation(self, c):
        """One evaluator for diagnostic and broker-private correlation."""
        if c["result"] is not None:
            return json.dumps(c["result"], sort_keys=True)

        def finish(state, **fields):
            # Terminal results are stable for this broker-local request ID.
            c["state"] = state
            c["result"] = dict(state=state, request_id=c["id"], **fields)
            return json.dumps(c["result"], sort_keys=True)

        if not self.observation_synced or c["source"] != self.observation_source:
            return finish("STALE_SOURCE", class_candidates=[],
                          candidate_history_complete=False)
        # The diagnostic list is independent of the exact-PID selection path.
        # Do not promote class/timing matches into a MATCHED or AMBIGUOUS state.
        diagnostic = {
            "class_candidates": self._correlation_class_candidates(c),
            "candidate_history_complete": (
                self.observation_evicted_through <= c["event_floor"]),
        }
        # A "changed" event does not establish window creation. Only a UUID
        # from an "added" lifecycle record after BeginCorrelation is eligible.
        # The history is bounded: if the record was evicted, fail closed.
        fresh_ids = {
            e["window_uuid"] for e in self.observation_events
            if e["event"] == "added" and e["event_id"] > c["event_floor"]
        }
        candidates = {
            identifier: details
            for identifier, details in self.observed_windows.items()
            if (identifier not in c["baseline"] and identifier in fresh_ids
                and matches_class(c["expected_class"],
                                  details["resource_class"], details["desktop_file"]))
        }
        # PID is direct evidence worth testing, but it is not a universal
        # identity contract: a shell child may exec, fork or delegate a window.
        by_pid = sorted(identifier for identifier, w in candidates.items()
                        if c["pid"] is not None and w["pid"] == c["pid"])
        # A unique visible title is a useful diagnostic HINT, not proof.
        by_title = sorted(identifier for identifier, w in candidates.items()
                          if c["title_token"] and c["title_token"] in w["caption"])
        if len(by_pid) > 1:
            return finish("AMBIGUOUS", candidates=by_pid, evidence="pid",
                          **diagnostic)
        now = time.monotonic()
        if len(by_pid) == 1 and diagnostic["candidate_history_complete"]:
            # Permit another same-PID KWin window to arrive before returning
            # a unique diagnostic match (the probe never enrolls ownership).
            # If lifecycle events were evicted during the probe, a different
            # matching window may be missing: do not assert uniqueness.
            if c["first_unique"] != by_pid[0]:
                c["first_unique"] = by_pid[0]
                c["first_unique_at"] = now
            elif now - c["first_unique_at"] >= 0.5:
                return finish("MATCHED", window_uuid=by_pid[0],
                              pid=c["pid"], evidence="pid", **diagnostic)
        else:
            c["first_unique"] = None
            c["first_unique_at"] = None
        if now >= c["deadline"]:
            return finish("TIMEOUT", title_hints=by_title,
                          pid_candidates=by_pid, **diagnostic)
        return json.dumps({"state": "PENDING", "request_id": c["id"],
                           "pid_candidates": by_pid,
                           "title_hints": by_title,
                           **diagnostic}, sort_keys=True)


    def _bound_observation_events(self):
        """Limit lifecycle history and remember whether a probe lost events."""
        if len(self.observation_events) > 128:
            dropped = self.observation_events[:-128]
            self.observation_evicted_through = dropped[-1]["event_id"]
            del self.observation_events[:-128]

    def _refresh_registered_window(self, identifier, details):
        """Reconcile one existing registration, never adopt an observed UUID."""
        record = self.registry.managed_windows.get(identifier)
        if record is None:
            return
        if details is None:
            self.registry.set_presence(identifier, "missing")
        elif record.presence == "present":
            # PID changes or a mismatched identity are cause for uncertainty,
            # not for trusting an observation as a replacement registration.
            if details["pid"] != record.observation["pid"]:
                self.registry.set_presence(identifier, "uncertain")
            else:
                self.registry.set_presence(identifier, "present", details)
        # A previously missing/uncertain record cannot be re-adopted by an
        # inventory refresh or a later class/title/UUID observation.

    # Step 1.3a: KWin's resident reports facts, not ownership decisions.
    # One JSON string avoids altering the six established move/launch methods.
    # The new signature 's' means one string arrives on the session bus;
    # out_signature='' means there is no reply value. The sender is not yet
    # authenticated as KWin, so observations must NEVER authorize closes.
    @staticmethod
    def _normalized_window(details):
        """Validate/copy a KWin snapshot before changing any broker state."""
        identifier = str(uuid.UUID(details["uuid"]))
        geometry = details["geometry"]
        if (not isinstance(details["pid"], int) or isinstance(details["pid"], bool)
                or not isinstance(details["desktops"], list)
                or not isinstance(details["on_all_desktops"], bool)
                or not all(isinstance(details[field], str) for field in
                           ("resource_class", "resource_name", "desktop_file", "caption"))
                or not all(isinstance(geometry[field], (int, float)) and
                           not isinstance(geometry[field], bool) for field in
                           ("x", "y", "width", "height"))):
            raise ValueError("invalid observation fields")
        # Never mutate the dictionary supplied by a caller in-place.
        return dict(details, uuid=identifier)

    @staticmethod
    def _source_revision(message):
        """Read an optional resident source/revision pair as one unit."""
        source = message.get("source")
        revision = message.get("revision")
        if source is None and revision is None:
            return None  # Older diagnostic clients; never proof of ownership.
        if (not isinstance(source, str) or not (1 <= len(source) <= 96)
                or not isinstance(revision, int) or isinstance(revision, bool)
                or revision < 1):
            raise ValueError("invalid observation source/revision")
        return source, revision

    @dbus.service.method(IFACE, in_signature="s", out_signature="")
    def ObserveWindow(self, payload):
        # Preserve the existing single-string method and payload-size bound.
        if len(payload) > 4096:
            raise dbus.DBusException("Observation too large", name=IFACE + ".BadArguments")
        try:
            message = json.loads(payload)
            event = message["event"]
            if event not in ("existing", "added", "changed", "removed"):
                raise ValueError("invalid observation event")
            details = self._normalized_window(message["window"])
            source_revision = self._source_revision(message)
        except (TypeError, ValueError, KeyError, AttributeError) as exc:
            raise dbus.DBusException("Malformed window observation",
                                     name=IFACE + ".BadArguments") from exc

        identifier = details["uuid"]
        if source_revision is not None:
            source, revision = source_revision
            # A newly loaded resident must establish itself with a complete
            # inventory before we accept its incremental events. Conversely,
            # drop delayed messages belonging to the prior resident instance.
            if self.observation_source is None:
                self.observation_source = source
            if source != self.observation_source or revision <= self.observation_revision:
                return
            self.observation_revision = revision
        elif self.observation_synced:
            # Legacy, unsequenced calls cannot supersede synchronized state.
            return
        if event == "existing" and identifier in self.observed_windows:
            # A manual refresh republishes every live window. Update current
            # state, but do NOT fabricate another window-creation event.
            self.observed_windows[identifier] = details
            self._refresh_registered_window(identifier, details)
            self._advance_placement()
            return

        # Only allocate an ID for a retained lifecycle record or change
        # summary. A sequence is unique within one broker process, but is
        # deliberately not a durable or globally unique event identity.
        self.observation_sequence += 1
        record = {"event_id": self.observation_sequence,
                  "event": event, "window_uuid": identifier,
                  "window": details}

        if event == "changed":
            # Keep one most-recent update per live window. The counter shows
            # how many incoming change reports that entry summarizes. It
            # covers geometry, desktops, captions and other observed fields.
            before = self.observation_changes.get(identifier)
            record["change_count"] = (before["change_count"] + 1
                                      if before else 1)
            self.observation_changes[identifier] = record
            self.observed_windows[identifier] = details
            self._refresh_registered_window(identifier, details)
            self._advance_placement()
            return

        if event == "removed":
            # Drop the live state and coalesced changes. The removal event
            # retains KWin's last known snapshot; never treat that as live.
            self.observed_windows.pop(identifier, None)
            self.observation_changes.pop(identifier, None)
        else:
            self.observed_windows[identifier] = details
        self._refresh_registered_window(
            identifier, None if event == "removed" else details)
        self._advance_placement(removed_uuid=identifier if event == "removed" else None)

        # 'existing', 'added' and 'removed' cannot be evicted by dragging.
        # This is still a bounded diagnostic history, NOT an audit log.
        self.observation_events.append(record)
        self._bound_observation_events()

    # A whole inventory is one D-Bus method call and one broker replacement.
    # Per-window "existing" updates are not an atomic inventory boundary:
    # this snapshot also removes any stale UUIDs left by a missed removal.
    @dbus.service.method(IFACE, in_signature="s", out_signature="")
    def SyncInventory(self, payload):
        if len(payload) > 262144:
            raise dbus.DBusException("Inventory too large", name=IFACE + ".BadArguments")
        try:
            message = json.loads(payload)
            source_revision = self._source_revision(message)
            if source_revision is None:
                raise ValueError("inventory requires source/revision")
            source, revision = source_revision
            windows = message["windows"]
            if not isinstance(windows, list) or len(windows) > 512:
                raise ValueError("invalid inventory length")
            # Validate the entire inventory in a temporary map. Failure must
            # leave the old state untouched, rather than half-synchronized.
            replacement = {}
            for item in windows:
                details = self._normalized_window(item)
                identifier = details["uuid"]
                if identifier in replacement:
                    raise ValueError("duplicate UUID in inventory")
                replacement[identifier] = details
        except (TypeError, ValueError, KeyError, AttributeError) as exc:
            raise dbus.DBusException("Malformed window inventory",
                                     name=IFACE + ".BadArguments") from exc

        if source == self.observation_source and revision <= self.observation_revision:
            return  # Old/out-of-order inventory; do not roll back live changes.
        # A different resident instance replaces the source after a KWin
        # reload. These UUIDs are still *observed*, never managed windows.
        source_changed = (self.observation_source is not None
                          and source != self.observation_source)
        if source != self.observation_source:
            self.observation_changes.clear()
        self.observation_source = source
        self.observation_revision = revision
        self.observation_synced = True
        # Do not invent "removed" events for entries absent in the snapshot:
        # such entries could predate a broker restart or a missed notification.
        previous = set(self.observed_windows)
        self.observed_windows = replacement
        for identifier in list(self.observation_changes):
            if identifier not in replacement:
                self.observation_changes.pop(identifier, None)
            else:
                self.observation_changes[identifier]["window"] = replacement[identifier]
        # A full inventory is not a launch and never allocates managed IDs.
        # Keep "existing" history limited to genuinely newly discovered UUIDs.
        for identifier, details in replacement.items():
            if identifier not in previous:
                self.observation_sequence += 1
                self.observation_events.append({
                    "event_id": self.observation_sequence, "event": "existing",
                    "window_uuid": identifier, "window": details})
        self._bound_observation_events()
        # An inventory replacement never invents new ownership. A new resident
        # source invalidates prior managed evidence even if UUIDs recur.
        for identifier in list(self.registry.managed_windows):
            if source_changed:
                self.registry.set_presence(identifier, "uncertain")
            else:
                self._refresh_registered_window(
                    identifier, self.observed_windows.get(identifier))
        self._advance_placement()

    # Read-only diagnostic query. Output is JSON, not a public management
    # registry: class, caption and PID are observational hints only.
    @dbus.service.method(IFACE, in_signature="", out_signature="s")
    def ListObserved(self):
        # Preserve the familiar 'events' shape for existing jq consumers.
        # Its contents are a merge of independently bounded lifecycle
        # history and latest-per-UUID change summaries, ordered by event_id.
        changes = list(self.observation_changes.values())
        events = sorted(self.observation_events + changes,
                        key=lambda record: record["event_id"])
        return json.dumps({"windows": list(self.observed_windows.values()),
                           "events": events,
                           "lifecycle_events": self.observation_events,
                           "changes": changes,
                           "sync": {"complete": self.observation_synced,
                                    "source": self.observation_source,
                                    "revision": self.observation_revision}}, sort_keys=True)


    # Step 1.4c: read-only managed-window queries. The returned JSON is an
    # explicit allowlist, never a serialization of recipes or registry objects.
    @staticmethod
    def _managed_summary(record):
        return {"managed_id": record.managed_id,
                "window_uuid": record.window_uuid,
                "request_id": record.request_id,
                "run_id": record.run_id,
                "presence": record.presence,
                "placement": record.placement,
                "connection": record.connection}

    @dbus.service.method(IFACE, in_signature="", out_signature="s")
    def ListManaged(self):
        """List only positively registered windows in managed-ID order."""
        records = sorted(self.registry.managed_windows.values(),
                         key=lambda item: int(item.managed_id[4:]))
        return json.dumps({"count": len(records),
                           "windows": [self._managed_summary(item)
                                       for item in records]}, sort_keys=True)

    @dbus.service.method(IFACE, in_signature="s", out_signature="s")
    def GetManaged(self, identifier):
        """Look up a managed ID or KWin UUID; unknown is not ownership."""
        if not isinstance(identifier, str) or not (1 <= len(identifier) <= 128):
            raise dbus.DBusException("Invalid managed-window identifier",
                                     name=IFACE + ".BadArguments")
        try:
            record = self.registry.get_window(identifier)
        except RegistryError:
            record = None
        if record is None:
            return json.dumps({"state": "UNKNOWN"}, sort_keys=True)
        detail = self._managed_summary(record)
        # Observation is last-known if presence is missing or uncertain.
        # A KWin observation may contain extra fields. Do not forward them.
        observed = record.observation
        geometry = observed["geometry"]
        detail["observation"] = {
            "pid": observed["pid"],
            "resource_class": observed["resource_class"],
            "desktop_file": observed["desktop_file"],
            "caption": observed["caption"][:256],
            "desktops": list(observed["desktops"]),
            "on_all_desktops": observed["on_all_desktops"],
            "geometry": {key: geometry[key]
                         for key in ("x", "y", "width", "height")},
        }
        return json.dumps({"state": "FOUND", "window": detail}, sort_keys=True)

    @dbus.service.method(IFACE, in_signature="", out_signature="s")
    def RegistryStatus(self):
        """Return in-memory registry counts and observer synchronization."""
        presence = {state: 0 for state in ("present", "missing", "uncertain")}
        for record in self.registry.managed_windows.values():
            presence[record.presence] += 1
        requests = {state: 0 for state in
                    ("pending", "running", "succeeded", "failed",
                     "timeout", "ambiguous")}
        for request in self.registry.requests.values():
            requests[request.state] += 1
        return json.dumps({
            "managed_count": len(self.registry.managed_windows),
            "presence_counts": presence,
            "request_count": len(self.registry.requests),
            "request_counts": requests,
            "observation": {
                "synchronized": self.observation_synced,
                "source": self.observation_source,
                "revision": self.observation_revision,
                "observed_count": len(self.observed_windows),
            },
        }, sort_keys=True)


# Unlike BUS/PATH/IFACE above, these identifiers address KWin's *own*
# D-Bus scripting service, which we use to load our resident JavaScript.
# The defaults are packaging locations; the user OpenRC configuration may
# override them and passes the resolved values through environment variables.
KWIN_BUS = "org.kde.KWin"
KWIN_SCRIPTING = "org.kde.kwin.Scripting"
KWIN_SCRIPT = "org.kde.kwin.Script"
RESIDENT_DEFAULT = "/usr/share/joetoo-kwin/joetoo-kwin-resident.js"
SCRIPT_NAME_DEFAULT = "joetoo-bridge"


class ResidentCoordinator:
    """Load the resident in KWin, never supervise KWin or user applications."""
    # This object is a D-Bus *client*, not another public joetoo method set.
    # A live Python reference keeps the coordinator/timer handlers available
    # while the GLib event loop runs.

    def __init__(self, bus, broker=None):
        # The same existing graphical user's session bus is shared with the
        # Broker; there must not be a separate daemon or KWin process here.
        self.bus = bus
        # Keep a reference to diagnostic sync completion for bounded retries.
        self.broker = broker
        self.file = os.environ.get("JOETOO_KWIND_RESIDENT_JS", RESIDENT_DEFAULT)
        self.name = os.environ.get("JOETOO_KWIND_SCRIPT_NAME", SCRIPT_NAME_DEFAULT)
        # GLib timers have numeric source IDs. None means no timer is queued.
        # last_error suppresses printing the same retry failure repeatedly.
        self.timer = None
        self.last_error = None
        if not os.path.isabs(self.file) or not self.name:
            raise RuntimeError("Resident script path must be absolute and script name nonempty")

    def start(self):
        # Subscribe to the session bus daemon's NameOwnerChanged notifications.
        # arg0 restricts delivery to changes concerning org.kde.KWin. This is
        # event-driven; no separate process continuously polls for restarts.
        self.bus.add_signal_receiver(
            self._owner_changed, signal_name="NameOwnerChanged",
            dbus_interface="org.freedesktop.DBus", bus_name="org.freedesktop.DBus",
            path="/org/freedesktop/DBus", arg0=KWIN_BUS)
        # Schedule first initialization after returning to the event loop.
        # The argument is milliseconds, not seconds.
        self._schedule(1)

    def _owner_changed(self, name, old_owner, new_owner):
        # D-Bus supplies the old/new connection owners. They are not used
        # here: owner disappearance or replacement simply schedules a retry.
        if name == KWIN_BUS:
            if self.broker is not None:
                self.broker.observation_synced = False
            # KWin owns the script. A fresh KWin owner needs initialization.
            self._schedule(1)

    def _schedule(self, delay_ms):
        # Cancel the previously scheduled GLib callback, if one exists, so
        # multiple owner-change signals cannot accumulate duplicate retries.
        if self.timer is not None:
            GLib.source_remove(self.timer)
        # timeout_add registers _attempt as an event-loop callback and
        # returns the ID needed to cancel the pending call later.
        self.timer = GLib.timeout_add(delay_ms, self._attempt)

    def _attempt(self):
        # This callback executes on the GLib main loop. The scheduled source
        # has fired; clear its ID before either retrying or reporting success.
        self.timer = None
        try:
            result = self.ensure_loaded()
            # A newly started script reports its inventory at initialization;
            # one that survived the Python broker restart needs an explicit
            # refresh, otherwise quiet preexisting windows remain invisible.
            if result == "reused":
                self.request_inventory_refresh()
        except (OSError, RuntimeError, dbus.DBusException) as exc:
            # KWin, its D-Bus interface, or our resident file may not yet be
            # ready. Log a changed error once, then retry in five seconds.
            detail = str(exc)
            if detail != self.last_error:
                print(f"joetoo-kwind: resident unavailable: {detail}",
                      file=sys.stderr, flush=True)
            self.last_error = detail
            self._schedule(5000)
        else:
            self.last_error = None
            print(f"joetoo-kwind: KWin resident {result}: {self.name}", flush=True)
            # Invocation returns before the resident's asynchronous inventory
            # reaches us. If it is still absent, recheck/retry in one second.
            if self.broker is not None and not self.broker.observation_synced:
                self._schedule(1000)
        # SOURCE_REMOVE tells GLib not to automatically repeat *this* timer;
        # _schedule explicitly creates another only when necessary.
        return GLib.SOURCE_REMOVE

    def ensure_loaded(self):
        """Return 'reused' or 'started', without creating duplicate scripts."""
        # Resolve KWin's scripting object, then bind to its named interface.
        # introspect=False avoids an extra D-Bus introspection round trip;
        # each method call has its own bounded timeout (in seconds).
        proxy = self.bus.get_object(KWIN_BUS, "/Scripting", introspect=False)
        scripting = dbus.Interface(proxy, KWIN_SCRIPTING)
        # Presence is not identical to *running*: a script manually loaded
        # without a subsequent `run()` may exist but not execute callbacks.
        # Reuse prevents duplicate handler registrations during broker restart.
        if scripting.isScriptLoaded(self.name, timeout=5):
            return "reused"
        # Only inspect the configured file if a new load is required.
        # isfile() checks its type; access(..., R_OK) checks readability.
        if not os.path.isfile(self.file) or not os.access(self.file, os.R_OK):
            raise RuntimeError(f"resident script is not readable: {self.file}")
        # loadScript registers a named KWin script and returns an object ID.
        # Registering alone does *not* execute the script; `run()` comes next.
        script_id = int(scripting.loadScript(self.file, self.name, timeout=5))
        if script_id < 0:
            if scripting.isScriptLoaded(self.name, timeout=5):
                return "reused"  # Someone else registered it first.
            raise RuntimeError("KWin refused resident load")
        # An f-string inserts the numeric ID into the object path used by
        # KWin's per-script run method (e.g. /Scripting/Script3).
        script_path = f"/Scripting/Script{script_id}"
        script_proxy = self.bus.get_object(KWIN_BUS, script_path, introspect=False)
        try:
            dbus.Interface(script_proxy, KWIN_SCRIPT).run(timeout=10)
        except dbus.DBusException:
            # If starting a script we *just loaded* fails, remove that named
            # registration so a later attempt can try cleanly.
            # Only undo a script this instance created; never unload another's.
            scripting.unloadScript(self.name, timeout=5)
            raise
        return "started"

    def request_inventory_refresh(self):
        """Invoke the resident's existing no-hotkey refresh action via D-Bus."""
        proxy = self.bus.get_object("org.kde.kglobalaccel", "/component/kwin",
                                    introspect=False)
        accel = dbus.Interface(proxy, "org.kde.kglobalaccel.Component")
        # This is the same KGlobalAccel action already tested manually on
        # X11 and Wayland; it does not restart KWin or application processes.
        accel.invokeShortcut("joetoo_bridge_observe", timeout=5)


def main():
    try:
        # Fail early unless this is a real non-root user graphical session.
        validate_session_environment()
        # Connect dbus-python to GLib so its method calls and callbacks are
        # dispatched by the same event loop as our signal handlers/timers.
        DBusGMainLoop(set_as_default=True)
        bus = dbus.SessionBus()
        # Request exclusive ownership of our broker service name. If another
        # broker already owns it, fail rather than waiting in the D-Bus queue.
        name = dbus.service.BusName(BUS, bus=bus, do_not_queue=True)
        # Keep this object reachable throughout loop.run(): otherwise a
        # garbage-collected object could no longer serve the six methods.
        broker = Broker(name)  # noqa: F841 - hold D-Bus object for lifetime
        resident = ResidentCoordinator(bus, broker)
        loop = GLib.MainLoop()
        resident.start()

        def graceful_shutdown():
            # Stop this broker's event loop only. Do not terminate KWin,
            # the resident script, or Konsole/SSH processes owned by the user.
            loop.quit()
            return GLib.SOURCE_REMOVE

        # Register the same callback for termination and interrupt signals.
        # OpenRC stop sends a signal to the broker, not to managed windows.
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM,
                             graceful_shutdown)
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGINT,
                             graceful_shutdown)
        print(f"Ready on session bus: {BUS} {PATH}", flush=True)
        # This blocks, dispatching user D-Bus messages and timer callbacks,
        # until graceful_shutdown() asks the loop to quit.
        loop.run()
        return 0
    except (RuntimeError, dbus.DBusException) as exc:
        print(f"joetoo-kwind: {exc}", file=sys.stderr, flush=True)
        return 1


# Python sets __name__ to "__main__" when executing this file directly;
# importing it (e.g. in tests) must not start a live D-Bus broker.
# sys.exit propagates main()'s zero/nonzero result to OpenRC.
if __name__ == "__main__":
    sys.exit(main())
