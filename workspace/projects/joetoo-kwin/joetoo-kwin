# joetoo-kwin - ordinary-user CLI for the session's KWinBridge broker.
# Bash owns option/configuration policy, confirmation and human reporting.
# The broker/resident own managed identity, placement and close verification;
# remote adapters and persistence helpers own their distinct resource/data work.
# Local window success is never proof of SSH/RDP/VNC authentication or usability.
#
# Bash is required: arrays, dynamic local scope, process substitution, coproc,
# here-strings and allocated FDs below are not portable POSIX-shell syntax.
# Configuration is trusted executable Bash. The CLI deliberately avoids the
# header's app_configure workflow and its unrelated account-state side effects.
# No functions run on mere definition, but sourcing this executable runs its
# footer: inspect/extract definitions for tests rather than sourcing it live.

# shellcheck source=./script_header_joetoo.shellcheck_filtered_stub
source /usr/sbin/script_header_joetoo

PN=${0##*/}
# BUILD currently comes from joetoolkit, with a checkout fallback. A package-
# specific BUILD source is separate release work, not an implicit version here.
# BUILD is consumed indirectly by show_config through varlist.
# shellcheck disable=SC2034
if [ -f /etc/joetoolkit/BUILD ]; then . /etc/joetoolkit/BUILD; else BUILD="0.0.1"; fi
[ -z "$verbosity" ] && verbosity="${notice}"

#-----[ variables ]-------------------------------------------------------------------------------------

# Session-bus address: well-known service, object path, method interface.
# Service/interface names intentionally match; the object path is distinct.
# These identify the broker, not a remote server or a managed-window owner.
bus=org.joetoo.KWinBridge
path=/org/joetoo/KWinBridge
iface=org.joetoo.KWinBridge

#-----[ functions ]-------------------------------------------------------------------------------------

usage() # Print this CLI's recipe, operation and option synopsis
{
    j_msg "-${notice}" -p 'Configured recipes include dolphin|sftp|sftp://[USER@]HOST[:PORT][/ABSOLUTE/PATH][|LAYER]; inspect authentication/listing in Dolphin'
    j_msg "-${notice}" -p 'SDL RDP recipe: sdl-freerdp|rdp|rdp://USER@HOST[:PORT][|LAYER]; local placement is independent of remote login'
    j_msg "-${notice}" -p 'TigerVNC recipe: vncviewer|ssh|ssh://[USER@]HOST[:SSH_PORT]/display/N (or /port/P); both forwarded endpoints use loopback'
    j_msg "-${notice}" -p "Usage: ${PN} [-v|-q ...] -c [-f CONFIG]  (dry run; trusted Bash config)"
    j_msg "-${notice}" -p "       CONFIG: XDG user configuration, then /etc/joetoo-kwin/joetoo-kwin.conf; set screen_width/screen_height explicitly"
    j_msg "-${notice}" -p "       User file: \${XDG_CONFIG_HOME:-\$HOME/.config}/joetoo-kwin/joetoo-kwin.conf (relative XDG values ignored)"
    j_msg "-${notice}" -p "Usage: ${PN} [-f CONFIG] -m [DESKTOP] l|r"
    j_msg "-${notice}" -p "       ${PN} -m DESKTOP | DESKTOP X Y | [DESKTOP] X Y WIDTH HEIGHT"
    j_msg "-${notice}" -p "       ${PN} move DESKTOP X Y WIDTH HEIGHT  (compatibility)"
    j_msg "-${notice}" -p "       ${PN} test-launch CLASS DESKTOP X Y WIDTH HEIGHT -- PROGRAM [ARG ...]"
    j_msg "-${notice}" -p "       ${PN} test-multi-launch  (TEST ONLY: register 4 local Konsoles)"
    j_msg "-${notice}" -p "       ${PN} -h"
    j_msg "-${notice}" -p "       ${PN} -o [-f CONFIG] (confirm and initialize configured desktop groups)"
    j_msg "-${notice}" -p "       ${PN} [-f CONFIG] -L DESKTOP PROGRAM MODE TARGET [over|under] (one managed window; omitted layer is over)"
    j_msg "-${notice}" -p "       -L panel is not implemented; under is one-shot, not persistent keep-below"
    j_msg "-${notice}" -p "       ${PN} [-v|-q ...] -l (read-only managed inventory, including missing reservations)"
    j_msg "-${notice}" -p "       ${PN} [-v|-q ...] -s (read-only broker registry status)"
    j_msg "-${notice}" -p "       ${PN} [-v|-q ...] -i MANAGED_ID (read-only details of one managed record)"
    j_msg "-${notice}" -p "       ${PN} [-f CONFIG] -d MANAGED_ID (confirmed graceful close; record/slot retained)"
    j_msg "-${notice}" -p "       ${PN} [-f CONFIG] -x (confirmed progressive clean sweep; verified registrations/slots retired)"
    j_msg "-${notice}" -p "       ${PN} [-f CONFIG] -S (save timestamped managed recipes/policy; not manual geometry)"
    j_msg "-${notice}" -p "       ${PN} -r (validate, confirm and launch new instances from last-good recipes)"
}
# @usage usage
# @ret Returns the final j_msg status; output follows header verbosity.
# @deps j_msg
# @vars Reads PN and notice; overrides the header's usage function.
# @note Does not load configuration, launch applications or exit itself.

# Retain the positional move/test grammar. getopts handles common options and
# clusters, stopping at -m/-L so mission operands are not parsed as options.
parse_cmdline() # Separate common options from the selected mission and operands
{
    local _pc_opt
    OPTIND=1
    cli_operation=""
    config=""
    CONFIG_SELECTED=$FALSE
    cli_verbosity=()
    case ${1:-} in
        move|test-launch|test-multi-launch|--help)
            cli_operation=$1; shift; cli_args=("$@"); return 0 ;;
    esac
    while getopts ':cmof:vqhLxdsSlir' _pc_opt; do
        case $_pc_opt in
            v|q) cli_verbosity+=("$_pc_opt") ;;
            f) config=$OPTARG; CONFIG_SELECTED=$TRUE ;;
            c|m|o|h|L|x|d|s|S|l|i|r)
                [[ -z $cli_operation ]] || { bad_args 'select exactly one operation'; return 2; }
                cli_operation=-$_pc_opt
                [[ $_pc_opt != m && $_pc_opt != L ]] || break ;;
            :) bad_args "option -${OPTARG} requires a value"; return 2 ;;
            *) bad_args "unknown option -${OPTARG}"; return 2 ;;
        esac
    done
    shift "$((OPTIND - 1))"
    cli_args=("$@")
    [[ -n $cli_operation ]] || { bad_args 'select an operation'; return 2; }
    if [[ $CONFIG_SELECTED && $cli_operation != -c && $cli_operation != -o && $cli_operation != -m && $cli_operation != -L && $cli_operation != -d && $cli_operation != -x && $cli_operation != -S ]]; then
        bad_args '-f is supported only with -c, -o, -L, -d, -x, -S or layout movement'; return 2
    fi
    if [[ $cli_operation == -L ]]; then
        validate_single_operands "$@" || return $?
    elif [[ $cli_operation == -d ]]; then
        [[ $# == 1 && $1 =~ ^win-[0-9]{3,}$ ]] || { bad_args '-d requires one MANAGED_ID such as win-001'; return 2; }
    elif [[ $cli_operation == -i ]]; then
        [[ $# == 1 && $1 =~ ^win-[0-9]{3,}$ && ${#1} -le 128 && $1 == *[1-9]* ]] || {
            bad_args '-i requires one canonical MANAGED_ID such as win-001'; return 2; }
    elif [[ $cli_operation != -m && $# != 0 ]]; then
        bad_args 'unexpected operands'; return 2
    fi
    return 0
}
# @usage parse_cmdline [OPTIONS] OPERATION [OPERANDS...]
# @opts -v/-q accumulate; -f FILE selects a plan; exactly one operation.
# @args All CLI arguments, preserving shell argument boundaries.
# @ret 0 on accepted structure; 2 with usage on argument errors.
# @deps getopts, bad_args, validate_single_operands
# @vars Sets OPTIND/OPTARG, cli_operation, cli_args, cli_verbosity, config,
# @append CONFIG_SELECTED; uses header TRUE/FALSE pseudo-booleans.
# @rule Common options must precede -m/-L operands; getopts stops there.
# @note Legacy move/test commands and --help are recognized in the first
# @append positional argument.
# @note Recipe semantics, executability and broker eligibility are checked
# @append later.

# Structural checks protect the shared pipe-recipe representation
# Semantic recipe/target validation is in validate_plan and launch_preflight
validate_single_operands() # Check -L field boundaries and its supported layer vocabulary
{
    local _so_name _so_value _so_i=0
    local -a _so_names=(DESKTOP PROGRAM MODE TARGET LAYER)
    # DESKTOP PROGRAM MODE TARGET are not optional
    (( $# == 4 || $# == 5 )) || { bad_args '-L requires DESKTOP PROGRAM MODE TARGET [over|under] as separate arguments'; return 2; }
    # iterate args and validate each
    for _so_value in "$@"; do
        _so_name=${_so_names[$_so_i]}; _so_i=$((_so_i + 1))
        if [[ $_so_value == *'|'* || $_so_value == *[$'\001'-$'\037'$'\177']* ]]; then
            # 001 = 0x01 SOH Start of Heading; # 037 = 0x1F US  Separator; # 177 = 0x7F DEL Delete
            bad_args "-L: $_so_name is redacted; expected one recipe field without pipe/control characters"; return 2
        fi
    done
    # The '-' default applies only to an absent fifth argument. Unlike ':-',
    # it does not turn an explicitly empty layer into over; empty is rejected.
    # LAYER is optional (default to over)
    case ${5-over} in
        over|under) ;;
        panel) bad_args '-L: layer panel is not implemented yet'; return 2 ;;
        *) bad_args '-L: invalid LAYER (redacted); expected over, under or omission'; return 2 ;;
    esac
}
# @usage validate_single_operands DESKTOP PROGRAM MODE TARGET [LAYER]
# @args Four or five separate fields; omitted layer means over.
# @ret 0 for accepted structure/layer; 2 with a redacted diagnostic otherwise.
# @deps bad_args
# @rule Reject pipes and ASCII control characters before joining fields.
# @note Does not validate desktop range, target semantics or slot ownership.

config_path_present() # Distinguish an absent config path from an inaccessible location
{
    # Distinguish absence from an unsearchable parent. An inaccessible optional
    # layer must not disappear merely because test -e cannot stat its pathname.
    local _cpp_path=$1 _cpp_parent=${1%/*} _cpp_next
    [[ ! -e $_cpp_path && ! -L $_cpp_path ]] || return 0
    [[ $_cpp_parent != "$_cpp_path" ]] || _cpp_parent=.
    while [[ ! -e $_cpp_parent && ! -L $_cpp_parent ]]; do
        [[ $_cpp_parent != / && $_cpp_parent != . ]] || break
        _cpp_next=${_cpp_parent%/*}
        [[ $_cpp_next != "$_cpp_parent" ]] || _cpp_next=.
        _cpp_parent=${_cpp_next:-/}
    done
    if [[ ! -d $_cpp_parent || ! -x $_cpp_parent ]]; then
        j_msg "-${err}" -p "Configuration location inaccessible [$_cpp_path]"; return 2
    fi
    return 1
}
# @usage config_path_present PATH
# @args $1: configuration pathname; relative paths use the invocation
# @append directory.
# @ret 0 if path or symlink exists, including a dangling symlink.
# @ret 1 if absent beneath an accessible directory; 2 if location inaccessible.
# @deps j_msg; Bash pathname tests and parameter expansion
# @vars Reads PN and err.
# @note Presence is not readability or syntax validation; callers check those.

select_config() # Select one per-run plan without hiding inaccessible configuration
{
    [[ ! $CONFIG_SELECTED ]] || return 0
    local _sc_presence _sc_home=${XDG_CONFIG_HOME:-$HOME/.config} _sc_user _sc_system=/etc/joetoo-kwin/joetoo-kwin.conf
    [[ $_sc_home == /* ]] || _sc_home=$HOME/.config
    _sc_user=$_sc_home/joetoo-kwin/joetoo-kwin.conf
    if config_path_present "$_sc_user"; then config=$_sc_user; return 0
    else _sc_presence=$?; (( _sc_presence == 1 )) || return "$_sc_presence"; fi
    if config_path_present "$_sc_system"; then config=$_sc_system; return 0
    else _sc_presence=$?; (( _sc_presence == 1 )) || return "$_sc_presence"; fi
    [[ ${1:-} != optional ]] || { config=""; return 0; }
    j_msg "-${err}" -p "No configuration: create [$_sc_user] or select -f CONFIG; system fallback [$_sc_system] absent"
    return 2
}
# @usage select_config [optional]
# @args optional: allow no selected plan when both default candidates are
# @append absent.
# @ret 0 on explicit/located selection or permitted absence; 2 on lookup error.
# @deps config_path_present, j_msg
# @vars Reads CONFIG_SELECTED, XDG_CONFIG_HOME, HOME; sets config.
# @rule Explicit -f wins; otherwise XDG user plan precedes /etc fallback.
# @note Relative XDG_CONFIG_HOME is ignored; no profile/link is changed.

prepare_config_sources() # Collect and precheck configuration layers without sourcing them
{
    # Resolve paths before sourcing trusted files. Source in the existing caller
    # scope, so Bash declarations retain their pre-layering behavior.
    local _cs_home=${XDG_CONFIG_HOME:-$HOME/.config} _cs_file _cs_presence
    [[ $_cs_home == /* ]] || _cs_home=$HOME/.config
    select_config "${1:-}" || return $?
    # -g makes the array global even though this helper is called from other
    # functions. Only path selection happens here; source runs in the caller.
    declare -ga config_sources=()
    for _cs_file in /etc/joetoo-kwin/defaults.conf "$_cs_home/joetoo-kwin/defaults.conf"; do
        if config_path_present "$_cs_file"; then config_sources+=("$_cs_file")
        else _cs_presence=$?; (( _cs_presence == 1 )) || return "$_cs_presence"; fi
    done
    # source searches PATH for bare filenames. Anchor relative selections to
    # the invocation's directory, matching the file checked by -f and bash -n.
    if [[ -n $config || $CONFIG_SELECTED ]]; then
        if [[ $config == /* ]]; then config_sources+=("$config")
        else config_sources+=("./$config"); fi
    fi
    # Check every selected file before executing any of them. Do not echo its
    # contents: syntax diagnostics could otherwise disclose a malformed target.
    for _cs_file in "${config_sources[@]}"; do
        if [[ ! -f $_cs_file || ! -r $_cs_file ]]; then
            j_msg "-${err}" -p "${PN}: configuration unreadable [$_cs_file]"; return 2
        fi
        if ! bash -n -- "$_cs_file" >/dev/null 2>&1; then
            j_msg "-${err}" -p "Invalid configuration syntax [$_cs_file]"; return 2
        fi
    done
}
# @usage prepare_config_sources [optional]
# @args optional: allow no per-run plan, while retaining optional defaults.
# @ret 0 after successful checks; propagates selection errors; 2 for bad files.
# @deps select_config, config_path_present, bash -n, j_msg
# @vars Selects config; reads CONFIG_SELECTED, XDG_CONFIG_HOME, HOME.
# @vars Replaces global config_sources with ordered pathnames.
# @rule Order is system defaults, user defaults, selected per-run plan.
# @rule Present unreadable or invalid layers are errors, never silent fallback.
# @note Callers source trusted Bash in their own scope; this is no sandbox.

apply_cli_verbosity() # Replay ordered -v/-q overrides after effective configuration
{
    local _acv_opt
    if [[ ! $verbosity =~ ^[0-7]$ ]]; then
        j_msg "-${err}" -p "${PN}: verbosity must be between 0 and 7"; return 2
    fi
    # The header supplies the helper; its macro is normally set by process_cmdline.
    _pc_adjust_verbosity="verbosity=\$(( verbosity \${_pc_operator} 1 ))"
    for _acv_opt in "${cli_verbosity[@]}"; do
        case $_acv_opt in v) _pc_operator=+ ;; q) _pc_operator=- ;; esac
        _pc_action_verbosity || return $?
    done
    unset -v _pc_adjust_verbosity _pc_operator
    return 0
}
# @usage apply_cli_verbosity
# @ret 0 on completion; 2 for invalid verbosity; propagates helper failure.
# @deps _pc_action_verbosity, j_msg
# @vars Reads cli_verbosity; validates/mutates verbosity.
# @vars Temporarily sets then unsets _pc_adjust_verbosity and _pc_operator.
# @note The escaped macro is evaluated by the header, not by this assignment.
# @note Header policy supplies clamping and the interactive verbosity floor.

# Keep the supervised action's status distinct from the reporting bitmask.
plan_stage() # Announce an action and report its captured status independently
{
    local _ps_level=$1 _ps_label=$2 _ps_action_rc
    shift 2
    # Validators may emit diagnostics. Use the output-producing AAR form so
    # their messages cannot interrupt an unfinished announcement/result line.
    j_msg "-${_ps_level}" -p "${_ps_label} ..."
    if "$@"; then _ps_action_rc=0; else _ps_action_rc=$?; fi
    j_msg "-${_ps_level}" -pn "${_ps_label} result:"
    report_action "$_ps_action_rc" "$_ps_level"
}
# @usage plan_stage LEVEL LABEL COMMAND [ARGS...]
# @args $1: header severity; $2: operator label; remaining arguments: command.
# @ret report_action result; preserves action failure ahead of reporting
# @append failure.
# @deps j_msg, report_action; the supplied command/function
# @vars Reads header messaging globals; command may mutate caller-visible
# @append state.
# @note Quoted "$@" executes directly in this shell, without eval or subshell.

# Report the captured action status; reporting faults must not mask action failure.
report_action() # Keep the operation result separate from the presentation bitmask
{
    local _ps_action_rc=$1 _ps_level=$2 _ps_report_rc
    if handle_result "$_ps_action_rc" completed failed "$_ps_level"; then
        _ps_report_rc=0
    else
        _ps_report_rc=$?
    fi
    if (( _ps_report_rc & ~1 )); then
        j_msg "-${err}" -p "${PN}: result reporting failed [${_ps_report_rc}]"
        decode_right_status "$_ps_report_rc"
    fi
    (( _ps_action_rc == 0 )) || return "$_ps_action_rc"
    (( _ps_report_rc == 0 )) || return 1
    return 0
}
# @usage report_action ACTION_RC LEVEL
# @args $1: already captured operation status; $2: reporting severity.
# @ret Original nonzero ACTION_RC; otherwise 1 for reporting failure, else 0.
# @deps handle_result, decode_right_status, j_msg
# @vars Reads PN, err and header reporting globals.
# @note Bit 0 reports action failure; higher bits indicate reporting faults.
# @rule Do not replace the original action failure with a reporting bitmask.

check_plan() # Load effective policy, validate and render a dry-run or launch plan
{
    local _cp_script_dir _cp_layer _cp_single_slot _cp_record
    _cp_script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P) || return 1
    # Current lookup is source-tree-relative; packaged-path integration is separate.
    # shellcheck source=/home/joe/joetoo-ai/workspace/projects/joetoo-kwin/libexec/joetoo-kwin-plan-functions
    source "${_cp_script_dir}/libexec/joetoo-kwin-plan-functions" || return 1
    plan_defaults
    prepare_config_sources || return $?
    # This is executable, trusted Bash, as in the legacy tool. It is not a sandbox.
    # Defaults precede config; CLI verbosity overrides are deliberately applied last.
    for _cp_layer in "${config_sources[@]}"; do
        # shellcheck source=/dev/null
        source "$_cp_layer" || { j_msg "-${err}" -p "Configuration source failed [$_cp_layer]"; return 2; }
    done
    apply_cli_verbosity || return $?
    # Bash dynamic scope exposes open_plan's local _op_single* context here.
    # This avoids a second single-launch parser or geometry calculation.
    # -L retains all selected configuration settings, replacing recipe intent only.
    if [[ ${_op_single:-} ]]; then
        printf -v _cp_record '%s|%s|%s|%s|%s' "${_op_single_fields[@]:0:4}" "${_op_single_fields[4]:-over}"
        desktop_session_list=("$_cp_record")
        desktop_session_frames=() # A one-recipe -L uses ordinary graphical policy.
    fi
    plan_stage "$notice" 'Validating configured launch intent' validate_plan || return $?
    if [[ ${_op_single:-} ]]; then
        validate_launch_recipe_pair "${planned_program[0]}" "${planned_mode[0]}" || return $?
        _cp_single_slot=$(list_managed_windows slot "${planned_desktop[0]}") || return $?
        next_slot[${planned_desktop[0]}]=$((_cp_single_slot - 1))
    fi
    plan_stage "$info" 'Calculating shared geometry' calculate_plan || return $?
    # bool.* and rlv.* are show_config formatting selectors, not Bash variable
    # names. In particular rlv.config uses the header's long-path rendering.
    # Explicit varlist avoids unrelated workflow/status-file initialization.
    local notice_varlist="PN BUILD rlv.config screen_width screen_height"
    local info_varlist="snapshot_history_depth verbosity desktop_limit dt_win_limit min_window_exposure_px"
    info_varlist+=" terminal_width_percent terminal_gap_percent terminal_height_percent terminal_left_percent terminal_top_percent terminal_row_gap_percent"
    info_varlist+=" graphical_left_percent graphical_top_percent graphical_width_percent graphical_height_percent"
    info_varlist+=" rdp_registration_timeout_ms rdp_windowing_backend rdp_security_protocol rdp_certificate_policy rdp_x11_renderer rdp_remote_width rdp_remote_height bool.RDP_SMART_SIZING rdp_initial_client_width rdp_initial_client_height"
    info_varlist+=" vnc_viewer_ready_timeout_ms bool.sftp_advisory_enabled sftp_advisory_timeout_ms sftp_advisory_ssh_port"
    local debug_varlist="snapshot_validation_timeout_ms initial_focus_timeout_ms initial_focus_poll_interval_ms single_lower_settle_ms sftp_capability_timeout_ms"
    debug_varlist+=" rdp_registration_poll_ms rdp_registration_event_limit rdp_registration_window_limit rdp_backend_log_byte_limit rdp_x11_identity_settle_ms"
    debug_varlist+=" vnc_ssh_start_timeout_ms vnc_supervisor_poll_interval_ms vnc_cleanup_timeout_ms vnc_local_port_attempts vnc_identity_event_limit vnc_identity_settle_ms vnc_dbus_timeout_ms vnc_placement_timeout_ms vnc_identity_start_timeout_ms"
    debug_varlist+=" managed_close_timeout_ms managed_close_total_timeout_ms managed_close_prepare_timeout_ms managed_close_x11_grab_ms managed_close_poll_ms managed_close_dbus_timeout_ms"
    local varlist
    [[ ${1:-} != launch ]] || launch_preflight || return $?
    varlist="$notice_varlist"
    show_config || die "failed to show_config for notice_varlist"
    # d_do returns success after evaluation; handle rendering failures inside it.
    varlist="$info_varlist"
    # Keep this literal until d_do evaluates it, using the current varlist.
    # shellcheck disable=SC2016
    d_do 'j_msg "-${info}" -p "=====[ Additional Information ]==============="
        show_config || die "failed to show_config for info_varlist"
    ' "$info" || return $?
    # varlist is consumed by show_config through d_do/eval.
    # shellcheck disable=SC2034
    varlist="$debug_varlist"
    # shellcheck disable=SC2016
    d_do 'j_msg "-${debug}" -p "=====[ Additional Debug Information ]==============="
        show_config || die "failed to show_config for debug_varlist"
    ' "$debug" || return $?
    print_plan "${1:-dry-run}"
    # -c stops at this plan; open_plan continues with confirmation and launch.
}
# @usage check_plan [launch]
# @args launch: additionally run whole-plan launch_preflight before rendering.
# @ret Propagates validation/planning failures; final status is print_plan's.
# @deps plan-functions, prepare_config_sources, apply_cli_verbosity, plan_stage
# @append launch_preflight in launch mode; show_config, d_do, die, print_plan
# @vars Sets planner defaults/arrays and effective config globals via sourcing.
# @vars Reads _op_single/_op_single_fields from open_plan's dynamic scope.
# @req Source-tree-relative libexec helpers; trusted Bash configuration.
# @rule -L replaces recipe intent only, retains effective
# @append settings/reservations.
# @note This function does not confirm or spawn applications; open_plan does.
# @warn Trusted config can execute commands; dry-run is not a security sandbox.

bad_args() # Display an argument diagnostic and local usage synopsis
{
    j_msg "-${err}" -p "${PN}: $1"
    usage
    return 2
}
# @usage bad_args MESSAGE
# @args $1: application-authored diagnostic, redacted where input is sensitive.
# @ret 2, irrespective of message-rendering status.
# @deps j_msg, usage
# @vars Reads PN and err.
# @rule Do not pass arbitrary secret-bearing targets as MESSAGE.

validate_geometry() # Validate five legacy explicit move/launch geometry operands
{
    local _vg_arg _vg_positive
    for _vg_arg in "$@"; do
        if ! isint "$_vg_arg"; then
            j_msg "-${err}" -p "${PN}: invalid integer [${_vg_arg}]"
            return 2
        fi
    done
    for _vg_positive in "$1" "$4" "$5"; do
        # these arguments represent desktop number, window width, and height
        # each must be a valid decimal integer greater than zero
        #
        # isint rejects non-integer strings, but accepts negative integers
        # the second test ensures the number is strictly positive
        #
        # the || operator evaluates the second condition only if isint succeeds
        # negating the numeric comparison also rejects comparison errors,
        # including integers too large for the shell's numeric test
        if ! isint "$_vg_positive" || ! [ "$_vg_positive" -gt 0 ] ; then
            j_msg "-${err}" -p "${PN}: desktop, width and height must be positive"
            return 2
        fi
    done
    return 0
}
# @usage validate_geometry DESKTOP X Y WIDTH HEIGHT
# @ret 0 if all are integers and desktop/width/height are positive; else 2.
# @deps isint, j_msg
# @vars Reads PN and err.
# @req Caller supplies exactly five operands.
# @note This legacy check does not enforce broker ranges or desktop capacity.

wait_for_request() # Poll a placement request and report its terminal or missing result
{
    local _wr_request=$1 _wr_label=$2 _wr_attempt _wr_status _wr_rc=1 _wr_level=$err
    # Nominal sleep budget, excluding IPC latency: 50 polls at 100 ms.
    # The broker can terminate a request earlier; this is not its deadline.
    local _wr_limit="50" _wr_increment="0.1"
    # Launch and optional-move use 150 polls with the same sleep interval.
    [[ $_wr_label == launch || $_wr_label == optional-move ]] && _wr_limit=150
    for ((_wr_attempt=0; _wr_attempt<_wr_limit; _wr_attempt++)); do
         # kwin bus/svc, obj/path, inteface identifiers.method (together = address)
         # (call Status method with requested action as arg)
        if ! _wr_status=$(qdbus6 "$bus" "$path" "$iface.Status" "$_wr_request"); then
            _wr_status="${PN}: could not query request [${_wr_request}]"
            break
        fi
        case $_wr_status in
            OK*) _wr_rc=0; _wr_level=$notice; break ;;
            ERROR*|UNKNOWN*) break ;;
        esac
        sleep "$_wr_increment"
    done
    if (( _wr_attempt == _wr_limit )); then
        _wr_status="${PN}: ${_wr_label} timed out (request [${_wr_request}])"
    fi
    if [[ $_wr_label == optional-move ]]; then
        # move_window already opened the verification announcement. Close that
        # line once, then emit broker detail separately at info/error severity.
        local _wr_report_rc
        if report_action "$_wr_rc" "$notice"; then _wr_report_rc=0; else _wr_report_rc=$?; fi
        if (( _wr_rc == 0 )); then
            # Split the broker's identity from its frame detail; keep unfamiliar
            # status formats intact. Save captures before header helpers run.
            local _wr_identity _wr_frame
            if [[ $_wr_status =~ ^(.*[[:space:]]\(pid=[0-9]+\))[[:space:]](before=.*)$ ]]; then
                _wr_identity=${BASH_REMATCH[1]}; _wr_frame=${BASH_REMATCH[2]}
                j_msg "-${info}" -m "$_wr_identity"
                j_msg "-${info}" -m "$_wr_frame"
            else
                j_msg "-${info}" -m "$_wr_status"
            fi
        else
            j_msg "-${err}" -p "$_wr_status"
        fi
        j_msg "-${debug}" -p "Request [${_wr_request}]: status after [$((_wr_attempt + 1))] polls"
        return "$_wr_report_rc"
    else
        j_msg "-${_wr_level}" -p "$_wr_status"
        return "$_wr_rc"
    fi
}
# @usage wait_for_request REQUEST_ID LABEL
# @args $1: broker request ID; $2: move, optional-move or launch label.
# @ret 0 on observed OK, 1 on other results; optional-move uses report_action.
# @deps qdbus6 Status, sleep, report_action, j_msg
# @vars Reads bus, path, iface, PN and header severities.
# @note Nominal sleep budget is 5 s, or 15 s for launch/optional-move.
# @append D-Bus round trips add time; the broker owns its actual deadline.
# @note This poller does not cancel broker work or terminate application
# @append children.

# qdbus6 exposes error names as a first diagnostic line, not a structured
# exception API. Match only exact known names; always retain the original text.
report_move_submission_failure() # Explain known move submission errors while retaining their detail
{
    local _msf_detail=$1 _msf_name=${1%%$'\n'*}
    case $_msf_name in
        "Error: ${iface}.Busy")
            j_msg "-${err}" -p 'Move busy: previous placement request has not completed' ;;
        "Error: ${iface}.Unsupported"|'Error: org.freedesktop.DBus.Error.UnknownMethod'|'Error: org.freedesktop.DBus.Error.UnknownInterface'|\
        "Cannot find '${iface}.SubmitMove' in object ${path} at ${bus}")
            j_msg "-${err}" -p 'Optional moves require compatible broker and resident support' ;;
        "Error: ${iface}.BadArguments"|"Error: ${iface}.InvalidRequest"|'Error: org.freedesktop.DBus.Error.InvalidArgs')
            j_msg "-${err}" -p 'Move rejected: invalid request' ;;
        *) j_msg "-${err}" -p 'Move submission failed' ;;
    esac
    [[ -z $_msf_detail ]] || j_msg "-${err}" -p "$_msf_detail"
}
# @usage report_move_submission_failure DETAIL
# @args $1: captured qdbus6 diagnostic; only its first line selects a category.
# @ret Status of the final conditional/message; not a normalized failure code.
# @deps j_msg
# @vars Reads iface, path, bus and err.
# @note Full original detail is displayed after any recognized fixed
# @append diagnostic.

move_active_window() # Submit the five-field legacy move and invoke its resident shortcut
{
    local _ma_request
    validate_geometry "$@" || return $?
     # kwin bus/svc, obj/path, inteface identifiers.method (together = address)
     # (call Submit method, with all args args)
    _ma_request=$(qdbus6 "$bus" "$path" "$iface.Submit" "$@") || return 1
    # call Component.invokeShortcut with arg joetoo_bridge_move
    # (call the moveFromBroker function in joetoo-kwin-resident.js,
    #  which is registerd as "joetoo_bridge_move")
    qdbus6 org.kde.kglobalaccel /component/kwin \
        org.kde.kglobalaccel.Component.invokeShortcut \
        joetoo_bridge_move >/dev/null || return 1
    wait_for_request "$_ma_request" move
}
# @usage move_active_window DESKTOP X Y WIDTH HEIGHT
# @ret 2 on geometry validation error; 1 on IPC/status failure; 0 on
# @append observed OK.
# @deps validate_geometry, qdbus6 Submit/invokeShortcut, wait_for_request
# @vars Reads bus, path and iface.
# @note Resident chooses the active window when its shortcut executes.
# @rule This is not managed-ID authority and does not assign a managed slot.

# Normalize the six approved move forms before any D-Bus call. Omitted values
# use zero placeholders only with independent preservation flags on SubmitMove.
move_window() # Normalize six movement forms and preserve omitted frame components
{
    local _mw_desktop=0 _mw_x=0 _mw_y=0 _mw_width=0 _mw_height=0 _mw_side=""
    local _mw_PD=$FALSE _mw_PP=$FALSE _mw_PS=$FALSE _mw_value _mw_abs _mw_dir _mw_request
    case $# in
        1) case $1 in
               l|r) _mw_side=$1; _mw_PD=$TRUE ;;
               *) _mw_desktop=$1; _mw_PP=$TRUE; _mw_PS=$TRUE ;;
           esac ;;
        2) _mw_desktop=$1; _mw_side=$2
           [[ $_mw_side == l || $_mw_side == r ]] || { bad_args 'expected DESKTOP l|r'; return 2; } ;;
        3) _mw_desktop=$1; _mw_x=$2; _mw_y=$3; _mw_PS=$TRUE ;;
        4) _mw_PD=$TRUE; _mw_x=$1; _mw_y=$2; _mw_width=$3; _mw_height=$4 ;;
        5) _mw_desktop=$1; _mw_x=$2; _mw_y=$3; _mw_width=$4; _mw_height=$5 ;;
        *) bad_args 'invalid move operand count'; return 2 ;;
    esac
    for _mw_value in "$_mw_desktop" "$_mw_x" "$_mw_y" "$_mw_width" "$_mw_height"; do
        _mw_abs=${_mw_value#-}
        if ! isint "$_mw_value" || (( ${#_mw_abs} > 5 )); then
            bad_args 'move operands must be bounded decimal integers'; return 2
        fi
    done
    # Explicit decimal conversion preserves signed coordinates without octal parsing.
    for _mw_value in _mw_desktop _mw_x _mw_y _mw_width _mw_height; do
        # Indirect expansion reads the named local; printf -v writes back to
        # that local. 10# forces decimal, including values with leading zeroes.
        _mw_abs=${!_mw_value}
        if [[ $_mw_abs == -* ]]; then printf -v "$_mw_value" '%d' "$((-10#${_mw_abs#-}))"
        else printf -v "$_mw_value" '%d' "$((10#$_mw_abs))"; fi
    done
    if [[ ! $_mw_PD ]] && (( _mw_desktop < 1 || _mw_desktop > 256 )); then
        bad_args 'desktop must be between 1 and the available desktop count'; return 2
    fi
    if [[ $_mw_side ]]; then
        _mw_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P) || return 1
        # Current lookup is source-tree-relative; packaged-path integration is separate.
        # shellcheck source=/home/joe/joetoo-ai/workspace/projects/joetoo-kwin/libexec/joetoo-kwin-plan-functions
        source "${_mw_dir}/libexec/joetoo-kwin-plan-functions" || return 1
        plan_defaults
        prepare_config_sources || return $?
        # Trusted Bash config; CLI verbosity takes precedence after sourcing.
        local _mw_layer
        for _mw_layer in "${config_sources[@]}"; do
            # shellcheck source=/dev/null
            source "$_mw_layer" || { bad_args 'layout configuration source failed'; return 2; }
        done
        apply_cli_verbosity || return $?
        plan_stage "$info" 'Validating layout geometry' validate_layout_geometry || return $?
        if [[ $_mw_side == l ]]; then terminal_geometry 2 1 || return $?
        else terminal_geometry 2 2 || return $?; fi
        _mw_x=$geometry_x; _mw_y=$geometry_y; _mw_width=$geometry_width; _mw_height=$geometry_height
    else
        [[ ! $CONFIG_SELECTED ]] || { bad_args '-f requires a layout move (l/r)'; return 2; }
        apply_cli_verbosity || return $?
    fi
    if (( _mw_x < -32768 || _mw_x > 32768 || _mw_y < -32768 || _mw_y > 32768 )) ||
        { [[ ! $_mw_PS ]] && (( _mw_width < 1 || _mw_width > 32768 || _mw_height < 1 || _mw_height > 32768 )); }; then
        bad_args 'move position or size out of range'; return 2
    fi
    if (( $# == 5 )); then
        move_active_window "$_mw_desktop" "$_mw_x" "$_mw_y" "$_mw_width" "$_mw_height"
        return $?
    fi
    # These strings serialize D-Bus booleans. They intentionally differ from
    # Joetoo's TRUE=0/FALSE='' flags, whose truth is tested by string presence.
    local _mw_pd=false _mw_pp=false _mw_ps=false _mw_action_rc _mw_detail
    [[ ! $_mw_PD ]] || _mw_pd=true
    [[ ! $_mw_PP ]] || _mw_pp=true
    [[ ! $_mw_PS ]] || _mw_ps=true
    j_msg "-${notice}" -pn 'Submitting active-window move ...'
    if _mw_request=$(qdbus6 "$bus" "$path" "$iface.SubmitMove" \
        "$_mw_desktop" "$_mw_x" "$_mw_y" "$_mw_width" "$_mw_height" "$_mw_pd" "$_mw_pp" "$_mw_ps" 2>&1); then
        _mw_action_rc=0
    else
        _mw_action_rc=$?
    fi
    if ! report_action "$_mw_action_rc" "$notice"; then
        if (( _mw_action_rc != 0 )); then
            report_move_submission_failure "$_mw_request"
        fi
        return 1
    fi
    j_msg "-${notice}" -pn 'Invoking active-window move shortcut ...'
    if _mw_detail=$(qdbus6 org.kde.kglobalaccel /component/kwin \
        org.kde.kglobalaccel.Component.invokeShortcut joetoo_bridge_move_optional 2>&1); then
        _mw_action_rc=0
    else
        _mw_action_rc=$?
    fi
    if ! report_action "$_mw_action_rc" "$notice"; then
        [[ $_mw_action_rc == 0 || -z $_mw_detail ]] || j_msg "-${err}" -p "$_mw_detail"
        return 1
    fi
    j_msg "-${debug}" -p "Request [${_mw_request}]: preserveDesktop=${_mw_pd} preservePosition=${_mw_pp} preserveSize=${_mw_ps}"
    j_msg "-${notice}" -pn 'Verifying active-window move ...'
    wait_for_request "$_mw_request" optional-move
}
