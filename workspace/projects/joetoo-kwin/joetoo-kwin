# Snapshots are generated data, not copies of arbitrary executable config files.
save_managed_snapshot() # Export and publish the complete verified launch intent privately
{
    local _ss_dir _ss_text _ss_layer _ss_result
    _ss_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P) || return 1
    # Retention is current operator configuration, independent of launch intent
    # and of which authenticated managed windows belong to the complete save.
    # Current lookup is source-tree-relative; packaged-path integration is separate.
    # shellcheck source=/home/joe/joetoo-ai/workspace/projects/joetoo-kwin/libexec/joetoo-kwin-plan-functions
    source "$_ss_dir/libexec/joetoo-kwin-plan-functions" || return 1
    plan_defaults
    prepare_config_sources optional || return $?
    for _ss_layer in "${config_sources[@]}"; do
        # shellcheck source=/dev/null
        source "$_ss_layer" || return 2
    done
    apply_cli_verbosity || return $?
    validate_snapshot_history || return $?
    _ss_text=$(qdbus6 "$bus" "$path" "$iface.ExportManagedSnapshot") || return 1
    # The pipeline status is Python's: it validates the exported generated
    # configuration with this CLI's -c path before publishing a history entry.
    _ss_result=$(printf '%s\n' "$_ss_text" | python3 "$_ss_dir/libexec/joetoo_kwin_persistence.py" --save "$_ss_dir/joetoo-kwin" "$snapshot_history_depth") || return $?
    j_msg "-${notice}" -p "Last-good managed recipes saved privately [$(jq -r '.snapshot' <<< "$_ss_result")]; manual geometry and remote authentication are not saved"
    if jq -e '.migrated_legacy' <<< "$_ss_result" >/dev/null; then
        j_msg "-${notice}" -p "Prior regular last-good migrated to history; retention depth [$snapshot_history_depth] applies (depth 1 retains only the newest save)"
    fi
    if jq -e '.publication_warning' <<< "$_ss_result" >/dev/null; then
        j_msg "-${warn}" -p 'Snapshot published; directory durability unverified, so history was not pruned'
    elif jq -e '.pruning_warning' <<< "$_ss_result" >/dev/null; then
        j_msg "-${warn}" -p 'Snapshot published; history pruning incomplete; inspect the private history directory'
    fi
}
# @usage save_managed_snapshot
# @ret Propagates configuration/validation/save failures; path/export errors
# @append are 1.
# @deps plan-functions, qdbus6 ExportManagedSnapshot, jq, python3
# @append joetoo_kwin_persistence.py, apply_cli_verbosity, j_msg
# @vars Loads effective settings and config_sources; uses
# @append snapshot_history_depth.
# @rule Broker validates the full arrangement; helper validates generated
# @append recipes.
# @rule Save launch intent/policy, never runtime UUID/PID or manual geometry.
# @note Persistence helper owns atomic history publication and private modes.
# @note After publication, remaining status comes from the reporting block.

restore_managed_snapshot() # Validate last-good recipes and launch new instances via open_plan
{
    local _rs_dir _rs_file _rs_rc
    _rs_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P) || return 1
    _rs_file=$(mktemp "${XDG_RUNTIME_DIR:?}/joetoo-restore.XXXXXXXX.conf") || return 1
    # Single quotes defer file/status expansion until EXIT, while these
    # function-local names are still available. Save status before rm changes it.
    # The EXIT trap assigns its own saved status before cleanup.
    # shellcheck disable=SC2154
    trap '_rs_exit_rc=$?; rm -f -- "$_rs_file"; control_focus_on_exit "$_rs_exit_rc"' EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM HUP
    if ! python3 "$_rs_dir/libexec/joetoo_kwin_persistence.py" --restore > "$_rs_file"; then
        rm -f -- "$_rs_file"; trap - EXIT INT TERM HUP; return 2
    fi
    # Only generated/validated recipe assignments become executable config;
    # old UUIDs, connection state and arbitrary edited Bash are not restored.
    config=$_rs_file; CONFIG_SELECTED=$TRUE
    # Same configured launcher: lock, complete preflight, confirmation, new
    # children/identities and one shared initial-layout cohort per desktop.
    # Current lookup is source-tree-relative; packaged-path integration is separate.
    # shellcheck source=/home/joe/joetoo-ai/workspace/projects/joetoo-kwin/libexec/joetoo-kwin-launch-functions
    source "$_rs_dir/libexec/joetoo-kwin-launch-functions" || { rm -f -- "$_rs_file"; trap - EXIT INT TERM HUP; return 1; }
    if open_plan; then _rs_rc=0; else _rs_rc=$?; fi
    rm -f -- "$_rs_file"
    trap - EXIT INT TERM HUP
    return "$_rs_rc"
}
# @usage restore_managed_snapshot
# @ret 2 on snapshot-read failure; 1 on helper/temp-path setup failure.
# @ret Otherwise returns open_plan status, preserving ordinary launch outcomes.
# @deps mktemp, rm, python3 persistence helper, launch-functions/open_plan
# @vars Requires XDG_RUNTIME_DIR; sets config, CONFIG_SELECTED and launch
# @append state.
# @rule Restore launches new identities; never re-adopt saved UUIDs or PIDs.
# @note EXIT removes the temporary plan and chains control-focus completion.
# @warn Replaces then clears EXIT/INT/TERM/HUP traps; no general trap stacking.

# Best effort only: neither broker availability nor activation affects the
# mission's return code. The opaque handle can only restore the captured UUID.
# Report only fixed, application-authored diagnostics, never raw D-Bus text,
# the context handle, a caption, or other untrusted response fields.
control_focus_debug() # Print only allowlisted control-focus diagnostic categories
{
    local summary
    summary=$(jq -er '
        def allowed($values; $fallback): . as $v | if ($values | index($v)) != null then $v else $fallback end;
        (.state | allowed(["captured","skipped","requested","already_active","missing","off_desktop","minimized","unavailable"]; "unavailable")) as $state |
        (.reason | allowed(["unknown_context","coordination_busy","coordination_timeout","resident_unavailable","unavailable","no_active_window"]; "none")) as $reason |
        (.stage | allowed(["dispatch_pending","shortcut_returned","claim_accepted","completion_rejected"]; "none")) as $stage |
        "state=[\($state)] reason=[\($reason)] stage=[\($stage)]"' <<< "$2" 2>/dev/null) || summary='state=[unavailable] reason=[unavailable] stage=[none]'
    j_msg "-${debug}" -p "Control-window focus $1: $summary" || :
}
# @usage control_focus_debug PHASE RESPONSE_JSON
# @args $1: application-authored phase; $2: untrusted broker response or empty.
# @ret 0, even on parse or reporting failure.
# @deps jq, j_msg
# @vars Reads debug and header messaging policy.
# @rule Never print raw replies, UUIDs, captions or the context handle.
# @note Header DEBUG can force visibility; QUIET remains header-controlled.

control_focus_capture() # Capture the invocation's initial active UUID via an opaque handle
{
    local result
    control_focus_handle=''
    if ! command -v qdbus6 >/dev/null || ! command -v jq >/dev/null; then
        control_focus_debug capture ''; return 0
    fi
    result=$(qdbus6 "$bus" "$path" "$iface.ControlFocus" capture '' 2>/dev/null) || result=''
    control_focus_debug capture "$result"
    control_focus_handle=$(jq -er 'select(.state == "captured") | .handle |
        select(type == "string" and test("^[0-9a-f]{64}$"))' <<< "$result" 2>/dev/null) || control_focus_handle=''
    return 0
}
# @usage control_focus_capture
# @ret Always 0; missing dependencies/broker/capture are nonfatal.
# @deps qdbus6 ControlFocus, jq, control_focus_debug
# @vars Reads bus, path, iface; clears/sets global control_focus_handle.
# @rule Runs before mission execution; no permanent sender helper is created.
# @note Active window is the approved control context, not process ownership
# @append proof.

control_focus_restore() # Consume a saved handle and request eligible control activation once
{
    local result state
    [[ $control_focus_handle ]] || return 0
    result=$(qdbus6 "$bus" "$path" "$iface.ControlFocus" restore "$control_focus_handle" 2>/dev/null) || result=''
    control_focus_handle=''  # One attempt, including failure or unavailable broker.
    control_focus_debug restore "$result"
    state=$(jq -er '.state | select(. == "requested" or . == "already_active" or
        . == "missing" or . == "off_desktop" or . == "minimized")' <<< "$result" 2>/dev/null) || state=unavailable
    j_msg "-${info}" -p "Control-window focus: [$state]" || :
    return 0
}
# @usage control_focus_restore
# @ret Always 0; focus outcome never substitutes for mission status.
# @deps qdbus6 ControlFocus, jq, control_focus_debug, j_msg
# @vars Reads bus, path, iface, info; consumes control_focus_handle.
# @rule Resident skips missing/minimized/off-desktop/already-active control
# @append windows.
# @note Normal KWin activation may raise the control window after mission
# @append layout.
# @note requested means activation requested, not verified keyboard input.

# Header confirmation/die helpers may exit directly. Preserve that original
# status while completing ordinary exits; signal exits keep their old cleanup
# behavior and must not initiate a new activation exchange.
# Called indirectly by EXIT traps, including the temporary restore-file trap.
# shellcheck disable=SC2329
control_focus_on_exit() # Preserve exit status while completing ordinary control-focus cleanup
{
    local original_rc=$1
    if (( original_rc != 130 && original_rc != 143 )); then
        control_focus_restore
    fi
    return "$original_rc"
}
# @usage control_focus_on_exit ORIGINAL_RC
# @args $1: status captured before EXIT cleanup; not a pseudo-boolean.
# @ret Exactly ORIGINAL_RC, independent of restoration success.
# @deps control_focus_restore
# @rule Skip activation for status 130 (INT) or 143 (TERM and HUP).
# @note HUP deliberately shares the TERM exit status in this CLI.

# Main dispatch follows all definitions. Ordinary returns reach the explicit
# focus completion below; direct header exits use EXIT, signals retain cleanup.
# run as regular user, not root
checknotroot

# Parsing validates command structure before the best-effort control capture.
# Capture is a graphical query; even -c/-s/-l/-i may later restore activation.
parse_cmdline "$@" || exit $?
control_focus_capture
trap 'control_focus_on_exit "$?"' EXIT
# Config-sensitive missions apply verbosity after their own configuration load.
# Other missions apply it here; preserve the order of repeated -v/-q options.
if [[ $cli_operation != -S && $cli_operation != -c && $cli_operation != -o && $cli_operation != -r && $cli_operation != -L && $cli_operation != -m && $cli_operation != move ]]; then apply_cli_verbosity || exit $?; fi
set -- "$cli_operation" "${cli_args[@]}"
case ${1:-} in
    -m|move)
        shift
        move_window "$@" ;;
    test-launch)
        shift
        if (( $# < 8 )); then bad_args 'test-launch requires a class, geometry and program'; exit 2; fi
        launch_one_window "$@" ;;
    test-multi-launch)
        shift
        if (( $# != 0 )); then bad_args 'test-multi-launch accepts no operands'; exit 2; fi
        test_multi_launch ;;
    -h|--help) usage ;;
    -o) action="open";   # open multiple windows
        launch_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P) || exit 1
        # Current lookup is source-tree-relative; packaged-path integration is separate.
        # shellcheck source=/home/joe/joetoo-ai/workspace/projects/joetoo-kwin/libexec/joetoo-kwin-plan-functions
        source "$launch_dir/libexec/joetoo-kwin-launch-functions" || exit 1
        open_plan ;;
    -L) action="launch";
        shift
        # shellcheck source=/home/joe/joetoo-ai/workspace/projects/joetoo-kwin/libexec/joetoo-kwin-launch-functions
        source "$(dirname -- "${BASH_SOURCE[0]}")/libexec/joetoo-kwin-launch-functions" || exit 1
        open_plan "$@" ;;
    -d|-x)
        close_managed_windows "${1}" "${2:-}" ;;
    -c) action="check";   # validate configuration
        check_plan ;;
    -s) action="status";   # read-only broker snapshot
        readonly_managed_query status ;;
    -S) action="save";   # save current managed window configuration
        save_managed_snapshot ;;
    -r) restore_managed_snapshot ;;
    -l) action="list";   # list managed windows
        list_managed_windows ;;
    -i) action="info";   # read-only managed record, no selection/adoption
        readonly_managed_query "$action" "${2}" ;;
    *) bad_args 'unrecognized operation'; exit 2 ;;
esac

# Capture the mission result before reporting/restoration can overwrite $?.
# Restoration consumes its handle, so the EXIT hook cannot activate twice.
mission_rc=$?
control_focus_restore
exit "$mission_rc"
