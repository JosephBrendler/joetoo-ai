# shellcheck source=/home/joe/joetoo-ai/workspace/projects/joetoo-kwin/joetoo-kwin_shellcheck_stub
source /usr/sbin/script_header_joetoo

PN=${0##*/}
# BUILD is consumed indirectly by show_config through varlist.
# shellcheck disable=SC2034
if [ -f /etc/joetoolkit/BUILD ]; then . /etc/joetoolkit/BUILD; else BUILD="0.0.1"; fi
[ -z "$verbosity" ] && verbosity="${notice}"

#-----[ variables ]-------------------------------------------------------------------------------------

# kwin bus/svc, obj/path, inteface identifiers (together = address) for the bridge --
# servicename (represents app connection to a bus) is analagous to network hostname. form: dot-separated
bus=org.joetoo.KWinBridge
# object path (identify and group objects many:1 in rel to services) is analagous to URL. form: slash-separated
path=/org/joetoo/KWinBridge
# interface (set of callable methods) is analagous to plugin identifier. form: dot-separated
iface=org.joetoo.KWinBridge
# the org.joetoo.KWinBridge methods are implemented in the Python broker (libexec/joetoo-kwind)
# the KWin resident JavaScript (joetoo-kwin-resident.js) callsthose methods to retrieve requests
# and report placement results

#-----[ functions ]-------------------------------------------------------------------------------------

usage() {
    j_msg "-${notice}" -p 'Configured recipes include dolphin|sftp|sftp://[USER@]HOST[:PORT][/ABSOLUTE/PATH][|LAYER]; inspect authentication/listing in Dolphin'
    j_msg "-${notice}" -p 'SDL RDP recipe: sdl-freerdp|rdp|rdp://USER@HOST[:PORT][|LAYER]; local placement is independent of remote login'
    j_msg "-${notice}" -p 'TigerVNC recipe: vncviewer|ssh|ssh://[USER@]HOST[:SSH_PORT]/display/N (or /port/P); both forwarded endpoints use loopback'
    j_msg "-${notice}" -p "Usage: ${PN} [-v|-q ...] -c [-f CONFIG]  (dry run; trusted Bash config)"
    j_msg "-${notice}" -p "       CONFIG: XDG user configuration, then /etc/joetoo-kwin/joetoo-kwin.conf; set screen_width/screen_height explicitly"
    j_msg "-${notice}" -p "       User file: \${XDG_CONFIG_HOME:-\$HOME/.config}/joetoo-kwin/joetoo-kwin.conf (relative XDG values ignored)"
    j_msg "-${notice}" -p "Usage: ${PN} [-f CONFIG] -m [DESKTOP] l|r"
    j_msg "-${notice}" -p "       ${PN} -m DESKTOP | DESKTOP X Y | [DESKTOP] X Y WIDTH HEIGHT"
    j_msg "-${notice}" -p "       ${PN} move DESKTOP X Y WIDTH HEIGHT  (compatibility)"
    j_msg "-${notice}" -p "       ${PN} test-launch CLASS DESKTOP X Y WIDTH HEIGHT -- PROGRAM [ARG ...]"
    j_msg "-${notice}" -p "       ${PN} test-multi-launch  (TEST ONLY: register 4 local Konsoles)"
    j_msg "-${notice}" -p "       ${PN} -h"
    j_msg "-${notice}" -p "       ${PN} -o [-f CONFIG] (confirm and initialize configured desktop groups)"
    j_msg "-${notice}" -p "       ${PN} [-v|-q ...] -l (read-only managed inventory, including missing reservations)"
}

# Retain the positional move/test grammar. getopts handles common options and
# clusters, stopping at -m so negative coordinates remain positional values.
parse_cmdline() {
    local _pc_opt
    OPTIND=1
    cli_operation=""
    config=""
    CONFIG_SELECTED=$FALSE
    cli_verbosity=()
    case ${1:-} in
        move|test-launch|test-multi-launch|--help)
            cli_operation=$1; shift; cli_args=("$@"); return 0 ;;
    esac
    while getopts ':cmof:vqhLxdsSli' _pc_opt; do
        case $_pc_opt in
            v|q) cli_verbosity+=("$_pc_opt") ;;
            f) config=$OPTARG; CONFIG_SELECTED=$TRUE ;;
            c|m|o|h|L|x|d|s|S|l|i)
                [[ -z $cli_operation ]] || { bad_args 'select exactly one operation'; return 2; }
                cli_operation=-$_pc_opt
                [[ $_pc_opt != m ]] || break ;;
            :) bad_args "option -${OPTARG} requires a value"; return 2 ;;
            *) bad_args "unknown option -${OPTARG}"; return 2 ;;
        esac
    done
    shift "$((OPTIND - 1))"
    cli_args=("$@")
    [[ -n $cli_operation ]] || { bad_args 'select an operation'; return 2; }
    if [[ $CONFIG_SELECTED && $cli_operation != -c && $cli_operation != -o && $cli_operation != -m ]]; then
        bad_args '-f is supported only with -c, -o or layout movement'; return 2
    fi
    if [[ $cli_operation != -m && $# != 0 ]]; then
        bad_args 'unexpected operands'; return 2
    fi
    return 0
}

config_path_present() {
    # Distinguish absence from an unsearchable parent. An inaccessible optional
    # layer must not disappear merely because test -e cannot stat its pathname.
    local _cpp_path=$1 _cpp_parent=${1%/*} _cpp_next
    [[ ! -e $_cpp_path && ! -L $_cpp_path ]] || return 0
    [[ $_cpp_parent != "$_cpp_path" ]] || _cpp_parent=.
    while [[ ! -e $_cpp_parent && ! -L $_cpp_parent ]]; do
        [[ $_cpp_parent != / && $_cpp_parent != . ]] || break
        _cpp_next=${_cpp_parent%/*}
        [[ $_cpp_next != "$_cpp_parent" ]] || _cpp_next=.
        _cpp_parent=${_cpp_next:-/}
    done
    if [[ ! -d $_cpp_parent || ! -x $_cpp_parent ]]; then
        j_msg "-${err}" -p "Configuration location inaccessible [$_cpp_path]"; return 2
    fi
    return 1
}

select_config() {
    [[ ! $CONFIG_SELECTED ]] || return 0
    local _sc_presence _sc_home=${XDG_CONFIG_HOME:-$HOME/.config} _sc_user _sc_system=/etc/joetoo-kwin/joetoo-kwin.conf
    [[ $_sc_home == /* ]] || _sc_home=$HOME/.config
    _sc_user=$_sc_home/joetoo-kwin/joetoo-kwin.conf
    if config_path_present "$_sc_user"; then config=$_sc_user; return 0
    else _sc_presence=$?; (( _sc_presence == 1 )) || return "$_sc_presence"; fi
    if config_path_present "$_sc_system"; then config=$_sc_system; return 0
    else _sc_presence=$?; (( _sc_presence == 1 )) || return "$_sc_presence"; fi
    j_msg "-${err}" -p "No configuration: create [$_sc_user] or select -f CONFIG; system fallback [$_sc_system] absent"
    return 2
}

prepare_config_sources() {
    # Resolve paths before sourcing trusted files. Source in the existing caller
    # scope, so Bash declarations retain their pre-layering behavior.
    local _cs_home=${XDG_CONFIG_HOME:-$HOME/.config} _cs_file _cs_presence
    [[ $_cs_home == /* ]] || _cs_home=$HOME/.config
    select_config || return $?
    declare -ga config_sources=()
    for _cs_file in /etc/joetoo-kwin/defaults.conf "$_cs_home/joetoo-kwin/defaults.conf"; do
        if config_path_present "$_cs_file"; then config_sources+=("$_cs_file")
        else _cs_presence=$?; (( _cs_presence == 1 )) || return "$_cs_presence"; fi
    done
    # source searches PATH for bare filenames. Anchor relative selections to
    # the invocation's directory, matching the file checked by -f and bash -n.
    if [[ $config == /* ]]; then config_sources+=("$config")
    else config_sources+=("./$config"); fi
    # Check every selected file before executing any of them. Do not echo its
    # contents: syntax diagnostics could otherwise disclose a malformed target.
    for _cs_file in "${config_sources[@]}"; do
        if [[ ! -f $_cs_file || ! -r $_cs_file ]]; then
            j_msg "-${err}" -p "${PN}: configuration unreadable [$_cs_file]"; return 2
        fi
        if ! bash -n -- "$_cs_file" >/dev/null 2>&1; then
            j_msg "-${err}" -p "Invalid configuration syntax [$_cs_file]"; return 2
        fi
    done
}

apply_cli_verbosity() {
    local _acv_opt
    if [[ ! $verbosity =~ ^[0-7]$ ]]; then
        j_msg "-${err}" -p "${PN}: verbosity must be between 0 and 7"; return 2
    fi
    # The header supplies the helper; its macro is normally set by process_cmdline.
    _pc_adjust_verbosity="verbosity=\$(( verbosity \${_pc_operator} 1 ))"
    for _acv_opt in "${cli_verbosity[@]}"; do
        case $_acv_opt in v) _pc_operator=+ ;; q) _pc_operator=- ;; esac
        _pc_action_verbosity || return $?
    done
    unset -v _pc_adjust_verbosity _pc_operator
    return 0
}

# Keep the supervised action's status distinct from the reporting bitmask.
plan_stage() {
    local _ps_level=$1 _ps_label=$2 _ps_action_rc
    shift 2
    # Validators may emit diagnostics. Use the output-producing AAR form so
    # their messages cannot interrupt an unfinished announcement/result line.
    j_msg "-${_ps_level}" -p "${_ps_label} ..."
    if "$@"; then _ps_action_rc=0; else _ps_action_rc=$?; fi
    j_msg "-${_ps_level}" -pn "${_ps_label} result:"
    report_action "$_ps_action_rc" "$_ps_level"
}

# Report the captured action status; reporting faults must not mask action failure.
report_action() {
    local _ps_action_rc=$1 _ps_level=$2 _ps_report_rc
    if handle_result "$_ps_action_rc" completed failed "$_ps_level"; then
        _ps_report_rc=0
    else
        _ps_report_rc=$?
    fi
    if (( _ps_report_rc & ~1 )); then
        j_msg "-${err}" -p "${PN}: result reporting failed [${_ps_report_rc}]"
        decode_right_status "$_ps_report_rc"
    fi
    (( _ps_action_rc == 0 )) || return "$_ps_action_rc"
    (( _ps_report_rc == 0 )) || return 1
    return 0
}

check_plan() {
    local _cp_script_dir _cp_layer
    _cp_script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P) || return 1
    # Candidate helper is colocated under libexec; no installed-file changes.
    # shellcheck source=/home/joe/joetoo-ai/workspace/projects/joetoo-kwin/libexec/joetoo-kwin-plan-functions
    source "${_cp_script_dir}/libexec/joetoo-kwin-plan-functions" || return 1
    plan_defaults
    prepare_config_sources || return $?
    # This is executable, trusted Bash, as in the legacy tool. It is not a sandbox.
    # Defaults precede config; CLI verbosity overrides are deliberately applied last.
    for _cp_layer in "${config_sources[@]}"; do
        # shellcheck source=/dev/null
        source "$_cp_layer" || { j_msg "-${err}" -p "Configuration source failed [$_cp_layer]"; return 2; }
    done
    apply_cli_verbosity || return $?
    plan_stage "$notice" 'Validating configured launch intent' validate_plan || return $?
    plan_stage "$info" 'Calculating shared geometry' calculate_plan || return $?
    # Explicit varlist avoids unrelated workflow/status-file initialization.
    local notice_varlist="PN BUILD rlv.config screen_width screen_height"
    local info_varlist="verbosity desktop_limit dt_win_limit min_window_exposure_px"
    info_varlist+=" terminal_width_percent terminal_gap_percent terminal_height_percent terminal_left_percent terminal_top_percent terminal_row_gap_percent"
    info_varlist+=" graphical_left_percent graphical_top_percent graphical_width_percent graphical_height_percent"
    info_varlist+=" rdp_registration_timeout_ms rdp_windowing_backend rdp_security_protocol rdp_certificate_policy rdp_x11_renderer rdp_remote_width rdp_remote_height bool.RDP_SMART_SIZING rdp_initial_client_width rdp_initial_client_height"
    info_varlist+=" vnc_viewer_ready_timeout_ms bool.sftp_advisory_enabled sftp_advisory_timeout_ms sftp_advisory_ssh_port"
    local debug_varlist="initial_focus_timeout_ms initial_focus_poll_interval_ms sftp_capability_timeout_ms"
    debug_varlist+=" rdp_registration_poll_ms rdp_registration_event_limit rdp_registration_window_limit rdp_backend_log_byte_limit rdp_x11_identity_settle_ms"
    debug_varlist+=" vnc_ssh_start_timeout_ms vnc_supervisor_poll_interval_ms vnc_cleanup_timeout_ms vnc_local_port_attempts vnc_identity_event_limit vnc_identity_settle_ms vnc_dbus_timeout_ms vnc_placement_timeout_ms vnc_identity_start_timeout_ms"
    local varlist
    [[ ${1:-} != launch ]] || launch_preflight || return $?
    varlist="$notice_varlist"
    show_config || die "failed to show_config for notice_varlist"
    # d_do returns success after evaluation; handle rendering failures inside it.
    varlist="$info_varlist"
    # ShellCheck warns that stuff inside '...' doesnt expand - but for d_do that is the point
    # shellcheck disable=SC2016
    d_do 'j_msg "-${info}" -p "=====[ Additional Information ]==============="
        show_config || die "failed to show_config for info_varlist"
    ' "$info" || return $?
    # varlist is consumed by show_config through d_do/eval.
    # shellcheck disable=SC2034
    varlist="$debug_varlist"
    # ShellCheck warns that stuff inside '...' doesnt expand - but for d_do that is the point
    # shellcheck disable=SC2016
    d_do 'j_msg "-${debug}" -p "=====[ Additional Debug Information ]==============="
        show_config || die "failed to show_config for debug_varlist"
    ' "$debug" || return $?
    print_plan "${1:-dry-run}"
    # -c ends here. Confirmation and launch belong to the later -o tranche.
}

bad_args() {
    j_msg "-${err}" -p "${PN}: $1"
    usage
    return 2
}

validate_geometry() {
    local _vg_arg _vg_positive
    for _vg_arg in "$@"; do
        if ! isint "$_vg_arg"; then
            j_msg "-${err}" -p "${PN}: invalid integer [${_vg_arg}]"
            return 2
        fi
    done
    for _vg_positive in "$1" "$4" "$5"; do
        # these arguments represent desktop number, window width, and height
        # each must be a valid decimal integer greater than zero
        #
        # isint rejects non-integer strings, but accepts negative integers
        # the second test ensures the number is strictly positive
        #
        # the || operator evaluates the second condition only if isint succeeds
        # negating the numeric comparison also rejects comparison errors,
        # including integers too large for the shell's numeric test
        if ! isint "$_vg_positive" || ! [ "$_vg_positive" -gt 0 ] ; then
            j_msg "-${err}" -p "${PN}: desktop, width and height must be positive"
            return 2
        fi
    done
    return 0
}

wait_for_request() {
    local _wr_request=$1 _wr_label=$2 _wr_attempt _wr_status _wr_rc=1 _wr_level=$err
    # wait up to 5 sec, in 100ms increments
    local _wr_limit="50" _wr_increment="0.1"
    # extend wait to 15 sec if for launch
    [[ $_wr_label == launch || $_wr_label == optional-move ]] && _wr_limit=150
    for ((_wr_attempt=0; _wr_attempt<_wr_limit; _wr_attempt++)); do
         # kwin bus/svc, obj/path, inteface identifiers.method (together = address)
         # (call Status method with requested action as arg)
        if ! _wr_status=$(qdbus6 "$bus" "$path" "$iface.Status" "$_wr_request"); then
            _wr_status="${PN}: could not query request [${_wr_request}]"
            break
        fi
        case $_wr_status in
            OK*) _wr_rc=0; _wr_level=$notice; break ;;
            ERROR*|UNKNOWN*) break ;;
        esac
        sleep "$_wr_increment"
    done
    if (( _wr_attempt == _wr_limit )); then
        _wr_status="${PN}: ${_wr_label} timed out (request [${_wr_request}])"
    fi
    if [[ $_wr_label == optional-move ]]; then
        # Historical output convention, superseded by the verbosity refinement below:
        # The full broker detail owns this result line; no preceding open announcement.
        # Detail now follows the concise verification result at info/error severity.
        local _wr_report_rc
        if report_action "$_wr_rc" "$notice"; then _wr_report_rc=0; else _wr_report_rc=$?; fi
        if (( _wr_rc == 0 )); then
            # Split the broker's identity from its frame detail; keep unfamiliar
            # status formats intact. Save captures before header helpers run.
            local _wr_identity _wr_frame
            if [[ $_wr_status =~ ^(.*[[:space:]]\(pid=[0-9]+\))[[:space:]](before=.*)$ ]]; then
                _wr_identity=${BASH_REMATCH[1]}; _wr_frame=${BASH_REMATCH[2]}
                j_msg "-${info}" -m "$_wr_identity"
                j_msg "-${info}" -m "$_wr_frame"
            else
                j_msg "-${info}" -m "$_wr_status"
            fi
        else
            j_msg "-${err}" -p "$_wr_status"
        fi
        j_msg "-${debug}" -p "Request [${_wr_request}]: status after [$((_wr_attempt + 1))] polls"
        return "$_wr_report_rc"
    else
        j_msg "-${_wr_level}" -p "$_wr_status"
        return "$_wr_rc"
    fi
}

# qdbus6 exposes error names as a first diagnostic line, not a structured
# exception API. Match only exact known names; always retain the original text.
report_move_submission_failure() {
    local _msf_detail=$1 _msf_name=${1%%$'\n'*}
    case $_msf_name in
        "Error: ${iface}.Busy")
            j_msg "-${err}" -p 'Move busy: previous placement request has not completed' ;;
        "Error: ${iface}.Unsupported"|'Error: org.freedesktop.DBus.Error.UnknownMethod'|'Error: org.freedesktop.DBus.Error.UnknownInterface'|\
        "Cannot find '${iface}.SubmitMove' in object ${path} at ${bus}")
            j_msg "-${err}" -p 'Optional moves require compatible broker and resident support' ;;
        "Error: ${iface}.BadArguments"|"Error: ${iface}.InvalidRequest"|'Error: org.freedesktop.DBus.Error.InvalidArgs')
            j_msg "-${err}" -p 'Move rejected: invalid request' ;;
        *) j_msg "-${err}" -p 'Move submission failed' ;;
    esac
    [[ -z $_msf_detail ]] || j_msg "-${err}" -p "$_msf_detail"
}

move_active_window() {
    local _ma_request
    validate_geometry "$@" || return $?
     # kwin bus/svc, obj/path, inteface identifiers.method (together = address)
     # (call Submit method, with all args args)
    _ma_request=$(qdbus6 "$bus" "$path" "$iface.Submit" "$@") || return 1
    # call Component.invokeShortcut with arg joetoo_bridge_move
    # (call the moveFromBroker function in joetoo-kwin-resident.js,
    #  which is registerd as "joetoo_bridge_move")
    qdbus6 org.kde.kglobalaccel /component/kwin \
        org.kde.kglobalaccel.Component.invokeShortcut \
        joetoo_bridge_move >/dev/null || return 1
    wait_for_request "$_ma_request" move
}

# Normalize the six approved move forms before any D-Bus call. Omitted values
# use zero placeholders only with independent preservation flags on SubmitMove.
move_window() {
    local _mw_desktop=0 _mw_x=0 _mw_y=0 _mw_width=0 _mw_height=0 _mw_side=""
    local _mw_PD=$FALSE _mw_PP=$FALSE _mw_PS=$FALSE _mw_value _mw_abs _mw_dir _mw_request
    case $# in
        1) case $1 in
               l|r) _mw_side=$1; _mw_PD=$TRUE ;;
               *) _mw_desktop=$1; _mw_PP=$TRUE; _mw_PS=$TRUE ;;
           esac ;;
        2) _mw_desktop=$1; _mw_side=$2
           [[ $_mw_side == l || $_mw_side == r ]] || { bad_args 'expected DESKTOP l|r'; return 2; } ;;
        3) _mw_desktop=$1; _mw_x=$2; _mw_y=$3; _mw_PS=$TRUE ;;
        4) _mw_PD=$TRUE; _mw_x=$1; _mw_y=$2; _mw_width=$3; _mw_height=$4 ;;
        5) _mw_desktop=$1; _mw_x=$2; _mw_y=$3; _mw_width=$4; _mw_height=$5 ;;
        *) bad_args 'invalid move operand count'; return 2 ;;
    esac
    for _mw_value in "$_mw_desktop" "$_mw_x" "$_mw_y" "$_mw_width" "$_mw_height"; do
        _mw_abs=${_mw_value#-}
        if ! isint "$_mw_value" || (( ${#_mw_abs} > 5 )); then
            bad_args 'move operands must be bounded decimal integers'; return 2
        fi
    done
    # Explicit decimal conversion preserves signed coordinates without octal parsing.
    for _mw_value in _mw_desktop _mw_x _mw_y _mw_width _mw_height; do
        _mw_abs=${!_mw_value}
        if [[ $_mw_abs == -* ]]; then printf -v "$_mw_value" '%d' "$((-10#${_mw_abs#-}))"
        else printf -v "$_mw_value" '%d' "$((10#$_mw_abs))"; fi
    done
    if [[ ! $_mw_PD ]] && (( _mw_desktop < 1 || _mw_desktop > 256 )); then
        bad_args 'desktop must be between 1 and the available desktop count'; return 2
    fi
    if [[ $_mw_side ]]; then
        _mw_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P) || return 1
        # Candidate helper is colocated under libexec; no installed-file changes.
        # shellcheck source=/home/joe/joetoo-ai/workspace/projects/joetoo-kwin/libexec/joetoo-kwin-plan-functions
        source "${_mw_dir}/libexec/joetoo-kwin-plan-functions" || return 1
        plan_defaults
        prepare_config_sources || return $?
        # Trusted Bash config; CLI verbosity takes precedence after sourcing.
        local _mw_layer
        for _mw_layer in "${config_sources[@]}"; do
            # shellcheck source=/dev/null
            source "$_mw_layer" || { bad_args 'layout configuration source failed'; return 2; }
        done
        apply_cli_verbosity || return $?
        plan_stage "$info" 'Validating layout geometry' validate_layout_geometry || return $?
        if [[ $_mw_side == l ]]; then terminal_geometry 2 1 || return $?
        else terminal_geometry 2 2 || return $?; fi
        _mw_x=$geometry_x; _mw_y=$geometry_y; _mw_width=$geometry_width; _mw_height=$geometry_height
    else
        [[ ! $CONFIG_SELECTED ]] || { bad_args '-f requires a layout move (l/r)'; return 2; }
        apply_cli_verbosity || return $?
    fi
    if (( _mw_x < -32768 || _mw_x > 32768 || _mw_y < -32768 || _mw_y > 32768 )) ||
        { [[ ! $_mw_PS ]] && (( _mw_width < 1 || _mw_width > 32768 || _mw_height < 1 || _mw_height > 32768 )); }; then
        bad_args 'move position or size out of range'; return 2
    fi
    if (( $# == 5 )); then
        move_active_window "$_mw_desktop" "$_mw_x" "$_mw_y" "$_mw_width" "$_mw_height"
        return $?
    fi
    local _mw_pd=false _mw_pp=false _mw_ps=false _mw_action_rc _mw_detail
    [[ ! $_mw_PD ]] || _mw_pd=true
    [[ ! $_mw_PP ]] || _mw_pp=true
    [[ ! $_mw_PS ]] || _mw_ps=true
    j_msg "-${notice}" -pn 'Submitting active-window move ...'
    if _mw_request=$(qdbus6 "$bus" "$path" "$iface.SubmitMove" \
        "$_mw_desktop" "$_mw_x" "$_mw_y" "$_mw_width" "$_mw_height" "$_mw_pd" "$_mw_pp" "$_mw_ps" 2>&1); then
        _mw_action_rc=0
    else
        _mw_action_rc=$?
    fi
    if ! report_action "$_mw_action_rc" "$notice"; then
        if (( _mw_action_rc != 0 )); then
            report_move_submission_failure "$_mw_request"
        fi
        return 1
    fi
    j_msg "-${notice}" -pn 'Invoking active-window move shortcut ...'
    if _mw_detail=$(qdbus6 org.kde.kglobalaccel /component/kwin \
        org.kde.kglobalaccel.Component.invokeShortcut joetoo_bridge_move_optional 2>&1); then
        _mw_action_rc=0
    else
        _mw_action_rc=$?
    fi
    if ! report_action "$_mw_action_rc" "$notice"; then
        [[ $_mw_action_rc == 0 || -z $_mw_detail ]] || j_msg "-${err}" -p "$_mw_detail"
        return 1
    fi
    j_msg "-${debug}" -p "Request [${_mw_request}]: preserveDesktop=${_mw_pd} preservePosition=${_mw_pp} preserveSize=${_mw_ps}"
    j_msg "-${notice}" -pn 'Verifying active-window move ...'
    wait_for_request "$_mw_request" optional-move
}

launch_one_window() {
    local _lw_class=$1 _lw_request _lw_child
    shift
    # arguments: five geometry values, --, executable and its arguments.
    if (( $# < 7 )) || [[ ${6:-} != -- || -z ${7:-} ]]; then
        bad_args 'test-launch requires CLASS DESKTOP X Y WIDTH HEIGHT -- PROGRAM [ARG ...]'
        return 2
    fi
    validate_geometry "$1" "$2" "$3" "$4" "$5" || return $?
    if [[ -z $_lw_class || ${#_lw_class} -gt 128 ]]; then
        j_msg "-${err}" -p "${PN}: expected KWin class must contain 1-128 characters"
        return 2
    fi
    local -a _lw_geometry=("$1" "$2" "$3" "$4" "$5")
    shift 6
    if ! command -v "$1" >/dev/null 2>&1; then
        j_msg "-${err}" -p "${PN}: program not found [${1}]"
        return 1
    fi
    # The request must be armed before the program creates its window.
    _lw_request=$(qdbus6 "$bus" "$path" "$iface.SubmitLaunch" "$_lw_class" "${_lw_geometry[@]}") || return 1
    j_msg "-${notice}" -p "Armed class [${_lw_class}], request [${_lw_request}]"
    "$@" &
    _lw_child=$!
    j_msg "-${notice}" -p "Launched [${1}], shell PID [${_lw_child}]"
    # The launched application is independent of joetoo-kwind supervision.
    wait_for_request "$_lw_request" launch
}

# Managed launch test entry point. The broker owns the registry and performs
# all UUID selection; the Bash client supplies only intent and its child PID.
launch_managed_window() {
    local _lm_class=$1 _lm_slot=$2 _lm_payload _lm_placement _lm_registration
    local _lm_pid _lm_result _lm_state _lm_attempt _lm_registration_rc=1
    launch_registration_id=""; launch_placement_id=""
    local _lm_placement_rc=1
    shift 2
    if (( $# < 7 )) || [[ ${6:-} != -- || -z ${7:-} ]]; then
        bad_args 'managed test launch requires CLASS SLOT DESKTOP X Y WIDTH HEIGHT -- PROGRAM [ARG ...]'
        return 2
    fi
    validate_geometry "$1" "$2" "$3" "$4" "$5" || return $?
    if ! isint "$_lm_slot" || (( _lm_slot < 1 || _lm_slot > 256 )); then
        j_msg "-${err}" -p "${PN}: invalid test slot [${_lm_slot}]"
        return 2
    fi
    if [[ -z $_lm_class || ${#_lm_class} -gt 128 ]]; then
        j_msg "-${err}" -p "${PN}: invalid expected KWin class"
        return 2
    fi
    local -a _lm_geometry=("$1" "$2" "$3" "$4" "$5")
    shift 6
    if ! command -v "$1" >/dev/null 2>&1; then
        j_msg "-${err}" -p "${PN}: program not found [${1}]"
        return 1
    fi
    _lm_payload=$(qdbus6 "$bus" "$path" "$iface.SubmitManagedLaunch" \
        "$_lm_class" "${_lm_geometry[0]}" "$_lm_slot" "${_lm_geometry[@]:1}") || return 1
    _lm_placement=$(jq -er '.placement_request_id | select(type == "string" and length > 0)' \
        <<< "$_lm_payload") || return 1
    _lm_registration=$(jq -er '.registration_request_id | select(type == "string" and length > 0)' \
        <<< "$_lm_payload") || return 1
    # Launch state shared with sourced launch-functions; indirect consumers.
    # shellcheck disable=SC2034
    launch_registration_id=$_lm_registration
    # shellcheck disable=SC2034
    launch_placement_id=$_lm_placement
    j_msg "-${notice}" -p "Armed managed launch [${_lm_registration}], placement [${_lm_placement}]"
    # FD 9 is the configured-launch lock. Application descendants must never
    # retain it after this launcher exits; keep the actual launch and $! intact.
    "$@" 9>&- &
    _lm_pid=$!
    if [[ $_lm_class == konsole ]]; then
        j_msg "-${notice}" -p "Launched Konsole operation; launch-process PID [${_lm_pid}] (interactive Bash PID is reported inside the terminal)"
    else
        j_msg "-${notice}" -p "Launched [${_lm_class}] operation; launch-process PID [${_lm_pid}]"
    fi
    if ! qdbus6 "$bus" "$path" "$iface.SetManagedLaunchPid" "$_lm_registration" "$_lm_pid"; then
        j_msg "-${err}" -p "${PN}: managed PID handoff failed for [${_lm_registration}]"
        return 1
    fi
    # Correlation has a 15-second deadline. Poll it before the potentially
    # 15-second placement wait so the quiet-period match can complete.
    for ((_lm_attempt=0; _lm_attempt<150; _lm_attempt++)); do
        _lm_result=$(qdbus6 "$bus" "$path" "$iface.PollManagedLaunch" "$_lm_registration") || return 1
        _lm_state=$(jq -er '.state | select(type == "string")' <<< "$_lm_result") || return 1
        case $_lm_state in
            registered)
                j_msg "-${notice}" -p "Registered [$(jq -r '.managed_id' <<< "$_lm_result")] UUID [$(jq -r '.window_uuid' <<< "$_lm_result")]"
                _lm_registration_rc=0
                break ;;
            pending) sleep 0.1 ;;
            failed|timeout|ambiguous|UNKNOWN)
                j_msg "-${err}" -p "${PN}: managed registration [${_lm_state}]: ${_lm_result}"
                break ;;
            *) j_msg "-${err}" -p "${PN}: unexpected registration result: ${_lm_result}"; break ;;
        esac
    done
    if wait_for_request "$_lm_placement" launch; then
        _lm_placement_rc=0
    fi
    (( _lm_registration_rc == 0 && _lm_placement_rc == 0 ))
}

# Step 1.4d native registration test fixture, not the configured -o launcher.
# The four coordinates deliberately describe one 1920x1080 test display.
# These are fixed TEST VALUES; the shared geometry policy belongs to Step 1.5.
# Each launch must become managed by positive PID/UUID correlation.
test_multi_launch() {
    local _tml_desktop _tml_x _tml_slot _tml_failed=0
    j_msg "-${notice}" -p "${PN}: TEST ONLY: register four local Konsole windows on desktops 1 and 2"
    for _tml_desktop in 1 2; do
        _tml_slot=0
        for _tml_x in 19 873; do
            _tml_slot=$((_tml_slot + 1))
            if launch_managed_window konsole "$_tml_slot" "$_tml_desktop" "$_tml_x" 54 816 918 -- konsole --separate; then
                :
            else
                _tml_failed=$((_tml_failed + 1))
                j_msg "-${err}" -p "${PN}: test launch failed (desktop [${_tml_desktop}], x [${_tml_x}])"
            fi
        done
    done
    if (( _tml_failed > 0 )); then
        j_msg "-${err}" -p "${PN}: [${_tml_failed}] of four test launches failed"
        return 1
    fi
    j_msg "-${notice}" -p "${PN}: all four test launches registered and placement succeeded"
    return 0
}

# ListManaged is the authority: never enumerate or adopt merely observed windows.
# Validate the entire snapshot before printing rows; optional/private fields are
# deliberately omitted. Listing does not source executable configuration files.
list_managed_windows() {
    local _lm_snapshot
    if ! command -v qdbus6 >/dev/null || ! command -v python3 >/dev/null; then
        j_msg "-${err}" -p 'Managed inventory requires qdbus6 and python3'; return 2
    fi
    _lm_snapshot=$(qdbus6 "$bus" "$path" "$iface.ListManaged" 2>/dev/null) || {
        j_msg "-${err}" -p 'Managed inventory unavailable: broker ListManaged failed'; return 2; }
    python3 - 3<<< "$_lm_snapshot" <<'PY_LIST_MANAGED'
import json
import os
import re
import sys
import uuid


def unique_keys(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise ValueError('duplicate JSON key')
        result[key] = value
    return result


try:
    with os.fdopen(3) as stream:
        inventory = json.load(stream, object_pairs_hook=unique_keys)
    if (not isinstance(inventory, dict) or type(inventory.get('count')) is not int
            or not isinstance(inventory.get('windows'), list)
            or inventory['count'] != len(inventory['windows'])):
        raise ValueError('invalid inventory')
    rows = []
    ids, uuids, slots = set(), set(), set()
    for record in inventory['windows']:
        identifier = record['managed_id']
        window_uuid = record['window_uuid']
        desktop, slot = record['intended']['desktop'], record['intended']['slot']
        presence, placement = record['presence'], record['placement']
        if (not isinstance(identifier, str) or not re.fullmatch(r'win-[0-9]+', identifier)
                or int(identifier[4:]) < 1 or type(desktop) is not int or type(slot) is not int
                or not 1 <= desktop <= 256 or not 1 <= slot <= 256
                or not isinstance(window_uuid, str) or str(uuid.UUID(window_uuid)) != window_uuid
                or presence not in ('present', 'missing', 'uncertain')
                or placement not in ('not_requested', 'pending', 'succeeded', 'failed')
                or identifier in ids or window_uuid in uuids or (desktop, slot) in slots):
            raise ValueError('inconsistent record')
        ids.add(identifier); uuids.add(window_uuid); slots.add((desktop, slot))
        rows.append((identifier, desktop, slot, presence, placement, window_uuid))
    rows.sort(key=lambda row: (row[1], row[2], int(row[0][4:])))
except (ValueError, TypeError, KeyError, AttributeError, OSError, RecursionError):
    print('joetoo-kwin: malformed or inconsistent managed inventory; no rows displayed', file=sys.stderr)
    sys.exit(2)

if not rows:
    print('No managed windows (no retained managed reservations).')
else:
    headers = ('MANAGED_ID', 'DESKTOP', 'SLOT', 'PRESENCE', 'PLACEMENT', 'WINDOW_UUID')
    widths = [max(len(headers[i]), *(len(str(row[i])) for row in rows)) for i in range(len(headers))]
    for row in [headers, *rows]:
        print('  '.join(str(value).ljust(width) for value, width in zip(row, widths)).rstrip())
PY_LIST_MANAGED
}

