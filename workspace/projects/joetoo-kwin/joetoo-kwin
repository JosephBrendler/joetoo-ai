# ListManaged is the authority: never enumerate or adopt merely observed windows.
# Validate the entire snapshot before printing rows; optional/private fields are
# deliberately omitted. Listing does not source executable configuration files.
list_managed_windows() # Validate managed inventory before displaying it or selecting a slot
{
    local _lm_snapshot
    if ! command -v qdbus6 >/dev/null || ! command -v python3 >/dev/null; then
        j_msg "-${err}" -p 'Managed inventory requires qdbus6 and python3'; return 2
    fi
    _lm_snapshot=$(qdbus6 "$bus" "$path" "$iface.ListManaged" 2>/dev/null) || {
        j_msg "-${err}" -p 'Managed inventory unavailable: broker ListManaged failed'; return 2; }
    # Python source arrives on stdin via the quoted heredoc; broker JSON uses
    # separate FD 3. Neither JSON nor user data is interpolated into the source.
    python3 - "${1:-table}" "${2:-}" 3<<< "$_lm_snapshot" <<'PY_LIST_MANAGED'
import json
import os
import re
import sys
import uuid


def unique_keys(pairs):
    # Reject duplicate fields instead of accepting json's last-value-wins rule.
    result = {}
    for key, value in pairs:
        if key in result:
            raise ValueError('duplicate JSON key')
        result[key] = value
    return result


try:
    with os.fdopen(3) as stream:
        inventory = json.load(stream, object_pairs_hook=unique_keys)
    if (not isinstance(inventory, dict) or type(inventory.get('count')) is not int
            or not isinstance(inventory.get('windows'), list)
            or inventory['count'] != len(inventory['windows'])):
        raise ValueError('invalid inventory')
    # Build the complete validated batch before any table/free-slot output.
    # type(...) is int also excludes Python booleans, a subclass of int.
    rows = []
    ids, uuids, slots = set(), set(), set()
    for record in inventory['windows']:
        identifier = record['managed_id']
        window_uuid = record['window_uuid']
        desktop, slot = record['intended']['desktop'], record['intended']['slot']
        presence, placement = record['presence'], record['placement']
        if (not isinstance(identifier, str) or not re.fullmatch(r'win-[0-9]+', identifier)
                or int(identifier[4:]) < 1 or type(desktop) is not int or type(slot) is not int
                or not 1 <= desktop <= 256 or not 1 <= slot <= 256
                or not isinstance(window_uuid, str) or str(uuid.UUID(window_uuid)) != window_uuid
                or presence not in ('present', 'missing', 'uncertain')
                or placement not in ('not_requested', 'pending', 'succeeded', 'failed')
                or identifier in ids or window_uuid in uuids or (desktop, slot) in slots):
            raise ValueError('inconsistent record')
        ids.add(identifier); uuids.add(window_uuid); slots.add((desktop, slot))
        rows.append((identifier, desktop, slot, presence, placement, window_uuid))
    rows.sort(key=lambda row: (row[1], row[2], int(row[0][4:])))
except (ValueError, TypeError, KeyError, AttributeError, OSError, RecursionError):
    print('joetoo-kwin: malformed or inconsistent managed inventory; no rows displayed', file=sys.stderr)
    sys.exit(2)

if sys.argv[1] == 'slot':
    # Missing records reserve slots; uncertainty never grants launch eligibility.
    if any(row[3] == 'uncertain' for row in rows):
        print('-L: managed inventory is uncertain; no slot selected', file=sys.stderr)
        sys.exit(2)
    desktop = int(sys.argv[2])  # Already validated by the shared recipe validator.
    occupied = {row[2] for row in rows if row[1] == desktop}
    slot = next((n for n in range(1, 257) if n not in occupied), None)
    if slot is None:
        print(f'-L: desktop {desktop} has no unused logical slot in 1..256 (including missing reservations)', file=sys.stderr)
        sys.exit(2)
    print(slot)
    sys.exit(0)

if not rows:
    print('No managed windows (no retained managed reservations).')
else:
    headers = ('MANAGED_ID', 'DESKTOP', 'SLOT', 'PRESENCE', 'PLACEMENT', 'WINDOW_UUID')
    widths = [max(len(headers[i]), *(len(str(row[i])) for row in rows)) for i in range(len(headers))]
    for row in [headers, *rows]:
        print('  '.join(str(value).ljust(width) for value, width in zip(row, widths)).rstrip())
PY_LIST_MANAGED
}
# @usage list_managed_windows [table]
# @cont list_managed_windows slot DESKTOP
# @args slot: internal -L query; DESKTOP must already be recipe-validated.
# @ret 0 with table/empty message or free slot; 2 on IPC/validation/no-slot
# @append error.
# @deps qdbus6 ListManaged, python3 (json, os, re, sys, uuid), j_msg
# @vars Reads bus, path, iface and err; sources no configuration itself.
# @rule Reject duplicate IDs/UUIDs/reservations before producing output rows.
# @rule Missing records still reserve slots; uncertain inventory forbids
# @append selection.
# @note A free-slot result is advisory; authoritative launch checks run later.

# The management queries are snapshots, never ownership or remote-health proof.
# Validate the complete allowlisted broker reply before emitting any output.
# Bash owns D-Bus; a separate libexec Python module parses fd 3 and prints safe fields.
readonly_managed_query() # Render validated broker status or one retained managed record
{
    local _rq_kind=$1 _rq_id=${2:-} _rq_method _rq_payload _rq_dir _rq_helper
    case $_rq_kind in
        status) _rq_method=RegistryStatus ;;
        info) _rq_method=GetManaged ;;
        *) return 2 ;;
    esac
    if ! command -v qdbus6 >/dev/null || ! command -v python3 >/dev/null; then
        j_msg "-${err}" -p 'Read-only management queries require qdbus6 and python3'; return 2
    fi
    _rq_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P) || return 2
    _rq_helper=$_rq_dir/libexec/joetoo_kwin_readonly.py
    # Step 1.9 will consolidate packaged helper lookup for other CLI commands.
    [[ -f $_rq_helper ]] || _rq_helper=/usr/libexec/joetoo-kwin/joetoo_kwin_readonly.py
    if [[ ! -f $_rq_helper ]]; then
        j_msg "-${err}" -p 'Read-only query helper unavailable: joetoo_kwin_readonly.py'; return 2
    fi
    if [[ $_rq_kind == info ]]; then
        _rq_payload=$(qdbus6 "$bus" "$path" "$iface.$_rq_method" "$_rq_id" 2>/dev/null) || {
            j_msg "-${err}" -p 'Managed window information unavailable: broker GetManaged failed'; return 2; }
    else
        _rq_payload=$(qdbus6 "$bus" "$path" "$iface.$_rq_method" 2>/dev/null) || {
            j_msg "-${err}" -p 'Broker status unavailable: RegistryStatus failed'; return 2; }
    fi
    if (( ${#_rq_payload} > 65536 )); then
        j_msg "-${err}" -p 'Read-only broker response exceeds size limit'; return 2
    fi
    python3 "$_rq_helper" "$_rq_kind" "$_rq_id" 3<<< "$_rq_payload"
}
# @usage readonly_managed_query status
# @cont readonly_managed_query info MANAGED_ID
# @ret 0 on valid output; helper returns 1 for UNKNOWN and 2 for malformed
# @append data.
# @ret 2 for invalid kind, missing dependencies/helper, failed IPC or size
# @append check.
# @deps qdbus6, python3, joetoo_kwin_readonly.py, j_msg
# @vars Reads bus, path, iface and err.
