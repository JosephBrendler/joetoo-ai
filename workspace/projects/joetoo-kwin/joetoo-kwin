# @rule Queries confer neither ownership nor proof of remote authentication.

#-----[ main script ]----------------------------------------------------------------------------------
# Historical fixture-injection marker; remaining helpers are defined below.
# Actual invocation/mission dispatch follows control_focus_on_exit.

# The Python frontend owns one D-Bus connection across preview/confirmation.
# It does not supervise applications; accepted work/results belong to broker.
close_managed_windows() # Confirm a broker-owned graceful close or progressive clean sweep
{
    local _mc_scope=all _mc_id=${2:-} _mc_dir _mc_settings _mc_preview _mc_result _mc_pid _mc_read _mc_write _mc_rc _mc_original_read _mc_original_write _mc_helper_dir _mc_defaults _mc_key
    [[ $1 != -d ]] || _mc_scope=one
    _mc_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P) || return 1
    # The POC installer deploys Python modules in ~/.local/libexec. Source-tree
    # use remains colocated. No launch/geometry helper is needed for closure.
    _mc_helper_dir=$_mc_dir/libexec
    [[ -f $_mc_helper_dir/joetoo_kwin_managed_close.py ]] || _mc_helper_dir=$HOME/.local/libexec
    _mc_defaults=$(python3 "$_mc_helper_dir/joetoo_kwin_managed_close.py" --defaults) || return 2
    for _mc_key in managed_close_timeout_ms managed_close_total_timeout_ms managed_close_prepare_timeout_ms \
        managed_close_x11_grab_ms managed_close_poll_ms managed_close_dbus_timeout_ms; do
        printf -v "$_mc_key" '%s' "$(jq -er --arg key "$_mc_key" '.[$key]' <<< "$_mc_defaults")" || return 2
    done
    prepare_config_sources optional || return $?
    local _mc_source
    for _mc_source in "${config_sources[@]}"; do
        # Trusted executable Bash configuration, consistent with existing CLI.
        # shellcheck disable=SC1090
        source "$_mc_source" || return 2
    done
    apply_cli_verbosity || return $?
    _mc_settings=$(jq -cn --arg a "$managed_close_timeout_ms" --arg b "$managed_close_total_timeout_ms" \
        --arg c "$managed_close_prepare_timeout_ms" --arg d "$managed_close_x11_grab_ms" \
        --arg e "$managed_close_poll_ms" --arg f "$managed_close_dbus_timeout_ms" \
        '{managed_close_timeout_ms:$a,managed_close_total_timeout_ms:$b,managed_close_prepare_timeout_ms:$c,
          managed_close_x11_grab_ms:$d,managed_close_poll_ms:$e,managed_close_dbus_timeout_ms:$f}') || return 2
    _mc_settings=$(python3 "$_mc_helper_dir/joetoo_kwin_managed_close.py" --settings "$_mc_settings") || {
        j_msg "-${err}" -p 'Invalid managed close timing settings; no action authorized'; return 2; }
    # Named coproc supplies two one-line JSON replies and a private CONFIRM
    # input channel. The Python process retains the authenticated D-Bus owner;
    # separate qdbus6 processes could not preserve that caller continuity.
    coproc CLOSE_FRONTEND { python3 "$_mc_helper_dir/joetoo_kwin_managed_close.py" "$_mc_scope" "$_mc_id" "$_mc_settings" 9>&-; }
    _mc_pid=$CLOSE_FRONTEND_PID
    # Duplicate descriptors: Bash may unset the coproc array after child exit.
    # {name} allocates an FD and stores its number in the named Bash variable;
    # the original coprocess descriptors can then close without losing the pipe.
    exec {_mc_read}<&"${CLOSE_FRONTEND[0]}" {_mc_write}>&"${CLOSE_FRONTEND[1]}"
    _mc_original_read=${CLOSE_FRONTEND[0]}; _mc_original_write=${CLOSE_FRONTEND[1]}
    exec {_mc_original_read}<&- {_mc_original_write}>&-
    # Pipe closure detaches the frontend, never cancels accepted broker work.
    # shellcheck disable=SC2064
    trap 'exec {_mc_read}<&- {_mc_write}>&-; exit 130' INT
    trap 'exec {_mc_read}<&- {_mc_write}>&-; exit 143' TERM HUP
    if ! IFS= read -r _mc_preview <&"$_mc_read"; then
        j_msg "-${err}" -p 'Managed close preview unavailable; nothing authorized'
        exec {_mc_read}<&- {_mc_write}>&-
        wait "$_mc_pid" || :
        trap - INT TERM HUP
        return 1
    fi
    if ! jq -e '.protocol == 1 and .state == "prepared" and (.targets | type == "array")' <<< "$_mc_preview" >/dev/null; then
        j_msg "-${err}" -p 'Managed close rejected or native adapter unavailable; nothing authorized'
        exec {_mc_read}<&- {_mc_write}>&-
        wait "$_mc_pid" || :
        trap - INT TERM HUP
        return 1
    fi
    if [[ $_mc_scope == all ]]; then
        j_msg "-${notice}" -p 'Managed clean sweep (confirmed verified removals retire registrations and reserved slots):'
        jq -r '.targets[] | "  \(.managed_id) desktop=\(.desktop) slot=\(.slot) UUID=\(.window_uuid) action=\(.action // "close")"' <<< "$_mc_preview"
        jq -r '.excluded[] | "  excluded: \(.managed_id) (\(.reason))"' <<< "$_mc_preview"
    else
        j_msg "-${notice}" -p 'Graceful close target set (registrations and reserved slots will remain):'
        jq -r '.targets[] | "  \(.managed_id) desktop=\(.desktop) slot=\(.slot) UUID=\(.window_uuid)"' <<< "$_mc_preview"
        jq -r '.excluded[] | "  excluded: \(.managed_id) (missing, uncertain or unavailable native identity)"' <<< "$_mc_preview"
    fi
    j_msg "-${notice}" -p "Retained close result: $(jq -r '.request_id' <<< "$_mc_preview")"
    # Warn only after authenticated Konsole/session/native-UUID correlation.
    if [[ $_mc_scope == all ]] && jq -e '.self_terminal | test("^win-[0-9]+$")' <<< "$_mc_preview" >/dev/null; then
        j_msg "-${warn}" -p "This terminal ($(jq -r '.self_terminal' <<< "$_mc_preview")) is in the close set; broker execution continues after it closes. Consider an unmanaged Konsole to watch completion."
    fi
    if ! confirm_continue_or_exit; then
        exec {_mc_read}<&- {_mc_write}>&-
        wait "$_mc_pid" || :
        trap - INT TERM HUP
        return 1
    fi
    printf 'CONFIRM\n' >&"$_mc_write"
    if IFS= read -r _mc_result <&"$_mc_read"; then
        j_msg "-${notice}" -m "$_mc_result"
    else
        j_msg "-${err}" -p 'Close result unavailable; accepted work may continue in broker; query ManagedCloseStatus'
    fi
    exec {_mc_read}<&- {_mc_write}>&-
    trap - INT TERM HUP
    if wait "$_mc_pid"; then _mc_rc=0; else _mc_rc=$?; fi
    return "$_mc_rc"
}
# @usage close_managed_windows -d MANAGED_ID
# @cont close_managed_windows -x
# @ret Returns frontend status after exchange; early validation/IPC is nonzero.
# @deps prepare_config_sources, apply_cli_verbosity, jq, python3
